@model PrivateGym.Models.User
@using PrivateGym.Models
@{
    ViewData["Title"] = "ข้อมูลส่วนตัว";
    Layout = "~/Views/Shared/Customer/_CustomerLayout.cshtml";
    var branches = ViewBag.Branches as List<Branch> ?? new List<Branch>();
    string initialChar = !string.IsNullOrEmpty(Model.FullName)
        ? Model.FullName.TrimStart("คุณ".ToCharArray()).Trim().FirstOrDefault().ToString()
        : "P";
}

<style>
    .ep-quick-menu-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 12px;
        margin-bottom: 22px;
    }

    .ep-quick-btn-card {
        background: #141419;
        border: 1px solid #282834;
        border-radius: 13px;
        padding: 15px 18px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        text-decoration: none;
        transition: all 0.18s ease;
    }

    .ep-quick-btn-card:hover {
        border-color: #e50914;
        background: #181820;
    }

    .ep-quick-btn-card.support-highlight {
        background: linear-gradient(145deg, #191316 0%, #131318 100%);
        border-color: rgba(229, 9, 20, 0.35);
    }

    .ep-quick-left {
        display: flex;
        align-items: center;
        gap: 12px;
        min-width: 0;
    }

    .ep-quick-icon {
        width: 40px;
        height: 40px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

    .ep-quick-title {
        font-size: 14px;
        font-weight: 800;
        color: #ffffff;
        margin-bottom: 2px;
    }

    .ep-quick-sub {
        font-size: 11.5px;
        color: #a1a1aa;
    }

    @@media (max-width: 767.98px) {
        .ep-quick-menu-grid {
            grid-template-columns: 1fr;
            gap: 10px;
        }
    }
</style>

<main class="cd-content">
    <!-- Mobile Top Bar: โลโก้อยู่ทางซ้าย ชื่อหน้าอยู่ตรงกลาง -->
    <div class="pg-m-topbar d-flex d-lg-none">
        <a asp-controller="Customer" asp-action="Index" asp-route-email="@Model.Email" class="pg-m-topbar-logo-left">
            <img src="~/images/logo.png" alt="PrivateGym" />
        </a>
        <span class="pg-m-topbar-center">ข้อมูลส่วนตัว</span>
        <div class="pg-m-topbar-right"></div>
    </div>

    <div class="cd-page-header d-none d-lg-flex">
        <div>
            <h1 class="cd-page-title">ข้อมูลส่วนตัวและเป้าหมายการฝึก</h1>
            <p class="cd-page-subtext">
                อัปเดตข้อมูลบัญชีสมาชิก, ข้อมูลสรีระสำหรับโค้ชส่วนตัว, ข้อมูลออกใบกำกับภาษี และติดต่อศูนย์ช่วยเหลือสมาชิก
            </p>
        </div>
    </div>

    <!-- ปุ่มทางลัดไปหน้าติดต่อสอบถาม และหน้าประวัติการใช้บริการ (เก็บไว้ในหน้า Profile ตามที่ออกแบบ) -->
    <div class="ep-quick-menu-grid">
        <a asp-controller="Customer" asp-action="Support" asp-route-email="@Model.Email" class="ep-quick-btn-card support-highlight">
            <div class="ep-quick-left">
                <div class="ep-quick-icon" style="background: rgba(229, 9, 20, 0.16); border: 1px solid rgba(229, 9, 20, 0.38); color: #f87171;">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
                        <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
                    </svg>
                </div>
                <div>
                    <div class="ep-quick-title">ติดต่อสอบถาม / ศูนย์ช่วยเหลือสมาชิก</div>
                    <div class="ep-quick-sub">คำถามที่พบบ่อย, สายด่วนสาขา และส่งข้อความถึงผู้จัดการคลับ</div>
                </div>
            </div>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#ffffff" stroke-width="2.2">
                <polyline points="9 18 15 12 9 6"></polyline>
            </svg>
        </a>

        <a asp-controller="Customer" asp-action="ServiceHistory" asp-route-email="@Model.Email" class="ep-quick-btn-card">
            <div class="ep-quick-left">
                <div class="ep-quick-icon" style="background: rgba(34, 197, 94, 0.14); border: 1px solid rgba(34, 197, 94, 0.35); color: #4ade80;">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
                        <circle cx="12" cy="12" r="10"></circle>
                        <polyline points="12 6 12 12 16 14"></polyline>
                    </svg>
                </div>
                <div>
                    <div class="ep-quick-title">ประวัติการใช้บริการและสถิติการซ้อม</div>
                    <div class="ep-quick-sub">ดูบันทึกเวลาเช็กอินเข้า-ออกห้องซ้อมย้อนหลังทั้งหมด</div>
                </div>
            </div>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#a1a1aa" stroke-width="2.2">
                <polyline points="9 18 15 12 9 6"></polyline>
            </svg>
        </a>
    </div>

    @if (!string.IsNullOrEmpty(ViewBag.Success))
    {
        <div class="alert alert-success" style="background: rgba(34, 197, 94, 0.15); border: 1px solid #22c55e; color: #fff; border-radius: 8px; padding: 12px 16px; margin-bottom: 20px;">
            @ViewBag.Success
        </div>
    }
    @if (!string.IsNullOrEmpty(ViewBag.Error))
    {
        <div class="alert alert-danger" style="background: rgba(239, 68, 68, 0.15); border: 1px solid #ef4444; color: #fff; border-radius: 8px; padding: 12px 16px; margin-bottom: 20px;">
            @ViewBag.Error
        </div>
    }

    <form asp-controller="Customer" asp-action="EditProfile" method="post">
        <input type="hidden" name="UserId" value="@Model.UserId" />
        <input type="hidden" name="Email" value="@Model.Email" />

        <div class="row g-4">
            <!-- คอลัมน์ซ้าย: ข้อมูลบัญชีและสาขาหลัก -->
            <div class="col-lg-6">
                <div class="cd-card" style="padding: 24px; background: rgba(18,18,18,0.92); border: 1px solid rgba(255,255,255,0.08); border-radius: 12px; height: 100%;">
                    <div style="display: flex; align-items: center; gap: 14px; margin-bottom: 20px; padding-bottom: 16px; border-bottom: 1px solid rgba(255,255,255,0.08);">
                        <div style="width: 52px; height: 52px; border-radius: 50%; background: rgba(229,9,20,0.2); border: 1px solid #e50914; color: #fff; font-size: 20px; font-weight: 700; display: flex; align-items: center; justify-content: center;">
                            @initialChar
                        </div>
                        <div>
                            <h4 style="color: #fff; font-size: 17px; font-weight: 700; margin: 0;">@Model.FullName</h4>
                            <span style="font-size: 12.5px; color: var(--cd-text-muted);">รหัสสมาชิก #MEM-@Model.UserId.ToString("D5") &bull; @Model.Email</span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label" style="color: #fff; font-size: 13px;">ชื่อ - นามสกุล <span style="color: #e50914;">*</span></label>
                        <input type="text" name="FullName" value="@Model.FullName" class="form-control" style="background: #18181b; border: 1px solid #27272a; color: #fff;" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label" style="color: #fff; font-size: 13px;">เบอร์โทรศัพท์ <span style="color: #e50914;">*</span></label>
                        <input type="tel" name="Phone" value="@Model.Phone" class="form-control" style="background: #18181b; border: 1px solid #27272a; color: #fff;" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label" style="color: #fff; font-size: 13px;">อีเมล (ใช้สำหรับเข้าสู่ระบบ)</label>
                        <input type="email" value="@Model.Email" class="form-control" style="background: #121214; border: 1px solid #27272a; color: #71717a;" readonly />
                    </div>

                    <div class="mb-3">
                        <label class="form-label" style="color: #fff; font-size: 13px;">สาขาประจำ (Home Branch)</label>
                        <select name="HomeBranchId" class="form-select" style="background: #18181b; border: 1px solid #27272a; color: #fff;">
                            @foreach (var b in branches)
                            {
                                if (Model.HomeBranchId == b.BranchId)
                                {
                                    <option value="@b.BranchId" selected>@b.BranchName (@b.Location)</option>
                                }
                                else
                                {
                                    <option value="@b.BranchId">@b.BranchName (@b.Location)</option>
                                }
                            }
                        </select>
                    </div>

                    <div class="mb-0">
                        <label class="form-label" style="color: #fff; font-size: 13px;">ตั้งรหัสผ่านใหม่ (เว้นว่างไว้หากไม่ต้องการเปลี่ยน)</label>
                        <input type="password" name="newPassword" placeholder="กรอกรหัสผ่านใหม่..." class="form-control" style="background: #18181b; border: 1px solid #27272a; color: #fff;" />
                    </div>
                </div>
            </div>

            <!-- คอลัมน์ขวา: ข้อมูลสุขภาพสำหรับเทรนเนอร์ & ใบกำกับภาษี -->
            <div class="col-lg-6">
                <div class="cd-card" style="padding: 24px; background: rgba(18,18,18,0.92); border: 1px solid rgba(255,255,255,0.08); border-radius: 12px; height: 100%;">
                    <h4 style="color: #fff; font-size: 17px; font-weight: 700; margin-bottom: 16px;">ข้อมูลสรีระและเป้าหมายการฝึก (เชื่อมต่อหน้าโค้ชผู้ฝึกสอน)</h4>

                    <div class="row g-3 mb-3">
                        <div class="col-sm-4">
                            <label class="form-label" style="color: #fff; font-size: 13px;">เพศ</label>
                            <select name="Gender" class="form-select" style="background: #18181b; border: 1px solid #27272a; color: #fff;">
                                <option value="">- ระบุ -</option>
                                <option value="Male" selected="@(Model.Gender == "Male")">ชาย (Male)</option>
                                <option value="Female" selected="@(Model.Gender == "Female")">หญิง (Female)</option>
                                <option value="Other" selected="@(Model.Gender == "Other")">อื่นๆ</option>
                            </select>
                        </div>
                        <div class="col-sm-4">
                            <label class="form-label" style="color: #fff; font-size: 13px;">ส่วนสูง (ซม.)</label>
                            <input type="number" step="0.1" name="Height" value="@Model.Height" class="form-control" style="background: #18181b; border: 1px solid #27272a; color: #fff;" />
                        </div>
                        <div class="col-sm-4">
                            <label class="form-label" style="color: #fff; font-size: 13px;">น้ำหนัก (กก.)</label>
                            <input type="number" step="0.1" name="Weight" value="@Model.Weight" class="form-control" style="background: #18181b; border: 1px solid #27272a; color: #fff;" />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label" style="color: #fff; font-size: 13px;">ระดับประสบการณ์ออกกำลังกาย</label>
                        <select name="ExperienceLevel" class="form-select" style="background: #18181b; border: 1px solid #27272a; color: #fff;">
                            <option value="Beginner" selected="@(Model.ExperienceLevel == "Beginner")">ผู้เริ่มต้น (Beginner)</option>
                            <option value="Intermediate" selected="@(Model.ExperienceLevel == "Intermediate")">ปานกลาง (Intermediate)</option>
                            <option value="Advanced" selected="@(Model.ExperienceLevel == "Advanced")">ขั้นสูง / นักกีฬา (Advanced)</option>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label" style="color: #fff; font-size: 13px;">เป้าหมายหลักในการฝึก (Fitness Goal)</label>
                        <input type="text" name="FitnessGoal" value="@Model.FitnessGoal" placeholder="เช่น เพิ่มมวลกล้ามเนื้อ, ลดไขมัน, Powerlifting" class="form-control" style="background: #18181b; border: 1px solid #27272a; color: #fff;" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label" style="color: #fff; font-size: 13px;">เลขประจำตัวผู้เสียภาษี (Tax ID)</label>
                        <input type="text" name="TaxId" value="@Model.TaxId" class="form-control" style="background: #18181b; border: 1px solid #27272a; color: #fff;" />
                    </div>

                    <div class="mb-0">
                        <label class="form-label" style="color: #fff; font-size: 13px;">ที่อยู่สำหรับออกใบเสร็จ / ใบกำกับภาษี</label>
                        <textarea name="BillingAddress" rows="2" class="form-control" style="background: #18181b; border: 1px solid #27272a; color: #fff;">@Model.BillingAddress</textarea>
                    </div>
                </div>
            </div>
        </div>

        <div style="margin-top: 24px; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 12px;">
            <button type="submit" class="cd-btn-primary px-4 py-2" style="border: 0; border-radius: 8px; font-size: 14px; font-weight: 600;">
                บันทึกและอัปเดตข้อมูลโปรไฟล์
            </button>

            <a asp-controller="Login" asp-action="Index" class="cd-btn-secondary px-4 py-2" style="text-decoration: none; border-radius: 8px; font-size: 13.5px; color: #fca5a5; border-color: rgba(239, 68, 68, 0.35);">
                ออกจากระบบ
            </a>
        </div>
    </form>

    <!-- ปุ่มระงับการใช้งานบัญชี (Delete/Suspend Account) -->
    <div style="margin-top: 32px; padding-top: 20px; border-top: 1px solid rgba(255,255,255,0.08); display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 12px;">
        <div>
            <div style="font-size: 13.5px; font-weight: 600; color: #ef4444;">ระงับการใช้งานบัญชีสมาชิก (Deactivate Account)</div>
            <div style="font-size: 12px; color: var(--cd-text-dim);">หากระงับบัญชี คุณจะถูกออกจากระบบและต้องติดต่อเจ้าหน้าที่เพื่อเปิดใช้งานใหม่</div>
        </div>
        <form asp-controller="Customer" asp-action="DeleteAccount" method="post" onsubmit="return confirm('คุณแน่ใจหรือไม่ว่าต้องการระงับการใช้งานบัญชีสมาชิกนี้?');">
            <input type="hidden" name="userId" value="@Model.UserId" />
            <button type="submit" class="btn btn-outline-danger btn-sm px-3 py-2" style="border-radius: 6px; font-size: 12.5px;">
                ระงับบัญชีของฉัน
            </button>
        </form>
    </div>
</main>
