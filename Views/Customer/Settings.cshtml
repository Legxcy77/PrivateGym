@model PrivateGym.Models.User
@{
    ViewData["Title"] = "Settings";
    Layout = "~/Views/Shared/Customer/_CustomerLayout.cshtml";
    string username = !string.IsNullOrEmpty(Model.Email) ? Model.Email.Split('@')[0] : "member";
    string initialChar = !string.IsNullOrEmpty(Model.FullName) ? Model.FullName.TrimStart("คุณ".ToCharArray()).Trim().FirstOrDefault().ToString() : "P";
}

<div class="pg-app-container">
    <!-- Header: Back Arrow, Centered "Settings", Right Hamburger -->
    <header class="pg-app-header">
        <a asp-controller="Customer" asp-action="Profile" asp-route-email="@Model.Email" class="pg-back-btn" aria-label="Go Back">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
                <line x1="19" y1="12" x2="5" y2="12"></line>
                <polyline points="12 19 5 12 12 5"></polyline>
            </svg>
        </a>
        <h1 class="pg-app-header-center">Settings</h1>
        <button type="button" class="btn text-white p-2 border-0" id="settingsBurgerBtn" onclick="openSidebar()" aria-label="Open Menu">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
                <line x1="3" y1="12" x2="21" y2="12"></line>
                <line x1="3" y1="6" x2="21" y2="6"></line>
                <line x1="3" y1="18" x2="21" y2="18"></line>
            </svg>
        </button>
    </header>

    <!-- Mini Profile Card: Avatar + Name + @username + Chevron > -->
    <a asp-controller="Customer" asp-action="EditProfile" asp-route-email="@Model.Email" class="pg-user-mini-card">
        <img src="https://images.unsplash.com/photo-1534528741775-53994a69daeb?auto=format&fit=crop&w=160&q=80" 
             alt="@Model.FullName" 
             class="pg-mini-avatar" 
             onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';" />
        <div class="pg-mini-avatar d-flex align-items-center justify-content-center text-white fw-bold bg-dark" style="display: none !important;">
            @initialChar
        </div>

        <div class="pg-mini-info">
            <div class="pg-mini-name">@Model.FullName</div>
            <div class="pg-mini-handle">&#64;@username</div>
        </div>

        <svg class="pg-chevron-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <polyline points="9 18 15 12 9 6"></polyline>
        </svg>
    </a>

    <!-- Group 1: Notifications & General Settings -->
    <div class="pg-settings-group">
        <div class="pg-settings-row">
            <div class="pg-settings-left">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path>
                    <path d="M13.73 21a2 2 0 0 1-3.46 0"></path>
                </svg>
                <span>Pause notifications</span>
            </div>
            <label class="pg-switch">
                <input type="checkbox" checked id="pauseNotificationsToggle">
                <span class="pg-slider"></span>
            </label>
        </div>

        <a href="javascript:void(0)" class="pg-settings-row">
            <div class="pg-settings-left">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <line x1="4" y1="21" x2="4" y2="14"></line>
                    <line x1="4" y1="10" x2="4" y2="3"></line>
                    <line x1="12" y1="21" x2="12" y2="12"></line>
                    <line x1="12" y1="8" x2="12" y2="3"></line>
                    <line x1="20" y1="21" x2="20" y2="16"></line>
                    <line x1="20" y1="12" x2="20" y2="3"></line>
                    <line x1="1" y1="14" x2="7" y2="14"></line>
                    <line x1="9" y1="8" x2="15" y2="8"></line>
                    <line x1="17" y1="16" x2="23" y2="16"></line>
                </svg>
                <span>General settings</span>
            </div>
            <svg class="pg-chevron-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polyline points="9 18 15 12 9 6"></polyline>
            </svg>
        </a>
    </div>

    <!-- Group 2: Dark mode, Language, My Contact -->
    <div class="pg-settings-group">
        <div class="pg-settings-row">
            <div class="pg-settings-left">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <circle cx="12" cy="12" r="10" stroke-width="2"></circle>
                    <circle cx="12" cy="12" r="4" fill="currentColor"></circle>
                </svg>
                <span>Dark mode</span>
            </div>
            <label class="pg-switch">
                <input type="checkbox" checked id="darkModeToggle">
                <span class="pg-slider"></span>
            </label>
        </div>

        <a href="javascript:void(0)" class="pg-settings-row">
            <div class="pg-settings-left">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <circle cx="12" cy="12" r="10"></circle>
                    <line x1="2" y1="12" x2="22" y2="12"></line>
                    <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
                </svg>
                <span>Language</span>
            </div>
            <svg class="pg-chevron-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polyline points="9 18 15 12 9 6"></polyline>
            </svg>
        </a>

        <a href="javascript:void(0)" class="pg-settings-row">
            <div class="pg-settings-left">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                    <circle cx="9" cy="7" r="4"></circle>
                    <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
                    <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
                </svg>
                <span>My Contact</span>
            </div>
            <svg class="pg-chevron-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polyline points="9 18 15 12 9 6"></polyline>
            </svg>
        </a>
    </div>

    <!-- Group 3: FAQ, Terms of service, User policy -->
    <div class="pg-settings-group">
        <a href="javascript:void(0)" class="pg-settings-row">
            <div class="pg-settings-left">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <circle cx="12" cy="12" r="10"></circle>
                    <path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"></path>
                    <line x1="12" y1="17" x2="12.01" y2="17"></line>
                </svg>
                <span>FAQ</span>
            </div>
            <svg class="pg-chevron-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polyline points="9 18 15 12 9 6"></polyline>
            </svg>
        </a>

        <a href="javascript:void(0)" class="pg-settings-row">
            <div class="pg-settings-left">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <circle cx="12" cy="12" r="10"></circle>
                    <line x1="12" y1="16" x2="12" y2="12"></line>
                    <line x1="12" y1="8" x2="12.01" y2="8"></line>
                </svg>
                <span>Terms of service</span>
            </div>
            <svg class="pg-chevron-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polyline points="9 18 15 12 9 6"></polyline>
            </svg>
        </a>

        <a href="javascript:void(0)" class="pg-settings-row">
            <div class="pg-settings-left">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                </svg>
                <span>User policy</span>
            </div>
            <svg class="pg-chevron-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polyline points="9 18 15 12 9 6"></polyline>
            </svg>
        </a>
    </div>

    <!-- Prominent Bottom Pill Button: [-> Log Out] -->
    <a asp-controller="Login" asp-action="Index" class="pg-logout-btn">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
            <polyline points="16 17 21 12 16 7"></polyline>
            <line x1="21" y1="12" x2="9" y2="12"></line>
        </svg>
        <span>Log Out</span>
    </a>
</div>

<script>
    // Sync any demo profile changes saved in localStorage
    document.addEventListener('DOMContentLoaded', () => {
        const saved = localStorage.getItem('pg_user_profile_demo');
        if (saved) {
            try {
                const data = JSON.parse(saved);
                if (data.fullName) {
                    const miniName = document.querySelector('.pg-mini-name');
                    if (miniName) miniName.textContent = data.fullName;
                }
                if (data.username) {
                    const miniHandle = document.querySelector('.pg-mini-handle');
                    if (miniHandle) miniHandle.textContent = data.username;
                }
                if (data.avatarUrl) {
                    const miniAvatar = document.querySelector('.pg-mini-avatar');
                    if (miniAvatar) miniAvatar.src = data.avatarUrl;
                }
            } catch (err) {
                console.error('Error syncing localStorage in settings:', err);
            }
        }
    });
</script>
