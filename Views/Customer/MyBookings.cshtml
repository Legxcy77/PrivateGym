@model List<PrivateGym.Models.Booking>

@{
    ViewData["Title"] = "การจองของฉันและบัตรผ่านเข้าห้อง";
    Layout = "~/Views/Shared/Customer/_CustomerLayout.cshtml";

    var allBookings = Model ?? new List<PrivateGym.Models.Booking>();
    var todayDate = DateOnly.FromDateTime(DateTime.Today);
    var nowTime = TimeOnly.FromDateTime(DateTime.Now);
    string activeTab = (ViewBag.ActiveTab as string ?? "upcoming").ToLower();

    // ฟังก์ชันตรวจสอบว่ารอบจองเลยเวลาสิ้นสุด (EndTime) ไปหรือยัง และมีการเช็กอินเข้าห้องจริงหรือไม่
    bool IsSessionExpired(PrivateGym.Models.Booking b) =>
        b.BookingDate < todayDate || (b.BookingDate == todayDate && b.EndTime <= nowTime);

    bool HasCheckIn(PrivateGym.Models.Booking b) =>
        b.CheckIns != null && b.CheckIns.Any();

    // แยกกลุ่มรายการตามเวลาจริงและสถานะการเช็กอิน:
    // 1. การจองที่กำลังจะมาถึง / กำลังซ้อมอยู่ในห้อง (Confirmed และยังไม่เลยเวลา EndTime)
    var upcomingList = allBookings
        .Where(b => b.Status == "Confirmed" && !IsSessionExpired(b))
        .OrderBy(b => b.BookingDate)
        .ThenBy(b => b.StartTime)
        .ToList();

    // 2. ประวัติการใช้งาน (รวมทั้งที่เข้าฝึกซ้อมสำเร็จ Completed และที่เลยเวลา EndTime โดยไม่ได้เช็กอิน No-Show)
    var historyList = allBookings
        .Where(b => b.Status == "Completed" || (b.Status == "Confirmed" && IsSessionExpired(b)))
        .OrderByDescending(b => b.BookingDate)
        .ThenByDescending(b => b.StartTime)
        .ToList();

    // 3. ยกเลิกแล้ว (Cancelled)
    var cancelledList = allBookings
        .Where(b => b.Status == "Cancelled")
        .OrderByDescending(b => b.BookingDate)
        .ThenByDescending(b => b.StartTime)
        .ToList();

    // ถ้าลูกค้าเปิดเข้ามาหน้าเริ่มต้น (ไม่ได้ระบุแท็บอื่น) แล้วรอบของวันนี้หมดเวลาไปอยู่ในประวัติหมดแล้ว ให้เลือกแสดงตามแท็บ
    List<PrivateGym.Models.Booking> displayList;
    if (activeTab == "history" || activeTab == "completed")
    {
        activeTab = "history";
        displayList = historyList;
    }
    else if (activeTab == "cancelled")
    {
        displayList = cancelledList;
    }
    else if (activeTab == "all")
    {
        displayList = allBookings;
    }
    else
    {
        activeTab = "upcoming";
        displayList = upcomingList;
    }

    // รายการหลักที่ถูกเลือกแสดงใน Dynamic Access Pass ด้านขวา (แสดงเฉพาะรายการที่ยังไม่หมดเวลาเท่านั้น!)
    var primaryBooking = upcomingList.FirstOrDefault();

    string[] thaiShortMonths = { "ม.ค.", "ก.พ.", "มี.ค.", "เม.ย.", "พ.ค.", "มิ.ย.", "ก.ค.", "ส.ค.", "ก.ย.", "ต.ค.", "พ.ย.", "ธ.ค." };
    string[] engShortMonths = { "JAN", "FEB", "MAR", "APR", "MAY", "JUN", "JUL", "AUG", "SEP", "OCT", "NOV", "DEC" };
    string[] thaiDayNames = { "อาทิตย์", "จันทร์", "อังคาร", "พุธ", "พฤหัสบดี", "ศุกร์", "เสาร์" };
    string[] engDayNames = { "SUN", "MON", "TUE", "WED", "THU", "FRI", "SAT" };

    (string FullTitle, string SubDesc, string EquipShort, string PodCode) GetPodMeta(string? podName, int podId)
    {
        string raw = (podName ?? "").ToLower();
        if (raw.Contains("01") || raw.Contains("solo"))
            return ("Pod 01: Solo Precision Suite", "ห้องฝึกซ้อมส่วนตัวแบบมินิมอล Acoustic Seal พร้อมชุดเคเบิลคู่และดัมเบลครบชุด", "Dual Cable & DB", "PG01");
        if (raw.Contains("02") || raw.Contains("power") || raw.Contains("rig"))
            return ("The Integrated Power Rig", "ห้องฝึกซ้อมส่วนตัวแบบเก็บเสียง Acoustic Seal พร้อมแท่นยกน้ำหนักระดับการแข่งขัน", "Eleiko Rig", "PG02");
        if (raw.Contains("03") || raw.Contains("athletic") || raw.Contains("cardio"))
            return ("Athletic & Cardio Conditioning", "พื้นที่ฝึกความเร็วและระบบหัวใจ พร้อมลู่วิ่งหญ้าเทียม Sled และ Concept2", "Turf & SkiErg", "PG03");
        if (raw.Contains("04") || raw.Contains("recovery"))
            return ("Recovery & Contrast Therapy Suite", "โซนฟื้นฟูร่างกายส่วนตัว อ่างน้ำเย็นจัด Cold Plunge 3°C และ Infrared Sauna", "Plunge & Sauna", "PG04");
        if (raw.Contains("05") || raw.Contains("boxing"))
            return ("Boxing & Functional Power Pod", "ห้องฝึกสไตล์ Combat & HIIT พร้อมกระสอบทรายหนังแท้และ Kettlebells", "Heavy Bag & KB", "PG05");
        if (raw.Contains("06") || raw.Contains("pilates"))
            return ("Pilates & Mobility Flow Suite", "ห้องฝึกพิลาทิสและจัดระเบียบโครงสร้างร่างกาย พร้อมเตียง Allegro 2 Reformer", "Reformer Bed", "PG06");

        int num = ((podId - 1) % 6) + 1;
        return ($"Pod 0{num}: Private Training Suite", "ห้องฝึกซ้อมส่วนตัวแบบเก็บเสียง Acoustic Seal มาตรฐานโอลิมปิก", "Eleiko Pro", $"PG0{num}");
    }
}

