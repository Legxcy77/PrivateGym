    function confirmSelectPodFromModal() {
        var card = document.querySelector(`.pg-pod-card[data-pod-id="${currentViewingPodId}"]`);
        if (card) {
            selectPod(currentViewingPodId, card.getAttribute('data-pod-name'), card);
