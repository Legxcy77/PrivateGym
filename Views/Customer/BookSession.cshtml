        document.getElementById('podModalCode').innerText = data.code;
        document.getElementById('podModalTitle').innerText = data.title;
        document.getElementById('podModalSize').innerText = data.size;
        document.getElementById('podModalDesc').innerText = data.desc;
        document.getElementById('podModalImage').style.backgroundImage = `linear-gradient(rgba(0,0,0,0.1), rgba(0,0,0,0.7)), ${data.image}`;

        var eqList = document.getElementById('podModalEquipment');
