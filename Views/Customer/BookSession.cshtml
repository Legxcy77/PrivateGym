@model PrivateGym.ViewModels.BookSessionViewModel

@{
    ViewData["Title"] = "จองบริการรอบฝึกส่วนตัว (Book a Session)";
    Layout = "~/Views/Shared/Customer/_CustomerLayout.cshtml";

    var today = DateTime.Today;
    var thaiCulture = new System.Globalization.CultureInfo("th-TH");
    
    // หาวันจันทร์ของสัปดาห์ปัจจุบัน (Monday of this week)
    int diffFromMonday = (7 + (int)today.DayOfWeek - (int)DayOfWeek.Monday) % 7;
    var mondayThisWeek = today.AddDays(-diffFromMonday);

    // สร้างลิสต์ 7 วันของสัปดาห์ (จันทร์ - อาทิตย์)
    var weekDays = new List<dynamic>();
    for (int i = 0; i < 7; i++)
    {
        var dayDate = mondayThisWeek.AddDays(i);
        string shortDayName = dayDate.DayOfWeek switch
        {
            DayOfWeek.Monday => "จ.",
            DayOfWeek.Tuesday => "อ.",
            DayOfWeek.Wednesday => "พ.",
            DayOfWeek.Thursday => "พฤ.",
            DayOfWeek.Friday => "ศ.",
            DayOfWeek.Saturday => "ส.",
            DayOfWeek.Sunday => "อา.",
            _ => dayDate.ToString("ddd", thaiCulture)
        };
        weekDays.Add(new
        {
            DayName = shortDayName,
            DayNumber = dayDate.Day,
            Date = DateOnly.FromDateTime(dayDate),
            IsPast = dayDate < today,
            IsToday = dayDate == today,
            FormattedDate = dayDate.ToString("yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture),
            LabelText = (dayDate == today ? "วันนี้ " : "") + dayDate.Day + " " + dayDate.ToString("MMM", thaiCulture)
        });
    }

    int currentThaiYear = today.Year > 2400 ? today.Year : today.Year + 543;
    string thaiMonthYear = today.ToString("MMMM", thaiCulture) + " " + currentThaiYear;
}

