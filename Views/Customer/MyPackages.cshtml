<main class="cd-content">
    <div class="mp-page-wrap">
        <!-- =========================================================================
             1. MOBILE VIEW (< 992px): แบบที่ 1 (Hero Wallet Card + Bottom Sheet Top-up + Slim Receipts)
             ========================================================================= -->
        <div class="mp-mobile-view">
            <!-- Mobile Header Title (โลโก้อยู่ทางซ้าย ชื่อหน้าอยู่ตรงกลาง) -->
            <div class="pg-m-topbar">
                <a asp-controller="Customer" asp-action="Index" asp-route-email="@ViewBag.Email" class="pg-m-topbar-logo-left">
                    <img src="~/images/logo.png" alt="PrivateGym" />
                </a>
                <span class="pg-m-topbar-center">แพ็กเกจของฉัน</span>
                <div class="pg-m-topbar-right"></div>
            </div>

            <!-- Hero Membership Wallet Card (รวมแพ็กเกจ + โควต้า 3 ช่องในใบเดียว ไม่ต้องไถจอยาว) -->
            <div class="mp-wallet-card">
                <div class="mp-w-top">
                    <span class="mp-w-tier">แพ็กเกจสมาชิกปัจจุบัน</span>
                    <span class="mp-w-status">ใช้งานอยู่ &bull; เหลือ @daysLeft วัน</span>
                </div>

                <div class="mp-w-title">@pkgName</div>
                <div class="mp-w-price">
                    <strong>฿@pkgPrice.ToString("N0")</strong> / รอบ @pkgDuration วัน
                    @if (activeSub != null)
                    {
                        <span> (ใช้ได้ถึง @FormatThaiDate(activeSub.EndDate))</span>
                    }
                    <div style="font-size: 11.5px; color: #a1a1aa; margin-top: 4px;">
                        ช่องทางชำระหลัก: <strong style="color: #fff; font-size: 11.5px;">@FormatMethodThai(preferredMethod)</strong>
                    </div>
                </div>

                @if (TempData["Error"] != null)
                {
                    <div style="background: rgba(239, 68, 68, 0.14); border: 1px solid rgba(239, 68, 68, 0.45); color: #fecaca; border-radius: 10px; padding: 10px 12px; margin-bottom: 14px; font-size: 12px; line-height: 1.45;">
                        @TempData["Error"]
                    </div>
                }

                @if (scheduledSub != null)
                {
                    var boxBg = isNextCyclePaid ? "rgba(34, 197, 94, 0.12)" : "rgba(245, 158, 11, 0.12)";
                    var boxBorder = isNextCyclePaid ? "rgba(34, 197, 94, 0.45)" : "rgba(245, 158, 11, 0.4)";
                    var titleColor = isNextCyclePaid ? "#4ade80" : "#fbbf24";

                    <div style="background: @boxBg; border: 1px solid @boxBorder; border-radius: 10px; padding: 10px 12px; margin-bottom: 14px;">
                        <div style="font-size: 12px; font-weight: 700; color: @titleColor; margin-bottom: 3px;">
                            @(isNextCyclePaid ? "ชำระล่วงหน้าสำหรับรอบบิลถัดไปเรียบร้อยแล้ว" : "ตั้งเวลาเปลี่ยนแพ็กเกจรอบบิลถัดไปไว้แล้ว")
                        </div>
                        <div style="font-size: 11.5px; color: #e4e4e7; line-height: 1.45; margin-bottom: @(isNextCyclePaid ? "0" : "8px");">
                            คุณยังใช้สิทธิ์ <strong>@pkgName</strong> ได้จนถึงวันที่ <strong>@FormatThaiDate(currentEndDate)</strong> จากนั้นระบบจะเปลี่ยนเป็น <strong>@(scheduledSub.Package?.PackageName)</strong> ตั้งแต่วันที่ <strong>@FormatThaiDate(scheduledSub.StartDate)</strong>
                        </div>
                        @if (!isNextCyclePaid)
                        {
                            <div style="display: flex; gap: 6px; flex-wrap: wrap;">
                                <button type="button" onclick="openCheckoutModal('next_cycle_pay', '', 'ชำระล่วงหน้าแพ็กเกจ @(scheduledSub.Package?.PackageName) (รอบเริ่ม @FormatThaiDate(scheduledSub.StartDate))', @(scheduledSub.Package?.Price ?? 0), '')" style="background: #fbbf24; color: #09090b; border: none; border-radius: 6px; padding: 6px 11px; font-size: 11.5px; font-weight: 700; cursor: pointer;">
                                    ชำระล่วงหน้าตอนนี้ (฿@((scheduledSub.Package?.Price ?? 0).ToString("N0")))
                                </button>
                                <form asp-controller="Customer" asp-action="CancelScheduledPlan" method="post" class="js-anti-spam-form" style="margin: 0;">
                                    <input type="hidden" name="email" value="@ViewBag.Email" />
                                    <button type="submit" style="background: #1c1c24; color: #d4d4d8; border: 1px solid #323240; border-radius: 6px; padding: 6px 10px; font-size: 11px; font-weight: 600; cursor: pointer;">
                                        ยกเลิกคำขอเปลี่ยนแผน
                                    </button>
                                </form>
                            </div>
                        }
                    </div>
                }
                else if (TempData["Success"] != null)
                {
                    <div style="background: rgba(34, 197, 94, 0.12); border: 1px solid rgba(34, 197, 94, 0.45); color: #dcfce7; border-radius: 10px; padding: 10px 12px; margin-bottom: 14px; font-size: 12px; line-height: 1.45;">
                        @TempData["Success"]
                    </div>
                }

                <!-- 3-Column Quota Grid (ใช้คำไทยเข้าใจง่ายทันที) -->
                <div class="mp-w-quota-row">
                    <div class="mp-w-qbox">
                        <span class="qlbl">ห้องซ้อม Pod</span>
                        <span class="qval" style="color: #e50914;">@(isVip ? "ไม่จำกัด" : $"{remPods}/{maxPods}")</span>
                        <div class="qbar">
                            <div style="height: 100%; width: @podPct%; background: #e50914;"></div>
                        </div>
                    </div>
                    <div class="mp-w-qbox">
                        <span class="qlbl">โค้ชส่วนตัว</span>
                        <span class="qval">@(isVip ? "ไม่จำกัด" : $"{remPt}/{maxPt}")</span>
                        <div class="qbar">
                            <div style="height: 100%; width: @ptPct%; background: #e50914;"></div>
                        </div>
                    </div>
                    <div class="mp-w-qbox">
                        <span class="qlbl">วัดมวลร่างกาย</span>
                        <span class="qval" style="color: #4ade80;">@(isVip ? "ไม่จำกัด" : $"{remInBody}/{maxInBody}")</span>
                        <div class="qbar">
                            <div style="height: 100%; width: @inBodyPct%; background: #22c55e;"></div>
                        </div>
                    </div>
                </div>

                <!-- 2 ปุ่มหลักใต้บัตร: ซื้อสิทธิ์เพิ่มรายครั้ง (เปิด Bottom Sheet) & ต่ออายุ/เปลี่ยนแพ็กเกจ -->
                <div class="mp-w-btn-row">
                    <button type="button" class="mp-w-btn-topup" onclick="openMobileTopupSheet()">
                        <span>+ ซื้อสิทธิ์เพิ่มรายครั้ง</span>
                    </button>
                    <button type="button" class="mp-w-btn-renew" onclick="openChangePlanModal()">
                        <span>เปลี่ยนแผน / ชำระเงิน</span>
                    </button>
                </div>
            </div>

            <!-- ประวัติการชำระเงินล่าสุดแบบแถวบาง (แทนตาราง 6 คอลัมน์) -->
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 10px;">
                <span style="font-size: 14px; font-weight: 700; color: #ffffff;">ประวัติการชำระเงินและใบเสร็จ</span>
                <span style="font-size: 11.5px; color: #71717a;">@payments.Count รายการ</span>
            </div>

            @if (!payments.Any())
            {
                <div style="background: #121215; border: 1px dashed #2c2c35; border-radius: 12px; padding: 28px 16px; text-align: center; color: #71717a; font-size: 13px; margin-bottom: 16px;">
                    ยังไม่มีประวัติใบเสร็จรับเงินในระบบ
                </div>
            }
            else
            {
                @foreach (var p in payments.Take(6))
                {
                    string invRef = p.SlipReference ?? $"INV-{p.PaymentId:D5}";
                    string itemDesc = GetPaymentDescription(p);
                    string pDateStr = FormatThaiDateTime(p.PaymentDate);
                    bool isPendingPay = p.Status == "Pending";

                    <div class="mp-m-receipt-card" style="@(isPendingPay ? "border-color: rgba(245, 158, 11, 0.45); background: rgba(245, 158, 11, 0.06);" : "")">
                        <div class="mp-m-rc-left">
                            <div class="mp-m-rc-title">@itemDesc</div>
                            <div class="mp-m-rc-sub">
                                @pDateStr &bull; @FormatMethodThai(p.PaymentMethod) &bull;
                                @if (isPendingPay)
                                {
                                    <span style="color: #fbbf24; font-weight: 600;">รอชำระรอบบิลถัดไป</span>
                                }
                                else
                                {
                                    <span style="color: #4ade80; font-weight: 600;">ชำระสำเร็จ</span>
                                }
                            </div>
                        </div>
                        <div class="mp-m-rc-right">
                            <span class="mp-m-rc-amt">฿@p.Amount.ToString("N0")</span>
                            @if (isPendingPay)
                            {
                                <button type="button" class="mp-m-pdf-badge" style="background: #fbbf24; color: #09090b; border-color: #fbbf24;" onclick="openCheckoutModal('next_cycle_pay', '', '@itemDesc', @p.Amount, '')">
                                    ชำระเงิน
                                </button>
                            }
                            else
                            {
                                <button type="button" class="mp-m-pdf-badge" onclick="openReceiptModal('@invRef', '@pDateStr', '@itemDesc', '฿@p.Amount.ToString("N2")', '@FormatMethodThai(p.PaymentMethod)')">
                                    ใบเสร็จ PDF
                                </button>
                            }
                        </div>
                    </div>
                }
            }

            <!-- แถบขอใบกำกับภาษีนิติบุคคลแบบย่อบนมือถือ -->
            <div style="background: #121215; border: 1px solid #222229; border-radius: 12px; padding: 14px 16px; display: flex; justify-content: space-between; align-items: center; gap: 10px; margin-top: 14px;">
                <div style="font-size: 12px; color: #a1a1aa;">
                    <strong style="color: #fff; display: block;">ต้องการใบกำกับภาษีนิติบุคคล?</strong>
                    <span>ตั้งค่าเลขผู้เสียภาษีหรือติดต่อ Concierge</span>
                </div>
                <a asp-controller="Customer" asp-action="EditProfile" asp-route-email="@ViewBag.Email" style="background: #1b1b22; border: 1px solid #2e2e3a; color: #fff; font-size: 11.5px; font-weight: 600; padding: 7px 12px; border-radius: 7px; text-decoration: none; white-space: nowrap;">
                    ตั้งค่าภาษี &rarr;
                </a>
            </div>
        </div>

        <!-- =========================================================================
             2. DESKTOP VIEW (>= 992px): ภาษาไทยเข้าใจง่าย ไม่ใช้ตัวย่อซับซ้อน
             ========================================================================= -->
        <div class="mp-desktop-view">
            <!-- Top Title & Action Buttons -->
            <div class="mp-top-header">
                <div class="mp-title-group">
                    <h1 class="mp-main-title">แพ็กเกจและสิทธิ์การใช้งาน</h1>
                </div>

                <div class="mp-header-btns">
                    <a asp-controller="Customer" asp-action="MyPackages" asp-route-email="@ViewBag.Email" class="mp-btn-outline">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
                            <polyline points="23 4 23 10 17 10"></polyline>
                            <path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10"></path>
                        </svg>
                        <span>รีเฟรชข้อมูลสิทธิ์</span>
                    </a>
                </div>
            </div>

            <!-- Section 1: แพ็กเกจหลักปัจจุบัน -->
            <div class="mp-sec-head">
                <div class="mp-sec-title">
                    <span style="color: #e50914;">●</span>
                    <span>แพ็กเกจหลักปัจจุบันของคุณ</span>
                </div>
                <span class="mp-status-badge-active">
                    <span style="color: #22c55e;">●</span>
                    <span>สถานะ: กำลังใช้งาน</span>
                </span>
            </div>

            <div class="mp-plan-container">
                <div class="row g-4 align-items-center">
                    <!-- Left Column: Plan Details & Price Box -->
                    <div class="col-lg-5 mp-plan-left">
                        <div class="mp-tier-row">
                            <span class="mp-tier-code">ระดับแพ็กเกจสมาชิก</span>
                            <span class="mp-cycle-badge">รอบบิลรายเดือน (@pkgDuration วัน)</span>
                        </div>

                        <h2 class="mp-plan-name">@pkgName</h2>
                        <p class="mp-plan-desc">@pkgDesc</p>

                        <div class="mp-price-box">
                            <div>
                                <span class="mp-price-val">฿@pkgPrice.ToString("N0")</span>
                                <span class="mp-price-unit">/ เดือน (รวมภาษีมูลค่าเพิ่ม)</span>
                            </div>
                            <div class="mp-autorenew-line">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <rect x="1" y="4" width="22" height="16" rx="2" ry="2"></rect>
                                    <line x1="1" y1="10" x2="23" y2="10"></line>
                                </svg>
                                <span>ใช้สิทธิ์แพ็กเกจนี้ได้ถึง: @(activeSub != null ? FormatThaiDate(activeSub.EndDate) : "-") &bull; ช่องทางหลัก: <strong style="color: #fff;">@FormatMethodThai(preferredMethod)</strong></span>
                            </div>
                        </div>

                        @if (TempData["Error"] != null)
                        {
                            <div style="background: rgba(239, 68, 68, 0.14); border: 1px solid rgba(239, 68, 68, 0.45); color: #fecaca; border-radius: 10px; padding: 12px 14px; margin-bottom: 16px; font-size: 12.5px; line-height: 1.5;">
                                @TempData["Error"]
                            </div>
                        }

                        @if (scheduledSub != null)
                        {
                            var dBoxBg = isNextCyclePaid ? "rgba(34, 197, 94, 0.12)" : "rgba(245, 158, 11, 0.12)";
                            var dBoxBorder = isNextCyclePaid ? "rgba(34, 197, 94, 0.45)" : "rgba(245, 158, 11, 0.45)";
                            var dTitleColor = isNextCyclePaid ? "#4ade80" : "#fbbf24";

                            <div style="background: @dBoxBg; border: 1px solid @dBoxBorder; border-radius: 10px; padding: 12px 14px; margin-bottom: 16px;">
                                <div style="font-size: 13px; font-weight: 800; color: @dTitleColor; margin-bottom: 4px;">
                                    @(isNextCyclePaid ? "ชำระล่วงหน้าสำหรับแพ็กเกจรอบบิลถัดไปเรียบร้อยแล้ว" : "ตั้งเวลาเปลี่ยนแพ็กเกจสำหรับรอบบิลถัดไปไว้แล้ว")
                                </div>
                                <div style="font-size: 12px; color: #e4e4e7; line-height: 1.5; margin-bottom: @(isNextCyclePaid ? "0" : "10px");">
                                    คุณยังถือสิทธิ์ <strong>@pkgName</strong> ไปจนสิ้นสุดรอบปัจจุบันวันที่ <strong>@FormatThaiDate(currentEndDate)</strong> จากนั้นระบบจะเปลี่ยนเป็นแพ็กเกจ <strong>@(scheduledSub.Package?.PackageName)</strong> (฿@((scheduledSub.Package?.Price ?? 0).ToString("N0"))) ตั้งแต่วันที่ <strong>@FormatThaiDate(scheduledSub.StartDate)</strong>
                                </div>
                                @if (!isNextCyclePaid)
                                {
                                    <div style="display: flex; gap: 8px; flex-wrap: wrap;">
                                        <button type="button" onclick="openCheckoutModal('next_cycle_pay', '', 'ชำระล่วงหน้าแพ็กเกจ @(scheduledSub.Package?.PackageName) (รอบเริ่ม @FormatThaiDate(scheduledSub.StartDate))', @(scheduledSub.Package?.Price ?? 0), '')" style="background: #fbbf24; color: #09090b; border: none; border-radius: 7px; padding: 7px 12px; font-size: 12px; font-weight: 700; cursor: pointer;">
                                            ชำระล่วงหน้ารอบถัดไปตอนนี้ (฿@((scheduledSub.Package?.Price ?? 0).ToString("N0")))
                                        </button>
                                        <form asp-controller="Customer" asp-action="CancelScheduledPlan" method="post" class="js-anti-spam-form" style="margin: 0;">
                                            <input type="hidden" name="email" value="@ViewBag.Email" />
                                            <button type="submit" style="background: #1a1a22; color: #d4d4d8; border: 1px solid #30303e; border-radius: 7px; padding: 7px 12px; font-size: 12px; font-weight: 600; cursor: pointer;">
                                                ยกเลิกคำขอเปลี่ยนแผนล่วงหน้า
                                            </button>
                                        </form>
                                    </div>
                                }
                            </div>
                        }
                        else if (TempData["Success"] != null)
                        {
                            <div style="background: rgba(34, 197, 94, 0.12); border: 1px solid rgba(34, 197, 94, 0.45); color: #dcfce7; border-radius: 10px; padding: 12px 14px; margin-bottom: 16px; font-size: 12.5px; line-height: 1.5;">
                                @TempData["Success"]
                            </div>
                        }

                        <div class="mp-plan-actions">
                            <button type="button" class="mp-btn-dark" onclick="openChangePlanModal()">เปลี่ยนแพ็กเกจ / ช่องทางชำระเงิน</button>
                            <button type="button" class="mp-btn-dark" onclick="openCheckoutModal('topup', 'renew', 'ต่ออายุแพ็กเกจปัจจุบัน (@pkgName) ล่วงหน้า +30 วัน', @pkgPrice, 'next_cycle')">
                                ต่ออายุแพ็กเกจเดิมล่วงหน้า (+30 วัน)
                            </button>
                        </div>
                    </div>

                    <!-- Right Column: 2x2 Quota Grid -->
                    <div class="col-lg-7">
                        <div class="mp-quota-panel">
                            <div class="mp-quota-head">
                                <span>โควต้าสิทธิ์การใช้งานคงเหลือในรอบปัจจุบัน</span>
                                <span style="color: #e50914; font-weight: 700;">เหลือเวลาใช้งาน @daysLeft วัน</span>
                            </div>

                            <div class="mp-quota-grid">
                                <!-- Box 1: ห้องซ้อมส่วนตัว (Private Pod) -->
                                <div class="mp-q-card">
                                    <div class="mp-q-top">
                                        <div class="mp-q-title">
                                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#a1a1aa" stroke-width="2">
                                                <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
                                                <line x1="9" y1="3" x2="9" y2="21"></line>
                                            </svg>
                                            <span>ห้องซ้อมส่วนตัว Pod (75 นาที)</span>
                                        </div>
                                        <span class="mp-q-used">@(isVip ? "ไม่จำกัด" : $"ใช้ไป {usedPods}/{maxPods}")</span>
                                    </div>
                                    <div class="mp-q-mid">
                                        <div>
                                            <span class="mp-q-big-num red">@(isVip ? "ไม่จำกัด" : remPods.ToString())</span>
                                            @if (!isVip)
                                            {
                                                <span class="mp-q-unit">ครั้งที่เหลือ</span>
                                            }
                                        </div>
                                        <span class="mp-q-max">โควต้าเต็ม: @(isVip ? "ไม่จำกัด" : $"{maxPods} ครั้ง")</span>
                                    </div>
                                    <div class="mp-q-bar">
                                        <div class="mp-q-fill" style="width: @podPct%; background: #e50914;"></div>
                                    </div>
                                </div>

                                <!-- Box 2: โค้ชฝึกสอนส่วนตัว (Personal Trainer) -->
                                <div class="mp-q-card">
                                    <div class="mp-q-top">
                                        <div class="mp-q-title">
                                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#a1a1aa" stroke-width="2">
                                                <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                                                <circle cx="9" cy="7" r="4"></circle>
                                            </svg>
                                            <span>โค้ชฝึกสอนส่วนตัว 1:1 (60 นาที)</span>
                                        </div>
                                        <span class="mp-q-used">@(isVip ? "ไม่จำกัด" : $"ใช้ไป {usedPt}/{maxPt}")</span>
                                    </div>
                                    <div class="mp-q-mid">
                                        <div>
                                            <span class="mp-q-big-num">@(isVip ? "ไม่จำกัด" : remPt.ToString())</span>
                                            @if (!isVip)
                                            {
                                                <span class="mp-q-unit">ครั้งที่เหลือ</span>
                                            }
                                        </div>
                                        <span class="mp-q-max">โควต้าเต็ม: @(isVip ? "ไม่จำกัด" : $"{maxPt} ครั้ง")</span>
                                    </div>
                                    <div class="mp-q-bar">
                                        <div class="mp-q-fill" style="width: @ptPct%; background: #e50914;"></div>
                                    </div>
                                </div>

                                <!-- Box 3: ตรวจวัดมวลร่างกาย (InBody) -->
                                <div class="mp-q-card">
                                    <div class="mp-q-top">
                                        <div class="mp-q-title">
                                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#a1a1aa" stroke-width="2">
                                                <polyline points="22 12 18 12 15 21 9 3 6 12 2 12"></polyline>
                                            </svg>
                                            <span>ตรวจวัดมวลกล้ามเนื้อและไขมัน</span>
                                        </div>
                                        <span style="font-size: 11.5px; color: #22c55e; font-weight: 600;">พร้อมใช้งาน</span>
                                    </div>
                                    <div class="mp-q-mid">
                                        <div>
