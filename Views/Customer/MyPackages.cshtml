@model List<PrivateGym.Models.MemberSubscription>

@{
    ViewData["Title"] = "แพ็กเกจและสิทธิ์การใช้งาน (My Package & Quotas)";
    Layout = "~/Views/Shared/Customer/_CustomerLayout.cshtml";

    var todayDate = DateOnly.FromDateTime(DateTime.Today);
    var activeSub = Model?.FirstOrDefault(s => s.Status == "Active" && s.StartDate <= todayDate) ?? Model?.FirstOrDefault();
    var scheduledSub = ViewBag.ScheduledSub as PrivateGym.Models.MemberSubscription ?? Model?.FirstOrDefault(s => s.Status == "Active" && s.StartDate > todayDate);
    var payments = ViewBag.Payments as List<PrivateGym.Models.Payment> ?? new List<PrivateGym.Models.Payment>();
    var allPackages = ViewBag.AllPackages as List<PrivateGym.Models.Package> ?? new List<PrivateGym.Models.Package>();
    string preferredMethod = ViewBag.PreferredPaymentMethod as string ?? "PromptPay";
    bool isNextCyclePaid = ViewBag.IsNextCyclePaid != null ? (bool)ViewBag.IsNextCyclePaid : false;

    string FormatMethodThai(string? m)
    {
        if (m == "CreditCard") return "ตัดบัตรเครดิต/เดบิตอัตโนมัติ";
        if (m == "BankTransfer") return "โอนผ่านบัญชีธนาคาร";
        return "สแกน QR PromptPay";
    }

    bool isVip = activeSub?.Package?.IsVip ?? false;
    string pkgName = activeSub?.Package?.PackageName ?? "Performance Pro";
    string pkgDesc = activeSub?.Package?.Description ?? "เข้าใช้ห้องซ้อมส่วนตัวขั้นสูง พร้อมชั่วโมงโค้ชฝึกสอนตัวต่อตัว และตรวจวัดมวลกล้ามเนื้อและไขมันไม่จำกัดสาขา";
    decimal pkgPrice = activeSub?.Package?.Price ?? 8900m;
    int pkgDuration = activeSub?.Package?.DurationDays ?? 30;
    DateOnly currentEndDate = activeSub?.EndDate ?? DateOnly.FromDateTime(DateTime.Today.AddDays(30));
    DateOnly nextCycleStartDate = currentEndDate.AddDays(1);

    int remPods = activeSub?.RemainingPods ?? 0;
    int maxPods = activeSub?.Package?.PodQuota ?? 8;
    if (remPods > maxPods && maxPods > 0) maxPods = remPods;
    int usedPods = Math.Max(0, maxPods - remPods);
    int podPct = isVip ? 100 : (maxPods > 0 ? Math.Min(100, (remPods * 100) / maxPods) : 0);

    int remPt = activeSub?.RemainingPt ?? 0;
    int maxPt = activeSub?.Package?.PtQuota ?? 4;
    if (remPt > maxPt && maxPt > 0) maxPt = remPt;
    int usedPt = Math.Max(0, maxPt - remPt);
    int ptPct = isVip ? 100 : (maxPt > 0 ? Math.Min(100, (remPt * 100) / maxPt) : 0);

    int remInBody = activeSub?.RemainingInBody ?? 0;
    int maxInBody = activeSub?.Package?.InBodyQuota ?? 1;
    if (remInBody > maxInBody && maxInBody > 0) maxInBody = remInBody;
    int inBodyPct = isVip ? 100 : (maxInBody > 0 ? Math.Min(100, (remInBody * 100) / maxInBody) : 0);

    int daysLeft = 24;
    if (activeSub != null)
    {
        daysLeft = activeSub.EndDate.DayNumber - DateOnly.FromDateTime(DateTime.Today).DayNumber;
        if (daysLeft < 0) daysLeft = 0;
    }

    string[] thaiShortMonths = { "ม.ค.", "ก.พ.", "มี.ค.", "เม.ย.", "พ.ค.", "มิ.ย.", "ก.ค.", "ส.ค.", "ก.ย.", "ต.ค.", "พ.ย.", "ธ.ค." };
    string FormatThaiDate(DateOnly d) => $"{d.Day} {thaiShortMonths[d.Month - 1]} {d.Year}";
    string FormatThaiDateTime(DateTime? dt)
    {
        if (!dt.HasValue) return "-";
        var d = dt.Value;
        return $"{d.Day} {thaiShortMonths[d.Month - 1]} {d.Year}";
    }

    string GetPaymentDescription(PrivateGym.Models.Payment p)
    {
        if (p.Status == "Pending")
        {
            return $"ใบแจ้งหนี้รอบบิลถัดไป: {p.Package?.PackageName ?? "แพ็กเกจใหม่"} (เริ่ม {FormatThaiDate(nextCycleStartDate)})";
        }
        if (p.SlipReference != null && p.SlipReference.StartsWith("INV-NEXT"))
        {
            return $"ชำระล่วงหน้าแพ็กเกจรอบถัดไป: {p.Package?.PackageName ?? pkgName}";
        }
        if (p.SlipReference != null && p.SlipReference.Contains("-UPG"))
        {
            return $"อัปเกรดแพ็กเกจทันที: {p.Package?.PackageName ?? pkgName} (ทบโควต้าเดิม)";
        }
        if (p.Amount == 750) return "ซื้อสิทธิ์เพิ่ม ห้องซ้อมส่วนตัว (+1 ครั้ง)";
        if (p.Amount == 1200) return "ซื้อสิทธิ์เพิ่ม โค้ชส่วนตัว (+1 ครั้ง)";
        if (p.Amount == 300) return "ซื้อสิทธิ์เพิ่ม วัดมวลร่างกาย (+1 ครั้ง)";
        if (p.Amount == 350) return "ซื้อบัตรผู้ติดตามเข้าคลับ (+1 วัน)";
        return $"แพ็กเกจสมาชิก {p.Package?.PackageName ?? pkgName} (รายเดือน)";
    }
}

