                                <span class="mp-addon-price-lbl">ราคาต่อครั้ง</span>
                                <span class="mp-addon-price-val">฿1,200</span>
                            </div>
                            <button type="button" class="mp-btn-dark" onclick="openCheckoutModal('topup', 'pt_1', 'ซื้อสิทธิ์เพิ่ม โค้ชฝึกสอนส่วนตัว 1:1 (+1 ครั้ง • 60 นาที)', 1200, 'next_cycle')">
