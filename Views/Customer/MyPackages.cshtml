                <span style="font-size: 12px; color: #71717a;">เลขประจำตัวผู้เสียภาษี: 0105562098421 (บริษัท ไพรเวทยิม จำกัด)</span>
            </div>

            <div class="mp-billing-box">
                @if (!payments.Any())
                {
                    <div style="padding: 36px; text-align: center; color: #71717a; font-size: 13.5px;">
                        ยังไม่มีประวัติใบเสร็จรับเงินในระบบ
                    </div>
                }
                else
                {
                    <table class="mp-table">
                        <thead>
                            <tr>
                                <th>วันที่ทำรายการ</th>
                                <th>รายการชำระ</th>
                                <th>ช่องทางชำระเงิน</th>
                                <th>เลขอ้างอิงเอกสาร</th>
                                <th>ยอดรวมสุทธิ</th>
                                <th>สถานะ</th>
                                <th style="text-align: right;">การดำเนินการ / ใบเสร็จ</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var p in payments)
                            {
                                string invRef = p.SlipReference ?? $"INV-{p.PaymentId:D5}";
                                string itemDesc = GetPaymentDescription(p);
                                string pDateStr = FormatThaiDateTime(p.PaymentDate);
                                string pTimeStr = p.PaymentDate?.ToString("HH:mm") ?? "";
                                bool isPendingPay = p.Status == "Pending";

                                <tr style="@(isPendingPay ? "background: rgba(245, 158, 11, 0.05);" : "")">
                                    <td>
                                        <strong style="color: #ffffff;">@pDateStr</strong>
                                        <span style="color: #71717a; font-size: 12px; margin-left: 6px;">@pTimeStr</span>
                                    </td>
                                    <td>
                                        <span style="color: @(isPendingPay ? "#fbbf24" : (p.Amount >= 3000 ? "#e50914" : "#a1a1aa")); margin-right: 6px;">●</span>
                                        <span style="color: #ffffff; font-weight: 600;">@itemDesc</span>
                                    </td>
                                    <td style="font-size: 12.5px; color: #d4d4d8;">@FormatMethodThai(p.PaymentMethod)</td>
                                    <td style="font-family: monospace; color: #a1a1aa;">@invRef</td>
                                    <td style="font-weight: 800; color: #ffffff;">฿@p.Amount.ToString("N0")</td>
                                    <td>
                                        @if (isPendingPay)
                                        {
                                            <span style="color: #fbbf24; font-size: 12.5px; font-weight: 600;">● รอชำระรอบบิลถัดไป</span>
                                        }
                                        else
                                        {
                                            <span style="color: #22c55e; font-size: 12.5px; font-weight: 600;">● ชำระสำเร็จ</span>
                                        }
                                    </td>
                                    <td style="text-align: right;">
                                        @if (isPendingPay)
                                        {
                                            <div style="display: inline-flex; gap: 6px;">
                                                <button type="button" class="mp-pdf-btn" style="background: #fbbf24; color: #09090b; border-color: #fbbf24; font-weight: 700;" onclick="openCheckoutModal('next_cycle_pay', '', '@itemDesc', @p.Amount, '')">
                                                    <span>ชำระล่วงหน้าตอนนี้</span>
                                                </button>
                                                <form asp-controller="Customer" asp-action="CancelScheduledPlan" method="post" class="js-anti-spam-form" style="margin: 0;">
                                                    <input type="hidden" name="email" value="@ViewBag.Email" />
                                                    <button type="submit" class="mp-pdf-btn" style="color: #a1a1aa;">
                                                        <span>ยกเลิก</span>
                                                    </button>
                                                </form>
                                            </div>
                                        }
                                        else
                                        {
                                            <button type="button" class="mp-pdf-btn" onclick="openReceiptModal('@invRef', '@pDateStr @pTimeStr', '@itemDesc', '฿@p.Amount.ToString("N2")', '@FormatMethodThai(p.PaymentMethod)')">
                                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                                    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                                                    <polyline points="14 2 14 8 20 8"></polyline>
                                                </svg>
                                                <span>ดาวน์โหลดใบเสร็จ PDF</span>
                                            </button>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                    <div style="display: flex; justify-content: space-between; align-items: center; padding: 12px 20px; background: #0e0e11; border-top: 1px solid #1c1c22; font-size: 12px; color: #71717a;">
                        <span>แสดง @payments.Count รายการจากประวัติธุรกรรมและการตั้งเวลาเปลี่ยนแพ็กเกจทั้งหมด</span>
                        <span>ออกใบเสร็จอิเล็กทรอนิกส์อัตโนมัติเฉพาะรายการที่ชำระสำเร็จแล้วเท่านั้น</span>
                    </div>
                }
            </div>

            <!-- Corporate Tax Invoice Footer Banner (ตามรูป Darfwebsite) -->
            <div class="mp-tax-banner">
                <div style="display: flex; align-items: center; gap: 14px;">
                    <div style="width: 38px; height: 38px; border-radius: 8px; background: #1a1a20; border: 1px solid #2a2a34; display: flex; align-items: center; justify-content: center; color: #a1a1aa;">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                        </svg>
                    </div>
                    <div>
                        <div style="font-size: 13.5px; font-weight: 700; color: #ffffff;">ต้องการขอใบกำกับภาษีเต็มรูปแบบในนามนิติบุคคล?</div>
                        <div style="font-size: 12px; color: #71717a;">สามารถเพิ่มเลขประจำตัวผู้เสียภาษีและที่อยู่จดทะเบียนได้ที่เมนูตั้งค่าบัญชี หรือติดต่อ Concierge</div>
                    </div>
                </div>
                <a asp-controller="Customer" asp-action="Support" asp-route-email="@ViewBag.Email" class="mp-btn-dark" style="text-decoration: none; display: inline-flex; align-items: center; gap: 6px;">
                    <span>ติดต่อ Concierge Desk</span>
                    <span>&rarr;</span>
                </a>
            </div>
        </div>
    </div>
</main>

