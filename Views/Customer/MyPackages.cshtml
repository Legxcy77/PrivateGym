            <div>
                <div style="font-size: 14px; font-weight: 700; color: #ffffff;">บัตรผู้ติดตามเข้าคลับ (+1 วัน)</div>
                <div style="font-size: 11.5px; color: #a1a1aa;">สิทธิ์พาเพื่อนเข้าใช้เลานจ์ส่วนกลาง</div>
            </div>
            <div style="display: flex; align-items: center; gap: 10px;">
                <strong style="font-size: 15px; color: #ffffff;">฿350</strong>
                <button type="button" class="mp-btn-red" style="padding: 7px 12px; font-size: 12px;" onclick="closeMobileTopupSheet(); openCheckoutModal('topup', 'guest_1', 'ซื้อบัตรผู้ติดตามเข้าคลับรายวัน (+1 วัน)', 350, 'next_cycle')">
                    ซื้อเพิ่ม
                </button>
            </div>
        </div>
    </div>
</div>

<!-- ================= MODAL เปลี่ยนแพ็กเกจ / ต่ออายุ / ช่องทางชำระเงิน (ใช้ร่วมกันทั้ง Desktop และ Mobile) ================= -->
<div class="mp-sheet-backdrop" id="changePlanModalBackdrop" onclick="if(event.target === this) closeChangePlanModal()" style="align-items: center; padding: 14px;">
    <div style="background: #141418; border: 1px solid #2b2b36; border-radius: 16px; width: 100%; max-width: 500px; max-height: 90vh; overflow-y: auto; padding: 22px;">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 6px;">
            <h4 style="font-size: 17px; font-weight: 800; color: #ffffff; margin: 0;">เปลี่ยนแพ็กเกจและตั้งค่าการชำระเงิน</h4>
            <button type="button" onclick="closeChangePlanModal()" style="background: none; border: none; color: #a1a1aa; font-size: 22px; line-height: 1; cursor: pointer;">&times;</button>
        </div>

        <!-- กล่องอธิบายกติการอบบิล (ชัดเจนว่าถือแพ็กเกจเดิมจนสิ้นเดือน) -->
        <div style="background: #1a1a22; border: 1px solid #2d2d3a; border-radius: 10px; padding: 11px 13px; margin-bottom: 14px; font-size: 12px; color: #d4d4d8; line-height: 1.5;">
            <strong style="color: #fff; display: block; margin-bottom: 2px;">เงื่อนไขการเปลี่ยนแพ็กเกจ:</strong>
            แพ็กเกจปัจจุบันของคุณ (<strong>@pkgName</strong>) จะใช้งานได้จนถึงวันที่ <strong>@FormatThaiDate(currentEndDate)</strong> โดยแพ็กเกจใหม่จะเริ่มมีผลในรอบบิลถัดไปตั้งแต่วันที่ <strong>@FormatThaiDate(nextCycleStartDate)</strong> เป็นต้นไป
        </div>

        <!-- ส่วนที่ 1: เลือกหรือเปลี่ยนช่องทางการชำระเงินหลัก (ดึงค่าเดิมจากตอน Register) -->
        <form asp-controller="Customer" asp-action="UpdatePaymentMethod" method="post" class="js-anti-spam-form" style="background: #101014; border: 1px solid #24242f; border-radius: 11px; padding: 12px 14px; margin-bottom: 16px;">
            <input type="hidden" name="email" value="@ViewBag.Email" />
            <div style="font-size: 12px; font-weight: 700; color: #ffffff; margin-bottom: 8px;">
                ช่องทางการชำระเงินหลักสำหรับรอบบิลถัดไป
            </div>
            <div style="display: grid; grid-template-columns: 1fr; gap: 6px; margin-bottom: 10px;">
                <label style="display: flex; align-items: center; gap: 8px; font-size: 12px; color: #e4e4e7; cursor: pointer;">
                    <input type="radio" name="paymentMethod" value="CreditCard" @(preferredMethod == "CreditCard" ? "checked" : "") onchange="syncPaymentMethodInputs(this.value)" />
                    <span>ผูกบัตรเครดิต / เดบิต (ตัดชำระอัตโนมัติเมื่อถึงวันครบรอบเดือน)</span>
                </label>
                <label style="display: flex; align-items: center; gap: 8px; font-size: 12px; color: #e4e4e7; cursor: pointer;">
                    <input type="radio" name="paymentMethod" value="PromptPay" @(preferredMethod == "PromptPay" ? "checked" : "") onchange="syncPaymentMethodInputs(this.value)" />
                    <span>สแกนจ่าย QR PromptPay (แจ้งเตือนให้สแกนเมื่อถึงรอบบิล หรือจ่ายล่วงหน้า)</span>
                </label>
                <label style="display: flex; align-items: center; gap: 8px; font-size: 12px; color: #e4e4e7; cursor: pointer;">
                    <input type="radio" name="paymentMethod" value="BankTransfer" @(preferredMethod == "BankTransfer" ? "checked" : "") onchange="syncPaymentMethodInputs(this.value)" />
                    <span>โอนเงินผ่านแอปธนาคาร</span>
                </label>
            </div>
            <div style="display: flex; justify-content: flex-end; align-items: center; gap: 8px; padding-top: 8px; border-top: 1px solid #1f1f29;">
                <button type="submit" style="background: #23232e; color: #fff; border: 1px solid #383848; border-radius: 6px; padding: 6px 12px; font-size: 11.5px; font-weight: 600; cursor: pointer;">
                    บันทึกช่องทางชำระเงินหลัก
                </button>
            </div>
        </form>

        <!-- ส่วนที่ 2: รายการแพ็กเกจทั้งหมด (ป้องกันการกดเปลี่ยนแพ็กเกจไปมาซ้ำซ้อน) -->
        @if (allPackages.Any())
        {
            @if (scheduledSub != null)
            {
                <div style="background: rgba(245, 158, 11, 0.14); border: 1px solid rgba(245, 158, 11, 0.45); border-radius: 9px; padding: 10px 12px; margin-bottom: 10px; font-size: 11.5px; color: #fbbf24;">
                    คุณมีรายการตั้งเวลาเปลี่ยนเป็นแพ็กเกจ <strong>@(scheduledSub.Package?.PackageName)</strong> สำหรับรอบบิลถัดไปอยู่แล้ว ระบบจึงล็อกปุ่มเปลี่ยนแผนอื่นไว้ หากต้องการเปลี่ยนใจ กรุณากดยกเลิกคำขอเดิมก่อนครับ
                </div>
            }
            <div style="font-size: 12px; font-weight: 700; color: #a1a1aa; margin-bottom: 8px;">เลือกแพ็กเกจของคุณ:</div>
            @foreach (var pkg in allPackages)
            {
                bool isCurrentPkg = activeSub != null && activeSub.PackageId == pkg.PackageId;
                bool isScheduledPkg = scheduledSub != null && scheduledSub.PackageId == pkg.PackageId;
                bool isHigherTier = pkg.Price > pkgPrice;

                <div style="background: @(isCurrentPkg ? "rgba(229, 9, 20, 0.08)" : "#191920"); border: 1px solid @(isCurrentPkg ? "rgba(229, 9, 20, 0.45)" : (isScheduledPkg ? "rgba(245, 158, 11, 0.55)" : "#292934")); border-radius: 11px; padding: 12px 14px; margin-bottom: 10px;">
                    <div style="display: flex; justify-content: space-between; align-items: flex-start; gap: 10px; margin-bottom: 8px;">
                        <div>
                            <div style="display: flex; align-items: center; gap: 6px; flex-wrap: wrap;">
                                <span style="font-size: 14.5px; font-weight: 800; color: #ffffff;">@pkg.PackageName</span>
                                @if (isCurrentPkg)
                                {
                                    <span style="background: rgba(229, 9, 20, 0.2); color: #f87171; font-size: 10.5px; font-weight: 700; padding: 2px 7px; border-radius: 4px;">ใช้งานอยู่ปัจจุบัน</span>
                                }
                                @if (isScheduledPkg)
                                {
                                    <span style="background: rgba(245, 158, 11, 0.2); color: #fbbf24; font-size: 10.5px; font-weight: 700; padding: 2px 7px; border-radius: 4px;">ตั้งเวลาเปลี่ยนรอบหน้าแล้ว</span>
                                }
                            </div>
                            <div style="font-size: 11.5px; color: #a1a1aa; margin-top: 2px;">
                                @(pkg.IsVip == true ? "สิทธิ์เข้าห้องซ้อมและโค้ชส่วนตัวไม่จำกัดครั้ง" : $"ห้องซ้อม {pkg.PodQuota} ครั้ง • โค้ชส่วนตัว {pkg.PtQuota} ครั้ง • วัดมวลร่างกาย {pkg.InBodyQuota} ครั้ง")
                            </div>
                        </div>
                        <div style="text-align: right; flex-shrink: 0;">
                            <strong style="font-size: 15px; color: #ffffff;">฿@pkg.Price.ToString("N0")</strong>
                            <span style="font-size: 11px; color: #71717a; display: block;">/ 30 วัน</span>
                        </div>
                    </div>

                    @if (isCurrentPkg)
                    {
                        @if (scheduledSub != null)
                        {
                            <button type="button" disabled class="mp-btn-dark w-100" style="justify-content: center; padding: 8px 12px; font-size: 11.5px; opacity: 0.5; cursor: not-allowed;">
                                แพ็กเกจปัจจุบัน (ใช้งานได้ถึง @FormatThaiDate(currentEndDate))
                            </button>
                        }
                        else
                        {
                            <button type="button" class="mp-btn-dark w-100" style="justify-content: center; padding: 8px 12px; font-size: 12px;" onclick="closeChangePlanModal(); openCheckoutModal('topup', 'renew', 'ต่ออายุแพ็กเกจปัจจุบัน (@pkg.PackageName) ล่วงหน้า +30 วัน', @pkg.Price, 'next_cycle')">
                                ต่ออายุแพ็กเกจเดิมล่วงหน้า (+30 วัน)
                            </button>
                        }
                    }
                    else if (isScheduledPkg)
                    {
                        @if (!isNextCyclePaid)
                        {
                            <div style="display: flex; gap: 6px;">
                                <button type="button" class="mp-btn-red w-100" style="justify-content: center; padding: 8px 10px; font-size: 11.5px; flex: 1;" onclick="closeChangePlanModal(); openCheckoutModal('next_cycle_pay', '', 'ชำระล่วงหน้าแพ็กเกจ @pkg.PackageName (รอบเริ่ม @FormatThaiDate(scheduledSub!.StartDate))', @pkg.Price, '')">
                                    ชำระล่วงหน้าสำหรับรอบถัดไป
                                </button>
                                <form asp-controller="Customer" asp-action="CancelScheduledPlan" method="post" class="js-anti-spam-form" style="margin: 0;">
                                    <input type="hidden" name="email" value="@ViewBag.Email" />
                                    <button type="submit" class="mp-btn-dark" style="padding: 8px 10px; font-size: 11.5px;">
                                        ยกเลิกคำขอ
                                    </button>
                                </form>
                            </div>
                        }
                        else
                        {
                            <button type="button" disabled class="mp-btn-dark w-100" style="justify-content: center; padding: 8px 12px; font-size: 11.5px; color: #4ade80; border-color: rgba(34,197,94,0.4);">
                                ชำระเงินล่วงหน้าแล้ว (เริ่มมีผล @FormatThaiDate(scheduledSub!.StartDate))
                            </button>
                        }
                    }
                    else if (scheduledSub != null)
                    {
                        <!-- ล็อกปุ่มแพ็กเกจอื่นเมื่อมีรายการตั้งเวลาเปลี่ยนแผนค้างอยู่ ป้องกันการกดสลับไปมา -->
                        <button type="button" disabled class="mp-btn-dark w-100" style="justify-content: center; padding: 8px 12px; font-size: 11.5px; opacity: 0.45; cursor: not-allowed;">
                            ล็อกการเลือก (กรุณายกเลิกคำขอเปลี่ยนแผนเดิมก่อน)
                        </button>
                    }
                    else
                    {
                        <div style="display: flex; flex-direction: column; gap: 6px;">
                            <!-- ปุ่มหลัก: ตั้งเวลาเปลี่ยนในรอบบิลถัดไป (ถือแพ็กเกจเดิมจนสิ้นเดือน) -->
                            <form asp-controller="Customer" asp-action="TopUpQuota" method="post" class="js-anti-spam-form" style="margin: 0;">
                                <input type="hidden" name="email" value="@ViewBag.Email" />
                                <input type="hidden" name="addonType" value="switch_pkg_@pkg.PackageId" />
                                <input type="hidden" name="changeMode" value="next_cycle" />
                                <input type="hidden" name="paymentMethod" class="js-synced-pay-method" value="@preferredMethod" />
                                <button type="submit" class="mp-btn-red w-100" style="justify-content: center; padding: 8px 12px; font-size: 12px;">
                                    ตั้งค่าเปลี่ยนเป็น @pkg.PackageName ในรอบบิลถัดไป (เริ่ม @FormatThaiDate(nextCycleStartDate))
                                </button>
                            </form>

                            @if (isHigherTier)
                            {
                                <!-- ปุ่มทางเลือกเสริมเฉพาะกรณีอัปเกรดเป็นแพ็กเกจที่สูงขึ้น: เปิดหน้าต่างชำระเงินทันทีพร้อมทบโควต้า -->
                                <button type="button" class="mp-btn-dark w-100" style="justify-content: center; padding: 7px 12px; font-size: 11.5px; color: #d4d4d8;" onclick="closeChangePlanModal(); openCheckoutModal('topup', 'switch_pkg_@pkg.PackageId', 'อัปเกรดทันทีเป็น @pkg.PackageName (ทบโควต้าคงเหลือเดิม)', @pkg.Price, 'immediate_upgrade')">
                                    หรืออัปเกรดทันทีวันนี้ (ชำระเงินและทบโควต้าคงเหลือเดิมให้ทันที)
                                </button>
                            }
                        </div>
                    }
                </div>
            }
        }
    </div>
</div>

<!-- ================= MODAL หน้าต่างชำระเงินจริง (PAYMENT CHECKOUT MODAL: สแกน QR / โอนธนาคาร / ตัดบัตรเครดิต) ================= -->
<div class="mp-sheet-backdrop" id="checkoutModalBackdrop" onclick="if(event.target === this) closeCheckoutModal()" style="align-items: center; padding: 14px;">
    <div style="background: #141418; border: 1px solid #2d2d3a; border-radius: 16px; width: 100%; max-width: 460px; max-height: 92vh; overflow-y: auto; padding: 22px;">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 6px;">
            <h4 style="font-size: 17px; font-weight: 800; color: #ffffff; margin: 0;">ยืนยันการชำระเงิน</h4>
            <button type="button" onclick="closeCheckoutModal()" style="background: none; border: none; color: #a1a1aa; font-size: 22px; line-height: 1; cursor: pointer;">&times;</button>
        </div>
        <p style="font-size: 12px; color: #a1a1aa; margin-bottom: 14px;">ตรวจสอบรายการและดำเนินการชำระเงินเพื่อออกใบเสร็จรับเงิน</p>

        <!-- สรุปรายการและยอดชำระ -->
        <div style="background: #0d0d10; border: 1px solid #252530; border-radius: 10px; padding: 12px 14px; margin-bottom: 14px;">
            <div style="font-size: 11.5px; color: #71717a; margin-bottom: 2px;">รายการที่เลือก</div>
            <div style="font-size: 14px; font-weight: 700; color: #ffffff;" id="chkItemTitle">-</div>
            <div style="display: flex; justify-content: space-between; align-items: baseline; margin-top: 8px; padding-top: 8px; border-top: 1px solid #1f1f28;">
                <span style="font-size: 12px; color: #a1a1aa;">ยอดชำระสุทธิ (รวมภาษีมูลค่าเพิ่ม 7%)</span>
                <strong style="font-size: 19px; color: #e50914;" id="chkAmountDisplay">฿0</strong>
            </div>
        </div>

        <form id="checkoutPaymentForm" asp-controller="Customer" asp-action="TopUpQuota" method="post" class="js-anti-spam-form" style="margin: 0;">
            <input type="hidden" name="email" value="@ViewBag.Email" />
            <input type="hidden" name="addonType" id="chkAddonType" value="" />
            <input type="hidden" name="changeMode" id="chkChangeMode" value="next_cycle" />

            <!-- เลือกช่องทางชำระเงิน -->
            <div style="font-size: 12px; font-weight: 700; color: #ffffff; margin-bottom: 8px;">เลือกช่องทางการชำระเงิน:</div>
            <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; margin-bottom: 14px;">
                <label id="chkTabPromptPay" style="background: #1a1a22; border: 1px solid #323240; border-radius: 8px; padding: 9px 6px; text-align: center; font-size: 11.5px; font-weight: 700; color: #fff; cursor: pointer;">
                    <input type="radio" name="paymentMethod" value="PromptPay" style="display: none;" onchange="switchCheckoutMethod('PromptPay')" @(preferredMethod == "PromptPay" ? "checked" : "") />
                    <span>QR PromptPay</span>
                </label>
                <label id="chkTabCreditCard" style="background: #1a1a22; border: 1px solid #323240; border-radius: 8px; padding: 9px 6px; text-align: center; font-size: 11.5px; font-weight: 700; color: #fff; cursor: pointer;">
                    <input type="radio" name="paymentMethod" value="CreditCard" style="display: none;" onchange="switchCheckoutMethod('CreditCard')" @(preferredMethod == "CreditCard" ? "checked" : "") />
                    <span>บัตรเครดิต/เดบิต</span>
                </label>
                <label id="chkTabBankTransfer" style="background: #1a1a22; border: 1px solid #323240; border-radius: 8px; padding: 9px 6px; text-align: center; font-size: 11.5px; font-weight: 700; color: #fff; cursor: pointer;">
                    <input type="radio" name="paymentMethod" value="BankTransfer" style="display: none;" onchange="switchCheckoutMethod('BankTransfer')" @(preferredMethod == "BankTransfer" ? "checked" : "") />
                    <span>โอนบัญชีธนาคาร</span>
                </label>
            </div>

            <!-- กล่องแสดงรายละเอียดตามช่องทางชำระเงินที่เลือก -->
            <!-- 1. กล่องสแกน QR PromptPay -->
            <div id="chkBoxPromptPay" style="background: #101015; border: 1px solid #262632; border-radius: 12px; padding: 16px; text-align: center; margin-bottom: 14px;">
                <div style="font-size: 12px; font-weight: 700; color: #ffffff; margin-bottom: 8px;">สแกน QR PromptPay ด้วยแอปธนาคารใดก็ได้</div>
                <!-- QR Code จำลองมาตรฐาน PromptPay -->
                <div style="width: 148px; height: 148px; margin: 0 auto 10px auto; background: #ffffff; padding: 10px; border-radius: 10px; display: flex; align-items: center; justify-content: center;">
                    <svg viewBox="0 0 100 100" width="128" height="128">
                        <rect width="100" height="100" fill="#fff" />
                        <rect x="6" y="6" width="26" height="26" fill="none" stroke="#000" stroke-width="6" />
                        <rect x="13" y="13" width="12" height="12" fill="#000" />
                        <rect x="68" y="6" width="26" height="26" fill="none" stroke="#000" stroke-width="6" />
                        <rect x="75" y="13" width="12" height="12" fill="#000" />
                        <rect x="6" y="68" width="26" height="26" fill="none" stroke="#000" stroke-width="6" />
                        <rect x="13" y="75" width="12" height="12" fill="#000" />
                        <rect x="40" y="10" width="6" height="18" fill="#000" />
                        <rect x="50" y="16" width="10" height="6" fill="#000" />
                        <rect x="38" y="38" width="24" height="24" rx="4" fill="#e50914" />
                        <text x="50" y="54" text-anchor="middle" fill="#fff" font-size="10" font-weight="bold" font-family="sans-serif">PG</text>
                        <rect x="12" y="42" width="18" height="6" fill="#000" />
                        <rect x="68" y="44" width="20" height="6" fill="#000" />
                        <rect x="42" y="70" width="12" height="6" fill="#000" />
                        <rect x="62" y="68" width="8" height="22" fill="#000" />
                        <rect x="76" y="76" width="16" height="16" fill="#000" />
                    </svg>
                </div>
                <div style="font-size: 11.5px; color: #a1a1aa; margin-bottom: 10px;">
                    ชื่อบัญชี: <strong style="color: #fff;">บจก. ไพรเวทยิม (PrivateGym Co., Ltd.)</strong>
                </div>
                <div style="text-align: left;">
                    <label style="font-size: 11px; color: #a1a1aa; display: block; margin-bottom: 4px;">เลขที่อ้างอิงสลิปโอนเงิน (4-8 หลักท้าย หรือเว้นว่างเพื่อใช้อ้างอิงอัตโนมัติ):</label>
                    <input type="text" id="chkSlipInputPromptPay" maxlength="20" placeholder="เช่น SLIP9842" oninput="document.getElementById('chkFinalSlipRef').value = this.value" style="width: 100%; background: #181820; border: 1px solid #30303e; border-radius: 7px; padding: 8px 10px; color: #fff; font-size: 12.5px;" />
                </div>
            </div>

            <!-- 2. กล่องตัดบัตรเครดิต/เดบิตที่ผูกไว้ -->
            <div id="chkBoxCreditCard" style="display: none; background: #101015; border: 1px solid #262632; border-radius: 12px; padding: 14px; margin-bottom: 14px;">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px;">
                    <span style="font-size: 12px; font-weight: 700; color: #ffffff;">บัตรเครดิต / เดบิตที่ผูกไว้กับบัญชี</span>
                    <span style="background: rgba(34,197,94,0.15); color: #4ade80; font-size: 10.5px; font-weight: 700; padding: 2px 7px; border-radius: 4px;">พร้อมตัดยอด</span>
                </div>
                <div style="background: #181820; border: 1px solid #2c2c38; border-radius: 8px; padding: 10px 12px; display: flex; justify-content: space-between; align-items: center;">
                    <div>
                        <div style="font-size: 13px; font-weight: 700; color: #ffffff;">VISA / MASTERCARD &bull;&bull;&bull;&bull; 4829</div>
                        <div style="font-size: 11px; color: #a1a1aa;">ผู้ถือบัตร: @ViewBag.FullName</div>
                    </div>
                    <span style="font-size: 11px; color: #71717a;">Verified</span>
                </div>
            </div>

            <!-- 3. กล่องโอนผ่านบัญชีธนาคาร -->
            <div id="chkBoxBankTransfer" style="display: none; background: #101015; border: 1px solid #262632; border-radius: 12px; padding: 14px; margin-bottom: 14px;">
                <div style="font-size: 12px; font-weight: 700; color: #ffffff; margin-bottom: 6px;">โอนเงินเข้าบัญชีธนาคาร</div>
                <div style="background: #181820; border: 1px solid #2c2c38; border-radius: 8px; padding: 10px 12px; margin-bottom: 10px; font-size: 12px; color: #e4e4e7;">
                    <div>ธนาคารกสิกรไทย (KBANK)</div>
                    <div style="font-size: 14px; font-weight: 800; color: #4ade80; margin: 2px 0;">094-2-88412-0</div>
                    <div style="font-size: 11px; color: #a1a1aa;">ชื่อบัญชี: บริษัท ไพรเวทยิม จำกัด</div>
                </div>
                <div>
                    <label style="font-size: 11px; color: #a1a1aa; display: block; margin-bottom: 4px;">กรอกรหัสอ้างอิงสลิปการโอนเงิน:</label>
                    <input type="text" id="chkSlipInputBank" maxlength="20" placeholder="เช่น KBANK1029" oninput="document.getElementById('chkFinalSlipRef').value = this.value" style="width: 100%; background: #181820; border: 1px solid #30303e; border-radius: 7px; padding: 8px 10px; color: #fff; font-size: 12.5px;" />
                </div>
            </div>

            <input type="hidden" name="slipRef" id="chkFinalSlipRef" value="" />

            <div style="display: flex; gap: 8px;">
                <button type="button" class="mp-btn-dark w-100" onclick="closeCheckoutModal()" style="justify-content: center;">ยกเลิก</button>
                <button type="submit" class="mp-btn-red w-100" style="justify-content: center; padding: 11px 14px;">ยืนยันการชำระเงิน</button>
            </div>
        </form>
    </div>
</div>

<!-- ================= MODAL ใบเสร็จรับเงิน / ใบกำกับภาษีอย่างย่อ (PDF Receipt Preview) ================= -->
<div class="mp-sheet-backdrop" id="receiptModalBackdrop" onclick="if(event.target === this) closeReceiptModal()" style="align-items: center; padding: 16px;">
    <div style="background: #141418; border: 1px solid #2d2d38; border-radius: 16px; width: 100%; max-width: 420px; padding: 24px;">
        <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 16px; padding-bottom: 14px; border-bottom: 1px dashed #2c2c36;">
            <div>
                <div style="font-size: 11px; font-weight: 800; color: #e50914; letter-spacing: 0.5px;">PRIVATEGYM CO., LTD.</div>
                <h4 style="font-size: 17px; font-weight: 800; color: #ffffff; margin: 2px 0;">ใบเสร็จรับเงิน / ใบกำกับภาษี</h4>
                <div style="font-size: 11px; color: #71717a;">เลขผู้เสียภาษี: 0105562098421</div>
            </div>
            <span style="background: rgba(34,197,94,0.14); border: 1px solid rgba(34,197,94,0.35); color: #4ade80; font-size: 11px; font-weight: 700; padding: 3px 9px; border-radius: 6px;">ชำระแล้ว</span>
        </div>

        <div style="font-size: 13px; color: #d4d4d8; display: flex; flex-direction: column; gap: 10px; margin-bottom: 20px;">
            <div style="display: flex; justify-content: space-between;">
                <span style="color: #71717a;">เลขที่เอกสาร:</span>
                <strong style="font-family: monospace; color: #fff;" id="rcModalRef">-</strong>
            </div>
            <div style="display: flex; justify-content: space-between;">
                <span style="color: #71717a;">วันที่ทำรายการ:</span>
                <span id="rcModalDate">-</span>
            </div>
            <div style="display: flex; justify-content: space-between;">
                <span style="color: #71717a;">ลูกค้า:</span>
                <span>@ViewBag.FullName</span>
            </div>
            <div style="display: flex; justify-content: space-between;">
                <span style="color: #71717a;">ช่องทางชำระ:</span>
                <span id="rcModalMethod">-</span>
            </div>
            <div style="padding: 12px; background: #0d0d10; border: 1px solid #24242d; border-radius: 8px; margin-top: 4px;">
                <div style="font-size: 11.5px; color: #71717a; margin-bottom: 4px;">รายการที่ชำระ</div>
                <div style="font-size: 13.5px; font-weight: 700; color: #fff;" id="rcModalDesc">-</div>
                <div style="display: flex; justify-content: space-between; align-items: baseline; margin-top: 10px; padding-top: 10px; border-top: 1px solid #1f1f27;">
                    <span style="font-size: 12px; color: #a1a1aa;">ยอดชำระสุทธิ (รวมภาษีมูลค่าเพิ่ม 7%)</span>
                    <strong style="font-size: 18px; color: #4ade80;" id="rcModalAmount">-</strong>
                </div>
            </div>
        </div>

        <div style="display: flex; gap: 10px;">
            <button type="button" class="mp-btn-dark w-100" onclick="closeReceiptModal()" style="justify-content: center;">ปิดหน้าต่าง</button>
            <button type="button" class="mp-btn-red w-100" onclick="window.print()" style="justify-content: center;">พิมพ์ / บันทึก PDF</button>
        </div>
    </div>
</div>

<script>
    function openMobileTopupSheet() {
        var el = document.getElementById('mobileTopupSheetBackdrop');
        if (el) el.classList.add('show');
    }

    function closeMobileTopupSheet() {
        var el = document.getElementById('mobileTopupSheetBackdrop');
        if (el) el.classList.remove('show');
    }

    function openChangePlanModal() {
        var el = document.getElementById('changePlanModalBackdrop');
        if (el) el.classList.add('show');
    }

    function closeChangePlanModal() {
        var el = document.getElementById('changePlanModalBackdrop');
        if (el) el.classList.remove('show');
    }

    // เปิดหน้าต่าง Checkout ยืนยันการชำระเงิน (รองรับทั้ง ซื้อโควต้าเพิ่ม / อัปเกรดทันที / ชำระล่วงหน้ารอบถัดไป)
    function openCheckoutModal(actionMode, addonType, itemTitle, amount, changeMode) {
        var form = document.getElementById('checkoutPaymentForm');
        if (actionMode === 'next_cycle_pay') {
            form.action = '/Customer/PayScheduledPlanNow';
        } else {
            form.action = '/Customer/TopUpQuota';
        }

        document.getElementById('chkAddonType').value = addonType || '';
        document.getElementById('chkChangeMode').value = changeMode || 'next_cycle';
        document.getElementById('chkItemTitle').innerText = itemTitle;
        document.getElementById('chkAmountDisplay').innerText = '฿' + Number(amount).toLocaleString();
        document.getElementById('chkFinalSlipRef').value = '';

        var pInput = document.getElementById('chkSlipInputPromptPay');
        if (pInput) pInput.value = '';
        var bInput = document.getElementById('chkSlipInputBank');
        if (bInput) bInput.value = '';

        var currentRadio = document.querySelector('#checkoutPaymentForm input[name="paymentMethod"]:checked');
        switchCheckoutMethod(currentRadio ? currentRadio.value : '@preferredMethod');

        var el = document.getElementById('checkoutModalBackdrop');
        if (el) el.classList.add('show');
    }

    function closeCheckoutModal() {
        var el = document.getElementById('checkoutModalBackdrop');
        if (el) el.classList.remove('show');
    }

    function switchCheckoutMethod(method) {
        var boxPP = document.getElementById('chkBoxPromptPay');
        var boxCC = document.getElementById('chkBoxCreditCard');
        var boxBT = document.getElementById('chkBoxBankTransfer');

        var tabPP = document.getElementById('chkTabPromptPay');
        var tabCC = document.getElementById('chkTabCreditCard');
        var tabBT = document.getElementById('chkTabBankTransfer');

        if (boxPP) boxPP.style.display = (method === 'PromptPay') ? 'block' : 'none';
        if (boxCC) boxCC.style.display = (method === 'CreditCard') ? 'block' : 'none';
        if (boxBT) boxBT.style.display = (method === 'BankTransfer') ? 'block' : 'none';

        if (tabPP) tabPP.style.borderColor = (method === 'PromptPay') ? '#e50914' : '#323240';
        if (tabCC) tabCC.style.borderColor = (method === 'CreditCard') ? '#e50914' : '#323240';
        if (tabBT) tabBT.style.borderColor = (method === 'BankTransfer') ? '#e50914' : '#323240';
    }

    function openReceiptModal(refNo, dateStr, desc, amount, method) {
        document.getElementById('rcModalRef').innerText = refNo;
        document.getElementById('rcModalDate').innerText = dateStr;
        document.getElementById('rcModalDesc').innerText = desc;
        document.getElementById('rcModalAmount').innerText = amount;
        document.getElementById('rcModalMethod').innerText = method || 'สแกน QR PromptPay';
        var el = document.getElementById('receiptModalBackdrop');
        if (el) el.classList.add('show');
    }

    function closeReceiptModal() {
        var el = document.getElementById('receiptModalBackdrop');
        if (el) el.classList.remove('show');
    }

    function syncPaymentMethodInputs(val) {
        document.querySelectorAll('.js-synced-pay-method').forEach(function (inp) {
            inp.value = val;
        });
    }

    // ระบบป้องกันการกดปุ่มซ้ำย้ำๆ (Client-Side Double-Submit & Rapid-Click Lock)
    (function () {
        var isSubmittingAnyForm = false;
        document.querySelectorAll('form').forEach(function (form) {
            form.addEventListener('submit', function (e) {
                if (isSubmittingAnyForm || form.dataset.submitted === 'true') {
                    e.preventDefault();
                    return false;
                }
                isSubmittingAnyForm = true;
                form.dataset.submitted = 'true';

                var allBtns = document.querySelectorAll('button[type="submit"]');
                allBtns.forEach(function (btn) {
                    btn.disabled = true;
                    btn.style.pointerEvents = 'none';
                    btn.style.opacity = '0.6';
                });

                var clickedBtn = form.querySelector('button[type="submit"]');
                if (clickedBtn) {
                    clickedBtn.innerText = 'กำลังดำเนินการ...';
                }
            });
        });
    })();
</script>
