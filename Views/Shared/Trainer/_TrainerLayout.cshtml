<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover" />
    <title>@ViewData["Title"] - PrivateGym โค้ชผู้ฝึกสอน</title>
    <link rel="icon" type="image/png" href="~/IconPrivate.png" asp-append-version="true" />

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/CustomerDashboard.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/UnifiedWorkspace.css" asp-append-version="true" />
    <style>
        /* Unified Typography & shadcn/ui Dark Design System for Trainer */
        body.customer-dashboard-body,
        body.customer-dashboard-body input,
        body.customer-dashboard-body select,
        body.customer-dashboard-body button,
        body.customer-dashboard-body textarea,
        body.customer-dashboard-body table {
            font-family: 'Inter', 'Loma', -apple-system, BlinkMacSystemFont, sans-serif !important;
        }

        .cd-content {
            width: 100%;
        }

        .cd-page-title {
            font-size: 22px;
            font-weight: 600;
            letter-spacing: -0.015em;
            color: #fafafa;
        }

        .cd-page-subtext {
            font-size: 13px;
            font-weight: 400;
            color: #a1a1aa;
            margin-top: 4px;
        }

        .st-filter-bar {
            display: flex;
            flex-wrap: wrap;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
            margin-bottom: 18px;
        }

        .st-chips {
            display: inline-flex;
            flex-wrap: wrap;
            align-items: center;
            gap: 6px;
            background: #09090b;
            border: 1px solid #27272a;
            border-radius: 10px;
            padding: 4px;
        }

        .st-chip {
            padding: 6px 12px;
            border-radius: 7px;
            font-size: 12.5px;
            font-weight: 500;
            text-decoration: none;
            border: 1px solid transparent;
            background: transparent;
            color: #a1a1aa;
            transition: all 0.15s ease;
            white-space: nowrap;
            cursor: pointer;
        }

        .st-chip:hover {
            color: #fafafa;
            background: #18181b;
        }

        .st-chip.active {
            background: #18181b;
            border-color: rgba(229, 9, 20, 0.55);
            color: #ffffff;
            font-weight: 500;
        }

        .st-input {
            height: 36px;
            background: #09090b !important;
            border: 1px solid #27272a !important;
            border-radius: 8px !important;
            color: #fafafa !important;
            font-size: 13px !important;
            font-weight: 400 !important;
            padding: 0 12px !important;
            outline: none;
            transition: border-color 0.15s ease, box-shadow 0.15s ease;
        }

        .st-input::placeholder {
            color: #71717a !important;
            opacity: 1 !important;
        }

        .st-input:focus {
            border-color: #e50914 !important;
            box-shadow: 0 0 0 2px rgba(229, 9, 20, 0.2) !important;
        }

        .st-btn-primary {
            height: 36px;
            padding: 0 16px;
            border-radius: 8px;
            background: #e50914;
            border: 1px solid #e50914;
            color: #ffffff;
            font-size: 13px;
            font-weight: 500;
            cursor: pointer;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            text-decoration: none;
            transition: background-color 0.15s ease;
            white-space: nowrap;
        }

        .st-btn-primary:hover {
            background: #b91c1c;
            border-color: #b91c1c;
            color: #ffffff;
        }

        .st-btn-outline {
            height: 36px;
            padding: 0 14px;
            border-radius: 8px;
            background: #09090b;
            border: 1px solid #27272a;
            color: #e4e4e7;
            font-size: 12.5px;
            font-weight: 500;
            cursor: pointer;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            text-decoration: none;
            transition: all 0.15s ease;
            white-space: nowrap;
        }

        .st-btn-outline:hover {
            background: #18181b;
            border-color: #3f3f46;
            color: #fafafa;
        }

        .st-table-card {
            background: #09090b;
            border: 1px solid #27272a;
            border-radius: 12px;
            overflow: hidden;
        }

        .st-shadcn-table {
            width: 100%;
            border-collapse: collapse;
        }

        .st-shadcn-table thead th {
            padding: 12px 16px;
            font-size: 11.5px;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.04em;
            color: #71717a;
            border-bottom: 1px solid #27272a;
            text-align: left;
            background: #0c0c0f;
        }

        .st-shadcn-table tbody td {
            padding: 13px 16px;
            font-size: 13px;
            color: #d4d4d8;
            border-bottom: 1px solid #18181b;
            vertical-align: middle;
        }

        .st-shadcn-table tbody tr:last-child td {
            border-bottom: none;
        }

        .st-shadcn-table tbody tr:hover td {
            background: rgba(255, 255, 255, 0.02);
        }

        .st-badge {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            padding: 3px 9px;
            border-radius: 999px;
            font-size: 11px;
            font-weight: 600;
            border: 1px solid transparent;
            white-space: nowrap;
        }

        .st-badge-green {
            background: rgba(16, 185, 129, 0.12);
            color: #10b981;
            border-color: rgba(16, 185, 129, 0.3);
        }

        .st-badge-amber {
            background: rgba(245, 158, 11, 0.12);
            color: #f59e0b;
            border-color: rgba(245, 158, 11, 0.3);
        }

        .st-badge-red {
            background: rgba(239, 68, 68, 0.12);
            color: #ef4444;
            border-color: rgba(239, 68, 68, 0.3);
        }

        .st-badge-blue {
            background: rgba(59, 130, 246, 0.12);
            color: #60a5fa;
            border-color: rgba(59, 130, 246, 0.3);
        }
    </style>
</head>
<body class="customer-dashboard-body">

    <div class="cd-sidebar-backdrop" id="trSidebarBackdrop"></div>

    <!-- ================= TRAINER SIDEBAR (DESKTOP) ================= -->
    <aside class="cd-sidebar" id="trSidebar">
        <div>
            <div class="d-flex align-items-center justify-content-between pb-2 mb-2 border-bottom border-secondary border-opacity-25">
                <a asp-controller="Trainer" asp-action="Index" asp-route-email="@ViewBag.Email" class="cd-sidebar-logo p-0 m-0 border-0">
                    <img src="~/images/logo.png" alt="PrivateGym" class="cd-sidebar-logo-img" />
                </a>
                <button type="button" class="btn text-white-50 d-lg-none border-0 p-2" id="trSidebarCloseBtn" aria-label="ปิดเมนู" style="font-size: 24px; line-height: 1;">
                    &times;
                </button>
            </div>

            <ul class="cd-sidebar-nav">
                <li class="pg-sb-cat">COACHING</li>
                <li class="cd-nav-item @(ViewContext.RouteData.Values["Action"]?.ToString() == "Index" ? "active" : "")">
                    <a asp-controller="Trainer" asp-action="Index" asp-route-email="@ViewBag.Email">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <rect x="3" y="3" width="7" height="7" rx="1"></rect>
                            <rect x="14" y="3" width="7" height="7" rx="1"></rect>
                            <rect x="3" y="14" width="7" height="7" rx="1"></rect>
                            <rect x="14" y="14" width="7" height="7" rx="1"></rect>
                        </svg>
                        <span>แดชบอร์ด &amp; บันทึกฝึก</span>
                    </a>
                </li>

                <li class="cd-nav-item @(ViewContext.RouteData.Values["Action"]?.ToString() == "Schedule" ? "active" : "")">
                    <a asp-controller="Trainer" asp-action="Schedule" asp-route-email="@ViewBag.Email">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                            <line x1="16" y1="2" x2="16" y2="6"></line>
                            <line x1="8" y1="2" x2="8" y2="6"></line>
                            <line x1="3" y1="10" x2="21" y2="10"></line>
                        </svg>
                        <span>ตารางของฉัน (Schedule)</span>
                    </a>
                </li>

                <li class="cd-nav-item @(ViewContext.RouteData.Values["Action"]?.ToString() == "Availability" ? "active" : "")">
                    <a asp-controller="Trainer" asp-action="Availability" asp-route-email="@ViewBag.Email">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <circle cx="12" cy="12" r="10"></circle>
                            <polyline points="12 6 12 12 16 14"></polyline>
                        </svg>
                        <span>เวลาว่าง (Availability)</span>
                    </a>
                </li>

                <li class="pg-sb-cat">CLIENTS &amp; RECORDS</li>
                <li class="cd-nav-item @(ViewContext.RouteData.Values["Action"]?.ToString() == "Clients" ? "active" : "")">
                    <a asp-controller="Trainer" asp-action="Clients" asp-route-email="@ViewBag.Email">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                            <circle cx="9" cy="7" r="4"></circle>
                            <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
                            <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
                        </svg>
                        <span>ลูกค้าในการดูแล (Clients)</span>
                    </a>
                </li>

                <li class="cd-nav-item @(ViewContext.RouteData.Values["Action"]?.ToString() == "History" ? "active" : "")">
                    <a asp-controller="Trainer" asp-action="History" asp-route-email="@ViewBag.Email">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                            <polyline points="14 2 14 8 20 8"></polyline>
                            <line x1="16" y1="13" x2="8" y2="13"></line>
                            <line x1="16" y1="17" x2="8" y2="17"></line>
                        </svg>
                        <span>ประวัติการสอน (History)</span>
                    </a>
                </li>

                <li class="cd-nav-item @(ViewContext.RouteData.Values["Action"]?.ToString() == "Profile" ? "active" : "")">
                    <a asp-controller="Trainer" asp-action="Profile" asp-route-email="@ViewBag.Email">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                            <circle cx="12" cy="7" r="4"></circle>
                        </svg>
                        <span>โปรไฟล์โค้ช</span>
                    </a>
                </li>
            </ul>
        </div>

        <div class="pg-sb-user">
            <div class="pg-sb-user-left">
                <div class="pg-sb-avatar">@((((ViewBag.FullName as string) ?? "C").Trim().Length > 0 ? ((ViewBag.FullName as string) ?? "C").Trim()[0].ToString() : "C"))</div>
                <div class="pg-sb-info">
                    <span class="pg-sb-name">@(ViewBag.FullName ?? "Coach")</span>
                    <span class="pg-sb-role">Trainer • @(ViewBag.Specialty ?? "Coach")</span>
                </div>
            </div>
            <a asp-controller="Login" asp-action="Logout" class="pg-sb-logout" title="ออกจากระบบ" aria-label="ออกจากระบบ">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
                    <polyline points="16 17 21 12 16 7"></polyline>
                    <line x1="21" y1="12" x2="9" y2="12"></line>
                </svg>
            </a>
        </div>
    </aside>

    <!-- ================= MAIN WRAPPER ================= -->
    <div class="cd-main-wrapper">
        @{
            string currentAct = ViewContext.RouteData.Values["Action"]?.ToString() ?? "Index";
            string pageLabel = currentAct switch
            {
                "Schedule" => "ตารางของฉัน (My Schedule)",
                "Availability" => "เวลาว่าง & สล็อตการสอน",
                "Clients" => "รายชื่อลูกค้าในการดูแล",
                "History" => "ประวัติการสอนและค่าตอบแทน",
                "Profile" => "โปรไฟล์โค้ช",
                _ => "แดชบอร์ด & บันทึกการฝึกสอน"
            };

            string displayName = ViewBag.FullName?.ToString() ?? "Coach PrivateGym";
            string displayEmail = ViewBag.Email?.ToString() ?? "alex@privategym.club";
            char initialChar = string.IsNullOrEmpty(displayName) ? 'C' : displayName.TrimStart("Coach ".ToCharArray()).Trim().FirstOrDefault();
            if (initialChar == '\0') initialChar = 'C';
        }

        <header class="cd-topbar d-none d-lg-flex" style="position: sticky; top: 0;">
            <div class="d-flex align-items-center gap-2">
                <div class="cd-breadcrumb">
                    <span>PrivateGym</span>
                    <span>/</span>
                    <span class="active">@pageLabel</span>
                </div>
            </div>

            <div class="cd-topbar-right">
                <div class="cd-quota-badge d-none d-sm-inline-flex">
                    @(ViewBag.Specialty ?? "Strength & Conditioning")
                </div>
                <div class="d-flex align-items-center gap-2">
                    <div class="cd-user-avatar">@initialChar</div>
                    <div class="cd-user-info text-start d-none d-sm-flex">
                        <span class="cd-user-name">@displayName</span>
                        <span class="cd-user-role">@displayEmail</span>
                    </div>
                </div>
            </div>
        </header>

        <div class="cd-main-content">
            @RenderBody()
        </div>
    </div>

    <!-- ================= MOBILE BOTTOM NAVIGATION BAR (4 TABS) ================= -->
    <nav class="cd-bottom-nav d-lg-none" id="trainerBottomNav">
        <a asp-controller="Trainer" asp-action="Index" asp-route-email="@ViewBag.Email"
           class="cd-bnav-item @(currentAct == "Index" ? "active" : "")">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <rect x="3" y="3" width="7" height="7" rx="1"></rect>
                <rect x="14" y="3" width="7" height="7" rx="1"></rect>
                <rect x="3" y="14" width="7" height="7" rx="1"></rect>
                <rect x="14" y="14" width="7" height="7" rx="1"></rect>
            </svg>
            <span>แดชบอร์ด</span>
        </a>

        <a asp-controller="Trainer" asp-action="Schedule" asp-route-email="@ViewBag.Email"
           class="cd-bnav-item @(currentAct == "Schedule" ? "active" : "")">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                <line x1="16" y1="2" x2="16" y2="6"></line>
                <line x1="8" y1="2" x2="8" y2="6"></line>
                <line x1="3" y1="10" x2="21" y2="10"></line>
            </svg>
            <span>ตาราง</span>
        </a>

        <a asp-controller="Trainer" asp-action="Clients" asp-route-email="@ViewBag.Email"
           class="cd-bnav-item @(currentAct == "Clients" ? "active" : "")">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                <circle cx="9" cy="7" r="4"></circle>
            </svg>
            <span>ลูกค้า</span>
        </a>

        <a asp-controller="Trainer" asp-action="History" asp-route-email="@ViewBag.Email"
           class="cd-bnav-item @(currentAct == "History" ? "active" : "")">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="12" cy="12" r="10"></circle>
                <polyline points="12 6 12 12 16 14"></polyline>
            </svg>
            <span>ประวัติ</span>
        </a>
    </nav>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        const trSidebar = document.getElementById('trSidebar');
        const trBackdrop = document.getElementById('trSidebarBackdrop');
        const trCloseBtn = document.getElementById('trSidebarCloseBtn');

        function openTrainerSidebar() {
            if (trSidebar) trSidebar.classList.add('mobile-open');
            if (trBackdrop) trBackdrop.classList.add('active');
            document.body.style.overflow = 'hidden';
        }

        function closeTrainerSidebar() {
            if (trSidebar) trSidebar.classList.remove('mobile-open');
            if (trBackdrop) trBackdrop.classList.remove('active');
            document.body.style.overflow = '';
        }

        if (trCloseBtn) trCloseBtn.addEventListener('click', closeTrainerSidebar);
        if (trBackdrop) trBackdrop.addEventListener('click', closeTrainerSidebar);
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
