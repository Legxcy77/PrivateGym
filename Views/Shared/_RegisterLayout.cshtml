<!DOCTYPE html>
<html class="dark" lang="th">
<head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <title>@ViewData["Title"] - PrivateGym</title>
    <link rel="icon" type="image/png" href="~/IconPrivate.png" asp-append-version="true" />
    <link href="https://fonts.googleapis.com" rel="preconnect" />
    <link crossorigin="" href="https://fonts.gstatic.com" rel="preconnect" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800&family=Noto+Sans+Thai:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet" />
    <style>
        @@layer base {
            html, body {
                margin: 0;
                padding: 0;
                font-family: 'Noto Sans Thai', 'Inter', sans-serif;
            }
            body {
                overscroll-behavior: none;
            }
            main > :first-child {
                margin-top: 0 !important;
            }
            main > :last-child {
                margin-bottom: 0 !important;
            }
        }
        ::-webkit-scrollbar {
            display: none;
        }
    </style>
    <script src="https://cdn.tailwindcss.com"></script>
    <script id="tailwind-config">
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    "colors": {
                        "on-error": "#690005",
                        "surface-bright": "#3a3939",
                        "on-tertiary-container": "#faf9ff",
                        "status-info": "#3B82F6",
                        "surface-container-high": "#2a2a2a",
                        "secondary": "#ffb690",
                        "inverse-primary": "#c00008",
                        "on-error-container": "#ffdad6",
                        "on-primary-fixed-variant": "#930005",
                        "error-container": "#93000a",
                        "surface-container-low": "#1c1b1b",
                        "text-primary": "#FFFFFF",
                        "on-primary-container": "#fff9f8",
                        "surface-container-highest": "#353534",
                        "text-muted": "#6B7280",
                        "accent-red": "#E8000D",
                        "outline-variant": "#5f3f3a",
                        "secondary-fixed": "#ffdbca",
                        "surface-variant": "#353534",
                        "tertiary-container": "#006ded",
                        "on-tertiary": "#002e6b",
                        "surface-dim": "#131313",
                        "inverse-surface": "#e5e2e1",
                        "secondary-container": "#ec6a06",
                        "surface": "#131313",
                        "on-surface-variant": "#e9bcb6",
                        "on-secondary-fixed": "#341100",
                        "surface-container": "#201f1f",
                        "secondary-fixed-dim": "#ffb690",
                        "on-secondary-container": "#4a1c00",
                        "primary": "#ffb4a9",
                        "on-background": "#e5e2e1",
                        "tertiary-fixed": "#d8e2ff",
                        "on-tertiary-fixed-variant": "#004397",
                        "bg-surface-2": "#222222",
                        "on-secondary": "#552100",
                        "border-subtle": "#2A2A2A",
                        "primary-fixed": "#ffdad5",
                        "on-tertiary-fixed": "#001a43",
                        "status-success": "#10B981",
                        "bg-primary": "#0A0A0A",
                        "on-secondary-fixed-variant": "#783200",
                        "primary-container": "#e8000d",
                        "error": "#ffb4ab",
                        "primary-fixed-dim": "#ffb4a9",
                        "tertiary": "#aec6ff",
                        "on-primary": "#690002",
                        "text-secondary": "#9CA3AF",
                        "status-warning": "#F59E0B",
                        "on-surface": "#e5e2e1",
                        "bg-surface": "#1A1A1A",
                        "bg-sidebar": "#111111",
                        "surface-tint": "#ffb4a9",
                        "accent-red-glow": "rgba(232, 0, 13, 0.15)",
                        "background": "#131313",
                        "inverse-on-surface": "#313030",
                        "on-primary-fixed": "#410001",
                        "status-error": "#EF4444",
                        "tertiary-fixed-dim": "#aec6ff",
                        "surface-container-lowest": "#0e0e0e",
                        "outline": "#b08781"
                    },
                    "borderRadius": {
                        "DEFAULT": "0.25rem",
                        "lg": "0.5rem",
                        "xl": "0.75rem",
                        "full": "9999px"
                    },
                    "spacing": {
                        "space-xl": "2rem",
                        "gutter": "1.5rem",
                        "space-md": "1rem",
                        "space-xs": "0.25rem",
                        "margin": "2rem",
                        "gutter-mobile": "1rem",
                        "margin-mobile": "1rem",
                        "space-lg": "1.5rem",
                        "space-sm": "0.5rem"
                    },
                    "fontFamily": {
                        "headline-xl": ["Inter"],
                        "display-hero-mobile": ["Inter"],
                        "label-md": ["Inter"],
                        "body-lg": ["Inter"],
                        "headline-sm": ["Inter"],
                        "headline-md": ["Inter"],
                        "label-lg": ["Inter"],
                        "body-sm": ["Inter"],
                        "headline-lg": ["Inter"],
                        "label-sm": ["Inter"],
                        "body-md": ["Inter"],
                        "display-hero": ["Inter"]
                    },
                    "fontSize": {
                        "headline-xl": ["32px", { "lineHeight": "40px", "letterSpacing": "-0.02em", "fontWeight": "700" }],
                        "display-hero-mobile": ["36px", { "lineHeight": "44px", "letterSpacing": "-0.02em", "fontWeight": "800" }],
                        "label-md": ["12px", { "lineHeight": "16px", "letterSpacing": "0.02em", "fontWeight": "600" }],
                        "body-lg": ["16px", { "lineHeight": "24px", "fontWeight": "400" }],
                        "headline-sm": ["18px", { "lineHeight": "26px", "fontWeight": "600" }],
                        "headline-md": ["20px", { "lineHeight": "28px", "fontWeight": "600" }],
                        "label-lg": ["14px", { "lineHeight": "20px", "letterSpacing": "0.01em", "fontWeight": "600" }],
                        "body-sm": ["12px", { "lineHeight": "16px", "fontWeight": "400" }],
                        "headline-lg": ["24px", { "lineHeight": "32px", "letterSpacing": "-0.01em", "fontWeight": "700" }],
                        "label-sm": ["10px", { "lineHeight": "14px", "letterSpacing": "0.05em", "fontWeight": "700" }],
                        "body-md": ["14px", { "lineHeight": "20px", "fontWeight": "400" }],
                        "display-hero": ["56px", { "lineHeight": "64px", "letterSpacing": "-0.03em", "fontWeight": "800" }]
                    }
                }
            }
        };
    </script>
</head>
<body class="bg-bg-primary text-text-primary min-h-screen selection:bg-primary-container selection:text-text-primary">
    <!-- Header -->
    <header class="fixed top-0 left-0 right-0 w-full z-50 bg-bg-primary/90 backdrop-blur-xl border-b border-border-subtle">
        <div class="h-20 max-w-7xl mx-auto px-gutter flex items-center justify-between">
            <div class="flex items-center gap-4">
                <a asp-controller="Home" asp-action="Index" class="flex items-center gap-3">
                    <img alt="PrivateGym Luxury Logo" class="h-8 w-auto object-contain" src="~/images/logo.png" onerror="this.src='https://lh3.googleusercontent.com/aida/AEtjO1UOo-h5V8djqcda1bWBeaIEksv_Be4tM6qETYpvBbZzN2ECwF3ZLeEzPILh1ZJhSKWaZY9GQQz0k94_TSUR_vtEIS5hsC_UF4iRFWE3HPaoqLlUuOcrJujmSwTEojg5afSoyneAvI_IiZzRZqQluGe1rr_3_s6n1VSPjOImxZqm5viZbf51jCUONwDsL1B7qVRHQ4JkzN_QViD5WNYp-b0vULXKUg-Hjq4scVI5Y9_EYqHhM8hbjC1uT9Q1'" />
                </a>
            </div>
            <nav class="hidden lg:flex items-center gap-8">
                <a asp-controller="Home" asp-action="Index" class="transition-colors text-text-secondary hover:text-text-primary font-label-lg text-label-lg">หน้าแรก</a>
                <a class="text-text-secondary hover:text-text-primary font-label-lg text-label-lg transition-colors" href="#">แพ็กเกจ</a>
                <a class="text-text-secondary hover:text-text-primary font-label-lg text-label-lg transition-colors" href="#">โปรโมชั่น</a>
                <a class="text-text-secondary hover:text-text-primary font-label-lg text-label-lg transition-colors" href="#">จองบริการ</a>
                <a class="text-text-secondary hover:text-text-primary font-label-lg text-label-lg transition-colors" href="#">เกี่ยวกับเรา</a>
            </nav>
            <div class="flex items-center gap-4">
                <a asp-controller="Login" asp-action="Index" class="text-text-secondary hover:text-text-primary font-label-lg text-label-lg transition-colors px-space-sm py-2">เข้าสู่ระบบ</a>
                <a asp-controller="Register" asp-action="Index" class="bg-primary-container text-text-primary font-label-lg text-label-lg px-space-md py-2.5 rounded-lg shadow-[0_0_15px_rgba(232,0,13,0.15)] hover:shadow-[0_0_20px_rgba(232,0,13,0.3)] hover:-translate-y-0.5 transition-all duration-150 flex items-center justify-center font-semibold">สมัครสมาชิก</a>
                <div class="w-8 h-8 rounded-full bg-primary flex items-center justify-center ml-1">
                    <span class="material-symbols-outlined text-on-primary text-[18px]">person</span>
                </div>
            </div>
        </div>
    </header>

    <!-- Main Content -->
    <main class="w-full pt-20 bg-bg-primary min-h-screen">
        @RenderBody()
    </main>

    <!-- Footer -->
    <footer class="w-full bg-bg-sidebar border-t border-border-subtle">
        <div class="max-w-7xl mx-auto px-gutter pt-space-xl pb-space-lg">
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-gutter lg:gap-space-xl mb-space-xl">
                <div class="flex flex-col gap-space-md">
                    <div class="flex items-center gap-3">
                        <img alt="PrivateGym Logo" class="h-7 w-auto object-contain" src="~/images/logo.png" onerror="this.src='https://lh3.googleusercontent.com/aida/AEtjO1UOo-h5V8djqcda1bWBeaIEksv_Be4tM6qETYpvBbZzN2ECwF3ZLeEzPILh1ZJhSKWaZY9GQQz0k94_TSUR_vtEIS5hsC_UF4iRFWE3HPaoqLlUuOcrJujmSwTEojg5afSoyneAvI_IiZzRZqQluGe1rr_3_s6n1VSPjOImxZqm5viZbf51jCUONwDsL1B7qVRHQ4JkzN_QViD5WNYp-b0vULXKUg-Hjq4scVI5Y9_EYqHhM8hbjC1uT9Q1'" />
                    </div>
                    <p class="font-body-md text-body-md text-text-muted leading-relaxed">
                        นิยามใหม่ของการออกกำลังกายระดับพรีเมียม พื้นที่ส่วนตัว อุปกรณ์มาตรฐานสากล พร้อมการดูแลอย่างเหนือระดับเพื่อสมรรถนะสูงสุดของคุณ
                    </p>
                    <div class="flex items-center gap-3 mt-space-xs">
                        <div class="w-9 h-9 rounded-lg bg-bg-surface-2 border border-border-subtle flex items-center justify-center text-text-secondary hover:text-text-primary hover:border-primary-container transition-all cursor-pointer">
                            <span class="material-symbols-outlined text-[20px]">share</span>
                        </div>
                        <div class="w-9 h-9 rounded-lg bg-bg-surface-2 border border-border-subtle flex items-center justify-center text-text-secondary hover:text-text-primary hover:border-primary-container transition-all cursor-pointer">
                            <span class="material-symbols-outlined text-[20px]">fitness_center</span>
                        </div>
                        <div class="w-9 h-9 rounded-lg bg-bg-surface-2 border border-border-subtle flex items-center justify-center text-text-secondary hover:text-text-primary hover:border-primary-container transition-all cursor-pointer">
                            <span class="material-symbols-outlined text-[20px]">schedule</span>
                        </div>
                    </div>
                </div>

                <div class="flex flex-col gap-space-sm">
                    <h4 class="font-label-lg text-label-lg text-text-primary uppercase tracking-wider font-semibold mb-space-xs">เมนูลัด</h4>
                    <ul class="flex flex-col gap-2.5">
                        <li class="font-body-md text-body-md"><a class="text-text-muted hover:text-text-primary transition-colors" asp-controller="Home" asp-action="Index">หน้าแรก</a></li>
                        <li class="font-body-md text-body-md"><a class="text-text-muted hover:text-text-primary transition-colors" href="#">แพ็กเกจสมาชิก</a></li>
                        <li class="font-body-md text-body-md"><a class="text-text-muted hover:text-text-primary transition-colors" href="#">โปรโมชั่นพิเศษ</a></li>
                        <li class="font-body-md text-body-md"><a class="text-text-muted hover:text-text-primary transition-colors" href="#">จองเทรนเนอร์ส่วนตัว</a></li>
                        <li class="font-body-md text-body-md"><a class="text-text-muted hover:text-text-primary transition-colors" href="#">ประวัติและความเป็นมา</a></li>
                    </ul>
                </div>

                <div class="flex flex-col gap-space-sm">
                    <h4 class="font-label-lg text-label-lg text-text-primary uppercase tracking-wider font-semibold mb-space-xs">บริการและการติดต่อ</h4>
                    <div class="flex flex-col gap-3 font-body-md text-body-md text-text-muted">
                        <div class="flex items-start gap-2.5">
                            <span class="material-symbols-outlined text-primary-container text-[20px] shrink-0 mt-0.5">location_on</span>
                            <span>123 อาคารสปอร์ตคอมเพล็กซ์ ชั้น Penthouse ถนนสุขุมวิท กรุงเทพฯ 10110</span>
                        </div>
                        <div class="flex items-center gap-2.5">
                            <span class="material-symbols-outlined text-primary-container text-[20px] shrink-0">call</span>
                            <span>02-888-9999, 089-999-8888</span>
                        </div>
                        <div class="flex items-center gap-2.5">
                            <span class="material-symbols-outlined text-primary-container text-[20px] shrink-0">mail</span>
                            <span>concierge@privategym.club</span>
                        </div>
                        <div class="flex items-center gap-2.5">
                            <span class="material-symbols-outlined text-primary-container text-[20px] shrink-0">alarm</span>
                            <span>เปิดให้บริการทุกวัน 06:00 - 23:00 น.</span>
                        </div>
                    </div>
                </div>

                <div class="flex flex-col gap-space-md">
                    <h4 class="font-label-lg text-label-lg text-text-primary uppercase tracking-wider font-semibold">รับข่าวสารและสิทธิพิเศษ</h4>
                    <p class="font-body-sm text-body-sm text-text-muted">ลงทะเบียนเพื่อรับข้อมูลเทรนด์สุขภาพและข้อเสนอพิเศษเฉพาะสมาชิกระดับ Exclusive</p>
                    <div class="flex flex-col gap-2">
                        <div class="flex items-center rounded-lg bg-bg-surface-2 border border-border-subtle p-1 focus-within:border-primary-container transition-all">
                            <input class="bg-transparent px-space-sm py-2 font-body-md text-body-md text-text-primary placeholder:text-text-muted focus:outline-none w-full" placeholder="กรอกอีเมลของคุณ" type="email" />
                            <button class="bg-primary-container text-text-primary px-4 py-2 rounded font-label-md text-label-md font-semibold hover:shadow-[0_0_15px_rgba(232,0,13,0.15)] transition-all shrink-0" type="button">ยืนยัน</button>
                        </div>
                    </div>
                    <div class="mt-1 h-24 w-full rounded-lg bg-bg-surface-2 border border-border-subtle flex items-center justify-center relative overflow-hidden group cursor-pointer">
                        <div class="absolute inset-0 bg-surface-container-high/40 flex items-center justify-center gap-2 text-text-secondary group-hover:text-text-primary transition-colors">
                            <span class="material-symbols-outlined text-primary-container">map</span>
                            <span class="font-label-md text-label-md">เปิดแผนที่ PrivateGym Flagship</span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="pt-space-md border-t border-border-subtle/60 flex flex-col md:flex-row items-center justify-between gap-4 font-body-sm text-body-sm text-text-muted">
                <p>© 2025 PrivateGym Luxury Fitness Club. สงวนลิขสิทธิ์ทุกประการ.</p>
                <div class="flex items-center gap-6">
                    <a class="hover:text-text-primary transition-colors" href="#">นโยบายความเป็นส่วนตัว</a>
                    <a class="hover:text-text-primary transition-colors" href="#">เงื่อนไขการให้บริการ</a>
                    <a class="hover:text-text-primary transition-colors" href="#">ระบบความปลอดภัย</a>
                </div>
            </div>
        </div>
    </footer>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
