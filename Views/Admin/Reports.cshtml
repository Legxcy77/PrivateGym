@using PrivateGym.Models
@{
    ViewData["Title"] = "รายงานและการวิเคราะห์ธุรกิจ (Executive Reports)";
    Layout = "~/Views/Shared/Admin/_AdminLayout.cshtml";

    var branches = ViewBag.Branches as List<Branch> ?? new List<Branch>();
    var packages = ViewBag.Packages as List<Package> ?? new List<Package>();
    var trainers = ViewBag.Trainers as List<Trainer> ?? new List<Trainer>();

    decimal totalRev = ViewBag.TotalRevenue is decimal tr ? tr : 0m;
    int totalMembers = ViewBag.TotalMembers ?? 0;
    int totalBookings = ViewBag.TotalBookings ?? 0;
    int completedBookings = ViewBag.CompletedBookings ?? 0;
    int totalTrainers = ViewBag.TotalTrainers ?? 0;
    decimal arpu = totalMembers > 0 ? Math.Round(totalRev / totalMembers, 0) : 0m;
}

<div class="adm-page">
    <div class="adm-page-head">
        <div>
            <h1 class="adm-page-title">รายงานและการวิเคราะห์ธุรกิจ (Executive Reports)</h1>
            <p class="adm-page-sub">สรุปโครงสร้างรายได้ตามแพ็กเกจ สถิติการใช้งานห้องซ้อมแต่ละสาขา และประสิทธิภาพการสอนของเทรนเนอร์จากฐานข้อมูลจริง</p>
        </div>
        <a asp-controller="Admin" asp-action="ExportDashboardCsv" class="st-btn-primary">ส่งออกรายงาน CSV</a>
    </div>

    <div class="adm-kpi-4">
        <div class="adm-stat-card">
            <div class="adm-stat-lbl">TOTAL REVENUE (รายรับรวม)</div>
            <div class="adm-stat-val" style="color:#10b981;">฿@totalRev.ToString("N0")</div>
            <div class="adm-stat-sub">ยอดชำระสำเร็จทั้งหมด</div>
        </div>
        <div class="adm-stat-card">
            <div class="adm-stat-lbl">REGISTERED MEMBERS</div>
            <div class="adm-stat-val">@totalMembers <span style="font-size:13px; color:#71717a; font-weight:400;">ท่าน</span></div>
            <div class="adm-stat-sub">สมาชิก Role Member ทั้งหมด</div>
        </div>
        <div class="adm-stat-card">
            <div class="adm-stat-lbl">BOOKINGS &amp; COMPLETED</div>
            <div class="adm-stat-val">@completedBookings <span style="font-size:14px; color:#71717a; font-weight:400;">/ @totalBookings รอบ</span></div>
            <div class="adm-stat-sub">เข้าใช้งานสำเร็จ / จองทั้งหมด</div>
        </div>
        <div class="adm-stat-card">
            <div class="adm-stat-lbl">ARPU / MEMBER</div>
            <div class="adm-stat-val">฿@arpu.ToString("N0")</div>
            <div class="adm-stat-sub">รายได้เฉลี่ยต่อสมาชิก • โค้ช @totalTrainers ท่าน</div>
        </div>
    </div>

    <div class="row g-3 mb-4">
        <!-- 1. Revenue by Package -->
        <div class="col-lg-6">
            <div class="st-table-card h-100">
                <div style="padding:14px 18px; border-bottom:1px solid #27272a; background:#0c0c0f;">
                    <h2 style="font-size:14px; font-weight:600; color:#fafafa; margin:0;">โครงสร้างรายได้แยกตามแพ็กเกจ (Revenue by Package)</h2>
                </div>
                <table class="st-shadcn-table">
                    <thead>
                        <tr>
                            <th>แพ็กเกจ</th>
                            <th>ราคา</th>
                            <th>ผู้ถือสัญญา Active</th>
                            <th style="text-align:right;">ยอดรับรวม</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var pkg in packages)
                        {
                            int activeHolders = pkg.MemberSubscriptions?.Count(s => s.Status == "Active") ?? 0;
                            decimal pkgRev = pkg.Payments?.Where(p => p.Status == "Success").Sum(p => p.Amount) ?? 0m;
                            <tr>
                                <td style="font-weight:600; color:#fafafa;">@pkg.PackageName</td>
                                <td>฿@pkg.Price.ToString("N0")</td>
                                <td><span class="st-badge st-badge-blue">@activeHolders คน</span></td>
                                <td style="text-align:right; font-weight:700; color:#10b981;">฿@pkgRev.ToString("N0")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- 2. Branch & Pod Utilization -->
        <div class="col-lg-6">
            <div class="st-table-card h-100">
                <div style="padding:14px 18px; border-bottom:1px solid #27272a; background:#0c0c0f;">
                    <h2 style="font-size:14px; font-weight:600; color:#fafafa; margin:0;">สถิติห้องซ้อมและการจองแยกตามสาขา (Branch Performance)</h2>
                </div>
                <table class="st-shadcn-table">
                    <thead>
                        <tr>
                            <th>สาขา</th>
                            <th>จำนวนห้อง Pod</th>
                            <th>พร้อมใช้งาน</th>
                            <th style="text-align:right;">ยอดจองสะสม</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var br in branches)
                        {
                            int podCnt = br.Pods?.Count ?? 0;
                            int availCnt = br.Pods?.Count(p => p.Status == "Available") ?? 0;
                            int bookCnt = br.Pods?.Sum(p => p.Bookings?.Count(b => b.Status != "Cancelled") ?? 0) ?? 0;
                            <tr>
                                <td>
                                    <div style="font-weight:600; color:#fafafa;">@br.BranchName</div>
                                    <div style="font-size:11.5px; color:#71717a;">@br.Location</div>
                                </td>
                                <td>@podCnt ห้อง</td>
                                <td><span class="st-badge st-badge-green">@availCnt ห้อง</span></td>
                                <td style="text-align:right; font-weight:600; color:#fafafa;">@bookCnt รอบ</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- 3. Coaching Efficiency Table -->
    <div class="st-table-card">
        <div style="padding:14px 18px; border-bottom:1px solid #27272a; background:#0c0c0f;">
            <h2 style="font-size:14px; font-weight:600; color:#fafafa; margin:0;">สถิติการสอนและผลตอบแทนของเทรนเนอร์ประจำการ (Coaching Efficiency)</h2>
        </div>
        <table class="st-shadcn-table">
            <thead>
                <tr>
                    <th>เทรนเนอร์ (COACH NAME)</th>
                    <th>สาขาประจำ</th>
                    <th>ความเชี่ยวชาญ (SPECIALTY)</th>
                    <th>ลูกค้าที่ดูแล</th>
                    <th>สอนสำเร็จ (COMPLETED)</th>
                    <th style="text-align:right;">ค่าตอบแทนสะสม (GROSS THB)</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var t in trainers)
                {
                    int clients = t.Bookings?.Select(b => b.UserId).Distinct().Count() ?? 0;
                    int done = t.Bookings?.Count(b => b.Status == "Completed") ?? 0;
                    decimal gross = done * (t.HourlyRate ?? 1500m);
                    <tr>
                        <td style="font-weight:600; color:#fafafa;">@(t.User?.FullName ?? "-")</td>
                        <td>@(t.User?.HomeBranch?.BranchName ?? "-")</td>
                        <td>@(t.Specialty ?? "Strength & Conditioning")</td>
                        <td>@clients คน</td>
                        <td><span class="st-badge st-badge-green">@done เซสชัน</span></td>
                        <td style="text-align:right; font-weight:700; color:#fafafa;">฿@gross.ToString("N0")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- 4. Hourly Demand Heatmap (Computed from real Bookings) -->
    @{
        var hourlyDemand = ViewBag.HourlyDemand as List<Dictionary<string, object>> ?? new List<Dictionary<string, object>>();
    }
    <div class="st-table-card mt-4" style="padding:18px 20px;">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
            <div>
                <div style="font-size:11px; font-weight:700; color:#ef4444; letter-spacing:0.05em;">HOURLY DEMAND HEATMAP</div>
                <h2 style="font-size:15px; font-weight:600; color:#fafafa; margin:2px 0 0 0;">ความหนาแน่นการจองห้อง Pod แยกตามช่วงเวลา (จากข้อมูลจริง)</h2>
            </div>
            <span class="st-badge st-badge-blue">SLOT OCCUPANCY</span>
        </div>
        <div class="row g-2">
            @foreach (var hd in hourlyDemand)
            {
                string label = hd.GetValueOrDefault("Label")?.ToString() ?? "-";
                int cnt = Convert.ToInt32(hd.GetValueOrDefault("Count") ?? 0);
                int pct = Convert.ToInt32(hd.GetValueOrDefault("Pct") ?? 0);
                bool isPeak = pct >= 75 && cnt > 0;
                <div class="col-6 col-md-3 col-lg">
                    <div style="background:#111114; border:1px solid @(isPeak ? "rgba(229, 9, 20, 0.5)" : "#27272a"); border-radius:10px; padding:12px;">
                        <div style="font-size:11px; color:#a1a1aa;">@label</div>
                        <div style="font-size:20px; font-weight:700; color:@(isPeak ? "#ef4444" : "#fafafa"); margin:4px 0;">@pct%</div>
                        <div style="height:4px; background:#18181b; border-radius:99px; overflow:hidden;">
                            <div style="height:100%; width:@pct%; background:@(isPeak ? "#e50914" : "#3b82f6");"></div>
                        </div>
                        <div style="font-size:10.5px; color:#71717a; margin-top:6px;">@cnt รอบจอง</div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>
