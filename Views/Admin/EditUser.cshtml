@using PrivateGym.Models
@model PrivateGym.Models.User
@{
    ViewData["Title"] = "แก้ไขข้อมูลสมาชิก";
    Layout = "~/Views/Shared/Admin/_AdminLayout.cshtml";
    var branches = ViewBag.Branches as List<Branch> ?? new List<Branch>();
    var roles = ViewBag.Roles as List<Role> ?? new List<Role>();
    char initialChar = !string.IsNullOrWhiteSpace(Model.FullName) ? Model.FullName.TrimStart("คุณ".ToCharArray()).Trim().FirstOrDefault() : 'U';
}

<style>
    .ep-label {
        font-size: 12px !important;
        font-weight: 500;
        color: #a1a1aa !important;
        margin-bottom: 6px;
        display: block;
    }
    .ep-input {
        min-height: 38px;
        background: #09090b !important;
        border: 1px solid #27272a !important;
        border-radius: 8px !important;
        padding: 8px 12px !important;
        color: #fafafa !important;
        font-size: 13px !important;
    }
    .ep-input:focus {
        border-color: #e50914 !important;
        box-shadow: 0 0 0 2px rgba(229, 9, 20, 0.16) !important;
        outline: none;
    }
    .ep-input-readonly {
        min-height: 38px;
        background: #111114 !important;
        border: 1px solid #18181b !important;
        border-radius: 8px !important;
        padding: 8px 12px !important;
        color: #71717a !important;
        cursor: not-allowed !important;
        font-size: 13px !important;
    }
</style>

<div class="adm-page">
    <div class="adm-page-head">
        <div>
            <h1 class="adm-page-title">แก้ไขข้อมูลสมาชิก (Edit Profile)</h1>
            <p class="adm-page-sub">
                จัดการข้อมูลโปรไฟล์ ความปลอดภัย และเป้าหมายการฝึกซ้อม (MEMBER ID: #@Model.UserId.ToString("D5"))
            </p>
        </div>

        <a asp-controller="Admin" asp-action="UserList" class="st-btn-outline">
            &larr; กลับรายการสมาชิก
        </a>
    </div>

    @if (!string.IsNullOrEmpty(ViewBag.Error))
    {
        <div class="alert alert-danger alert-dismissible fade show border-0 d-flex align-items-center justify-content-between mb-4" 
             style="background: rgba(239, 68, 68, 0.15); border: 1px solid rgba(239, 68, 68, 0.35) !important; color: #fca5a5; border-radius: 12px; padding: 14px 20px;" role="alert">
            <div class="d-flex align-items-center gap-2">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>
                <span class="fw-semibold">@ViewBag.Error</span>
            </div>
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="row g-4">
        <!-- Main Form Column (Order 2 on mobile: appears after summary card) -->
        <div class="col-lg-8 order-2 order-lg-1">
            <div class="p-4" style="background: rgba(18, 18, 22, 0.7); backdrop-filter: blur(12px); border: 1px solid rgba(255,255,255,0.08); border-radius: 16px;">
                <form asp-controller="Admin" asp-action="EditUser" method="post">
                    <input type="hidden" name="userId" value="@Model.UserId" />

                    <!-- หมวดที่ 1: ข้อมูลบัญชีและความปลอดภัย -->
                    <div class="mb-4">
                        <div class="d-flex align-items-center gap-2 mb-3 pb-2 border-bottom border-secondary border-opacity-25">
                            <h5 class="fw-bold text-white mb-0" style="font-size: 16px;">ข้อมูลบัญชีและความปลอดภัย (Account & Security)</h5>
                        </div>

                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="ep-label">ชื่อ - นามสกุล <span class="text-danger">*</span></label>
                                <input type="text" name="fullName" value="@Model.FullName" class="form-control ep-input" required />
                            </div>

                            <div class="col-md-6">
                                <label class="ep-label">อีเมล (บัญชีล็อกอิน) <span class="text-danger">*</span></label>
                                <input type="email" name="email" value="@Model.Email" class="form-control ep-input" required />
                            </div>

                            <div class="col-md-6">
                                <label class="ep-label">หมายเลขโทรศัพท์ <span class="text-danger">*</span></label>
                                <input type="tel" name="phone" value="@Model.Phone" class="form-control ep-input" maxlength="10" required />
                            </div>

                            <div class="col-md-6">
                                <label class="ep-label">เปลี่ยนรหัสผ่านใหม่ (ว่างไว้ = ใช้รหัสเดิม)</label>
                                <input type="password" name="password" class="form-control ep-input" placeholder="กรอกรหัสผ่านใหม่ที่นี่" />
                            </div>

                            <div class="col-md-6">
                                <label class="ep-label">บทบาทผู้ใช้งาน (Role)</label>
                                <select name="role" class="form-select ep-input">
                                    @foreach (var r in roles)
                                    {
                                        <option value="@r.RoleName" selected="@(Model.RoleId == r.RoleId)">@r.RoleName</option>
                                    }
                                </select>
                            </div>
                        </div>
                    </div>

                    <!-- หมวดที่ 2: สรีระและเป้าหมายการฝึกซ้อม -->
                    <div class="mb-4">
                        <div class="d-flex align-items-center gap-2 mb-3 pb-2 border-bottom border-secondary border-opacity-25">
                            <h5 class="fw-bold text-white mb-0" style="font-size: 16px;">สรีระและเป้าหมายการฝึกซ้อม (Body & Goals)</h5>
                        </div>

                        <div class="row g-3">
                            <div class="col-md-4">
                                <label class="ep-label">เพศ (Gender)</label>
                                <select name="gender" class="form-select ep-input">
                                    <option value="" selected="@(string.IsNullOrEmpty(Model.Gender))">ไม่ระบุ</option>
                                    <option value="Male" selected="@(Model.Gender == "Male")">ชาย (Male)</option>
                                    <option value="Female" selected="@(Model.Gender == "Female")">หญิง (Female)</option>
                                    <option value="Other" selected="@(Model.Gender == "Other")">อื่นๆ (Other)</option>
                                </select>
                            </div>

                            <div class="col-md-4">
                                <label class="ep-label">ส่วนสูง (ซม.)</label>
                                <input type="number" step="0.1" name="height" value="@Model.Height" class="form-control ep-input" placeholder="เช่น 181.00" />
                            </div>

                            <div class="col-md-4">
                                <label class="ep-label">น้ำหนัก (กก.)</label>
                                <input type="number" step="0.1" name="weight" value="@Model.Weight" class="form-control ep-input" placeholder="เช่น 72.00" />
                            </div>

                            <div class="col-md-6">
                                <label class="ep-label">ระดับประสบการณ์ (Experience)</label>
                                <select name="experienceLevel" class="form-select ep-input">
                                    <option value="Beginner" selected="@(Model.ExperienceLevel == "Beginner")">เริ่มต้น (Beginner &bull; 0 - 6 เดือน)</option>
                                    <option value="Intermediate" selected="@(Model.ExperienceLevel == "Intermediate")">ปานกลาง (Intermediate &bull; 6 เดือน - 2 ปี)</option>
                                    <option value="Advanced" selected="@(Model.ExperienceLevel == "Advanced")">เชี่ยวชาญ (Advanced &bull; 2 ปีขึ้นไป)</option>
                                    <option value="Athlete" selected="@(Model.ExperienceLevel == "Athlete")">นักกีฬาแข่งขัน (Competitive Athlete)</option>
                                </select>
                            </div>

                            <div class="col-md-6">
                                <label class="ep-label">เป้าหมายการออกกำลังกาย (Fitness Goal)</label>
                                <select name="fitnessGoal" class="form-select ep-input">
                                    <option value="สร้างกล้ามเนื้อ" selected="@(Model.FitnessGoal == "สร้างกล้ามเนื้อ" || Model.FitnessGoal?.Contains("Hypertrophy") == true)">สร้างกล้ามเนื้อ (Hypertrophy / Muscle Building)</option>
                                    <option value="ลดไขมัน" selected="@(Model.FitnessGoal == "ลดไขมัน" || Model.FitnessGoal?.Contains("Fat Loss") == true)">ลดไขมันกระชับสัดส่วน (Fat Loss & Toning)</option>
                                    <option value="เพิ่มความแข็งแรง" selected="@(Model.FitnessGoal == "เพิ่มความแข็งแรง" || Model.FitnessGoal?.Contains("Strength") == true)">เพิ่มความแข็งแรง (Strength & Powerlifting)</option>
                                    <option value="สุขภาพทั่วไป" selected="@(Model.FitnessGoal == "สุขภาพทั่วไป" || Model.FitnessGoal?.Contains("Cardio") == true)">สุขภาพและสมรรถภาพทั่วไป (Cardio & Longevity)</option>
                                    <option value="ฟื้นฟูกายภาพ" selected="@(Model.FitnessGoal == "ฟื้นฟูกายภาพ" || Model.FitnessGoal?.Contains("Rehab") == true)">ฟื้นฟูกายภาพ (Rehab & Mobility)</option>
                                </select>
                            </div>
                        </div>
                    </div>

                    <!-- หมวดที่ 3: คลับสาขาหลักและข้อมูลออกบิล -->
                    <div class="mb-4">
                        <div class="d-flex align-items-center gap-2 mb-3 pb-2 border-bottom border-secondary border-opacity-25">
                            <h5 class="fw-bold text-white mb-0" style="font-size: 16px;">สาขาหลักและข้อมูลที่อยู่ (Home Club & Billing)</h5>
                        </div>

                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="ep-label">คลับสาขาหลัก (Home Club)</label>
                                <select name="homeBranchId" class="form-select ep-input">
                                    @foreach (var b in branches)
                                    {
                                        <option value="@b.BranchId" selected="@(Model.HomeBranchId == b.BranchId)">@b.BranchName (@b.Location)</option>
                                    }
                                </select>
                            </div>

                            <div class="col-md-6">
                                <label class="ep-label">เลขประจำตัวผู้เสียภาษี (Tax ID - ถ้ามี)</label>
                                <input type="text" name="taxId" value="@Model.TaxId" class="form-control ep-input" placeholder="13 หลักสำหรับออกใบกำกับภาษี" />
                            </div>

                            <div class="col-12">
                                <label class="ep-label">ที่อยู่ในการออกใบเสร็จ (Billing Address)</label>
                                <textarea name="billingAddress" rows="2" class="form-control ep-input" placeholder="ที่อยู่สำหรับออกเอกสารใบเสร็จรับเงิน">@Model.BillingAddress</textarea>
                            </div>
                        </div>
                    </div>

                    <!-- Action Buttons -->
                    <div class="d-flex flex-wrap align-items-center gap-2 pt-3" style="border-top: 1px solid #18181b;">
                        <button type="submit" class="st-btn-primary">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
                            <span>บันทึกการแก้ไขโปรไฟล์</span>
                        </button>
                        <a asp-controller="Admin" asp-action="UserList" class="st-btn-outline">
                            ยกเลิก
                        </a>
                    </div>
                </form>
            </div>
        </div>

        <!-- Sidebar Summary Card Column -->
        <div class="col-lg-4 order-1 order-lg-2">
            <div class="st-table-card" style="padding: 20px;">
                <div class="text-center mb-4">
                    <div style="width: 72px; height: 72px; border-radius: 50%; background: linear-gradient(135deg, #e11d48, #9f1239); color: #fff; font-size: 26px; font-weight: 700; display: inline-flex; align-items: center; justify-content: center; box-shadow: 0 0 20px rgba(225, 29, 72, 0.4); margin-bottom: 12px;">
                        @initialChar
                    </div>
                    <h5 class="fw-bold text-white mb-1">@Model.FullName</h5>
                    <div style="color: #94a3b8; font-size: 13px;">@Model.Email</div>
                    <div class="mt-2">
                        <span class="badge" style="background: rgba(34, 197, 94, 0.15); color: #86efac; border: 1px solid rgba(34, 197, 94, 0.35); padding: 5px 12px; border-radius: 20px; font-weight: 600;">
                            STATUS: @(Model.Status ?? "Active")
                        </span>
                    </div>
                </div>

                <div class="border-top border-secondary border-opacity-25 pt-3">
                    <div class="d-flex justify-content-between py-2 small border-bottom border-secondary border-opacity-20">
                        <span style="color: #999999; font-size: 13px; font-weight: 500;">รหัสสมาชิก:</span>
                        <strong class="text-white" style="font-size: 13px;">#@Model.UserId.ToString("D5")</strong>
                    </div>
                    <div class="d-flex justify-content-between py-2 small border-bottom border-secondary border-opacity-20">
                        <span style="color: #999999; font-size: 13px; font-weight: 500;">สาขาหลัก:</span>
                        <strong class="text-white" style="font-size: 13px;">@(Model.HomeBranch?.BranchName ?? "สาขาทองหล่อ")</strong>
                    </div>
                    <div class="d-flex justify-content-between py-2 small border-bottom border-secondary border-opacity-20">
                        <span style="color: #999999; font-size: 13px; font-weight: 500;">เบอร์ติดต่อ:</span>
                        <strong class="text-white" style="font-size: 13px;">@Model.Phone</strong>
                    </div>
                    <div class="d-flex justify-content-between py-2 small border-bottom border-secondary border-opacity-20">
                        <span style="color: #999999; font-size: 13px; font-weight: 500;">วันที่ลงทะเบียน:</span>
                        <strong class="text-white" style="font-size: 13px;">@(Model.CreatedAt?.ToString("dd/MM/yyyy") ?? "-")</strong>
                    </div>
                </div>

                <div class="mt-4 p-3 rounded-3" style="background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.12); font-size: 13px; line-height: 1.6; color: #cbd5e1;">
                    <strong style="color: #ffffff; display: block; margin-bottom: 6px; font-size: 13.5px;">คำแนะนำด้านความปลอดภัย:</strong>
                    การเปลี่ยนข้อมูลสรีระและเป้าหมายจะช่วยให้เทรนเนอร์ส่วนตัวสามารถออกแบบโปรแกรมการฝึกซ้อมที่เหมาะสมกับคุณได้อย่างมีประสิทธิภาพสูงสุด
                </div>
            </div>

            <!-- Emergency Manual Quota Adjustment (Audit Logged) -->
            <div class="st-table-card mt-3" style="padding: 20px;">
                <div style="font-size:13.5px; font-weight:600; color:#fafafa;">ปรับแก้โควต้ากรณีพิเศษ (Quota Adjustment)</div>
                <div style="font-size:11.5px; color:#71717a; margin-bottom:12px;">ใช้เฉพาะกรณีชดเชยระบบขัดข้องหรือตรวจสอบสลิปตกหล่น (บังคับระบุเหตุผล)</div>
                <form asp-controller="Admin" asp-action="AdjustMemberQuota" method="post" class="d-flex flex-column gap-2"
                      data-confirm-title="ยืนยันปรับแก้โควต้ากรณีพิเศษ"
                      data-confirm="ยืนยันบันทึกการปรับแก้โควต้าของ @Model.FullName หรือไม่? ระบบจะบันทึกเหตุผลลง Audit Log ทันที">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="userId" value="@Model.UserId" />
                    <div class="row g-2">
                        <div class="col-4">
                            <label class="ep-label">Pod (+ / -)</label>
                            <input type="number" name="addPods" value="0" class="st-input w-100" />
                        </div>
                        <div class="col-4">
                            <label class="ep-label">PT (+ / -)</label>
                            <input type="number" name="addPt" value="0" class="st-input w-100" />
                        </div>
                        <div class="col-4">
                            <label class="ep-label">InBody (+ / -)</label>
                            <input type="number" name="addInBody" value="0" class="st-input w-100" />
                        </div>
                    </div>
                    <div>
                        <label class="ep-label">เหตุผลการปรับแก้ <span class="text-danger">*</span></label>
                        <input type="text" name="reason" class="st-input w-100" required placeholder="เช่น ชดเชยระบบห้อง Pod ขัดข้อง" />
                    </div>
                    <button type="submit" class="st-btn-outline w-100 mt-1" style="color:#f59e0b;">บันทึกปรับแก้โควต้า</button>
                </form>
            </div>
        </div>
    </div>

</div>
