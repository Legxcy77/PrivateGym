@model List<PrivateGym.Models.Branch>
@using PrivateGym.Models
@{
    ViewData["Title"] = "ตั้งค่าระบบและสาขา (System & Branch Settings)";
    Layout = "~/Views/Shared/Admin/_AdminLayout.cshtml";

    var branches = Model ?? new List<Branch>();
}

<div class="adm-page">
    <div class="adm-page-head">
        <div>
            <h1 class="adm-page-title">ตั้งค่าระบบและจัดการสาขา (System &amp; Branch Settings)</h1>
            <p class="adm-page-sub">จัดการข้อมูลสาขาของ PrivateGym (ซิงค์กับหน้าจองสมาชิกและหน้า Staff ทันที) และตรวจสอบข้อกำหนดเวลาทำการ</p>
        </div>
        <button type="button" class="st-btn-primary" onclick="document.getElementById('newBranchBox').classList.toggle('d-none')">
            + เพิ่มสาขาใหม่
        </button>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success" style="background: rgba(16, 185, 129, 0.14); border: 1px solid rgba(16, 185, 129, 0.35); color: #fafafa; border-radius: 10px; padding: 12px 16px; margin-bottom: 16px; font-size: 13px;">
            @TempData["SuccessMessage"]
        </div>
    }

    <!-- Add Branch Box -->
    <div id="newBranchBox" class="st-table-card d-none mb-4" style="padding:18px 20px;">
        <h3 style="font-size:14px; font-weight:600; color:#fafafa; margin:0 0 12px 0;">เพิ่มสาขาใหม่เข้าสู่ระบบ</h3>
        <form asp-controller="Admin" asp-action="AddBranch" method="post" class="row g-2 align-items-end">
            @Html.AntiForgeryToken()
            <div class="col-md-4">
                <label style="font-size:11.5px; color:#a1a1aa;">ชื่อสาขา</label>
                <input type="text" name="branchName" class="st-input w-100" placeholder="เช่น สาขาชิดลม" required />
            </div>
            <div class="col-md-5">
                <label style="font-size:11.5px; color:#a1a1aa;">ที่ตั้ง / อาคาร</label>
                <input type="text" name="location" class="st-input w-100" placeholder="เช่น ชั้น 4 อาคาร Mercury Ville ชิดลม" required />
            </div>
            <div class="col-md-3">
                <button type="submit" class="st-btn-primary w-100">บันทึกสาขาใหม่</button>
            </div>
        </form>
    </div>

    <!-- Operating Rules Summary -->
    <div class="adm-kpi-4">
        <div class="adm-stat-card">
            <div class="adm-stat-lbl">เวลาเปิด-ปิดคลับมาตรฐาน</div>
            <div class="adm-stat-val" style="font-size:20px;">08:00 - 20:45 น.</div>
            <div class="adm-stat-sub">แบ่งเป็น 6 สล็อตมาตรฐานต่อวัน</div>
        </div>
        <div class="adm-stat-card">
            <div class="adm-stat-lbl">ความยาวต่อเซสชัน</div>
            <div class="adm-stat-val" style="font-size:20px;">75 นาที</div>
            <div class="adm-stat-sub">พักทำความสะอาด 15 นาที</div>
        </div>
        <div class="adm-stat-card">
            <div class="adm-stat-lbl">เปิดรับจองล่วงหน้า</div>
            <div class="adm-stat-val" style="font-size:20px;">14 วัน</div>
            <div class="adm-stat-sub">ซิงค์ตารางโค้ชอัตโนมัติ</div>
        </div>
        <div class="adm-stat-card">
            <div class="adm-stat-lbl">สาขาที่เปิดบริการทั้งหมด</div>
            <div class="adm-stat-val" style="color:#10b981; font-size:20px;">@branches.Count สาขา</div>
            <div class="adm-stat-sub">รวมห้องซ้อม @branches.Sum(b => b.Pods?.Count ?? 0) ห้อง</div>
        </div>
    </div>

    <!-- Branches Editor Table -->
    <div class="st-table-card">
        <div style="padding:14px 18px; border-bottom:1px solid #27272a; background:#0c0c0f;">
            <h2 style="font-size:14px; font-weight:600; color:#fafafa; margin:0;">รายชื่อสาขาและที่ตั้งในระบบฐานข้อมูล (Branches Directory)</h2>
        </div>
        <table class="st-shadcn-table">
            <thead>
                <tr>
                    <th>รหัสสาขา</th>
                    <th>ชื่อสาขา (Branch Name)</th>
                    <th>ที่ตั้ง (Location)</th>
                    <th>จำนวนห้อง Pod</th>
                    <th>จำนวนบุคลากร/สมาชิก</th>
                    <th style="text-align:right;">บันทึกการแก้ไข</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var b in branches)
                {
                    <tr>
                        <form asp-controller="Admin" asp-action="UpdateBranch" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="branchId" value="@b.BranchId" />
                            <td style="font-family:monospace; color:#a1a1aa;">#BR-@b.BranchId.ToString("D2")</td>
                            <td>
                                <input type="text" name="branchName" value="@b.BranchName" class="st-input" style="min-width:190px;" required />
                            </td>
                            <td>
                                <input type="text" name="location" value="@b.Location" class="st-input" style="min-width:280px;" />
                            </td>
                            <td><span class="st-badge st-badge-green">@(b.Pods?.Count ?? 0) ห้อง</span></td>
                            <td><span class="st-badge st-badge-blue">@(b.Users?.Count ?? 0) บัญชี</span></td>
                            <td style="text-align:right;">
                                <button type="submit" class="st-btn-primary" style="height:32px; padding:0 14px; font-size:12px;">บันทึกสาขา</button>
                            </td>
                        </form>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
