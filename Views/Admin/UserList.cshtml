<!-- Modal ยืนยันปิด/เปิดการใช้งานบัญชี (Custom Modern Dialog ตามแบบรูปตัวอย่าง) -->
<div class="modal fade" id="statusConfirmModal" tabindex="-1" aria-hidden="true" data-bs-backdrop="static">
    <div class="modal-dialog modal-dialog-centered" style="max-width: 410px;">
        <div class="modal-content border-0" style="background: #18181b; color: #fff; border-radius: 20px; box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.75); border: 1px solid rgba(255, 255, 255, 0.08); overflow: hidden;">
            <div class="modal-body p-4 text-center">
                
                <!-- Icon Badge (Rounded square with subtle tint) -->
                <div id="statusModalIconBox" style="width: 58px; height: 58px; margin: 6px auto 18px auto; border-radius: 14px; display: flex; align-items: center; justify-content: center; background: rgba(239, 68, 68, 0.14); border: 1px solid rgba(239, 68, 68, 0.25);">
                    <svg id="statusModalIcon" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#f87171" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="3 6 5 6 21 6"></polyline>
                        <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
                        <line x1="10" y1="11" x2="10" y2="17"></line>
                        <line x1="14" y1="11" x2="14" y2="17"></line>
                    </svg>
                </div>

                <!-- Title -->
                <h5 class="fw-bold mb-2 text-white" id="statusModalTitle" style="font-size: 1.22rem; letter-spacing: -0.01em;">
                    ปิดการใช้งานบัญชี?
                </h5>

                <!-- Description -->
                <p class="mb-4 px-2" id="statusModalDesc" style="font-size: 0.92rem; line-height: 1.6; color: #a1a1aa !important;">
                    การปิดการใช้งานบัญชีของ <strong class="text-white" id="statusModalUserName">คุณ สมชาย</strong> จะทำให้สมาชิกไม่สามารถเข้าสู่ระบบและระงับการจองชั่วคราว ข้อมูลสถิติยังคงถูกบันทึกไว้อย่างปลอดภัย
                </p>

                <!-- Actions Divider & Buttons (Cancel & Action) -->
                <div class="pt-3" style="border-top: 1px solid rgba(255, 255, 255, 0.08);">
                    <form method="post" asp-controller="Admin" asp-action="ToggleUserStatus" id="statusConfirmForm">
                        <input type="hidden" name="id" id="statusModalUserId" value="" />
                        <div class="d-flex gap-2">
                            <button type="button" class="btn flex-fill py-2" data-bs-dismiss="modal" 
                                    style="background: #27272a; color: #f4f4f5; border: 1px solid rgba(255,255,255,0.1); border-radius: 12px; font-weight: 500; font-size: 0.95rem; transition: all 0.2s;">
                                ยกเลิก
                            </button>
                            <button type="submit" id="statusModalSubmitBtn" class="btn flex-fill py-2" 
                                    style="background: rgba(239, 68, 68, 0.22); color: #f87171; border: 1px solid rgba(239, 68, 68, 0.35); border-radius: 12px; font-weight: 600; font-size: 0.95rem; transition: all 0.2s;">
                                ปิดการใช้งาน
                            </button>
                        </div>
                    </form>
                </div>

            </div>
        </div>
    </div>
</div>

<!-- Modal ยืนยันการลบผู้ใช้ถาวร (Hard Delete) -->
<div class="modal fade" id="deleteUserModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" style="max-width: 420px;">
        <div class="modal-content border-0" style="background: #18181b; color: #fff; border-radius: 20px; box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.75); border: 1px solid rgba(239, 68, 68, 0.3); overflow: hidden;">
            <div class="modal-body p-4 text-center">
                
                <div style="width: 58px; height: 58px; margin: 6px auto 18px auto; border-radius: 14px; display: flex; align-items: center; justify-content: center; background: rgba(239, 68, 68, 0.18); border: 1px solid rgba(239, 68, 68, 0.35);">
                    <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#ef4444" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="3 6 5 6 21 6"></polyline>
                        <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
                        <line x1="10" y1="11" x2="10" y2="17"></line>
                        <line x1="14" y1="11" x2="14" y2="17"></line>
                    </svg>
                </div>

                <h5 class="fw-bold mb-2 text-danger" style="font-size: 1.25rem;">
                    ยืนยันการลบผู้ใช้งานถาวร?
                </h5>

                <p class="mb-4 px-2" style="font-size: 0.92rem; line-height: 1.6; color: #a1a1aa !important;">
                    คุณต้องการลบข้อมูลของ <strong class="text-white" id="deleteModalUserName">...</strong> ออกจากระบบฐานข้อมูลจริงหรือไม่?<br/>
                    <span class="text-warning small">&#9888; ข้อมูลนี้จะถูกลบออกจากตาราง Users ถาวรและไม่สามารถกู้คืนได้</span>
                </p>

                <div class="pt-3" style="border-top: 1px solid rgba(255, 255, 255, 0.08);">
                    <form method="post" asp-controller="Admin" asp-action="DeleteUser">
                        <input type="hidden" name="id" id="deleteModalUserId" value="" />
                        <div class="d-flex gap-2">
                            <button type="button" class="btn flex-fill py-2" data-bs-dismiss="modal" 
                                    style="background: #27272a; color: #f4f4f5; border: 1px solid rgba(255,255,255,0.1); border-radius: 12px; font-weight: 500;">
                                ยกเลิก
                            </button>
                            <button type="submit" class="btn flex-fill py-2 text-white" 
                                    style="background: #dc2626; border-radius: 12px; font-weight: 600;">
                                ลบข้อมูลถาวร
                            </button>
                        </div>
                    </form>
                </div>

            </div>
        </div>
    </div>
</div>

<style>
    #statusConfirmModal .btn:hover,
    #deleteUserModal .btn:hover {
        filter: brightness(1.15);
    }
    #statusConfirmModal .modal-content,
    #deleteUserModal .modal-content {
        animation: statusModalPop 0.22s cubic-bezier(0.16, 1, 0.3, 1);
    }
    @@keyframes statusModalPop {
        from {
            opacity: 0;
            transform: scale(0.95);
        }
        to {
            opacity: 1;
            transform: scale(1);
        }
    }

    /* Mobile Bottom Sheet Drawer Style (PrivateGym Standard) */
    @@media (max-width: 575.98px) {
        #statusConfirmModal .modal-dialog,
        #deleteUserModal .modal-dialog,
        #userDetailModal .modal-dialog {
            margin: 0 !important;
            position: fixed !important;
            bottom: 0 !important;
            left: 0 !important;
            right: 0 !important;
            max-width: 100% !important;
            width: 100% !important;
        }
        #statusConfirmModal .modal-content,
        #deleteUserModal .modal-content,
        #userDetailModal .modal-content {
            border-radius: 24px 24px 0 0 !important;
            border-bottom: none !important;
            animation: bottomSheetSlideUp 0.24s cubic-bezier(0.16, 1, 0.3, 1) !important;
            max-height: 88vh;
            overflow-y: auto;
        }
        @@keyframes bottomSheetSlideUp {
            from { transform: translateY(100%); }
            to { transform: translateY(0); }
        }
    }
</style>

@section Scripts {
<script>
    function handleStatusModalClick(button) {
        const userId = button.getAttribute('data-userid');
        const userName = button.getAttribute('data-username');
        const action = button.getAttribute('data-action');
        
        document.getElementById('statusModalUserId').value = userId;
        document.getElementById('statusModalUserName').innerText = userName;

        const iconBox = document.getElementById('statusModalIconBox');
        const titleEl = document.getElementById('statusModalTitle');
        const descEl = document.getElementById('statusModalDesc');
        const submitBtn = document.getElementById('statusModalSubmitBtn');

        if (action === 'deactivate') {
            iconBox.style.background = 'rgba(239, 68, 68, 0.14)';
            iconBox.style.borderColor = 'rgba(239, 68, 68, 0.25)';
            iconBox.innerHTML = `
                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#f87171" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="3 6 5 6 21 6"></polyline>
                    <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
                    <line x1="10" y1="11" x2="10" y2="17"></line>
                    <line x1="14" y1="11" x2="14" y2="17"></line>
                </svg>
            `;
            titleEl.innerText = 'ปิดการใช้งานบัญชี?';
            descEl.innerHTML = `การปิดการใช้งานบัญชีของ <strong class="text-white">${userName}</strong> ซึ่งจะทำให้สมาชิกไม่สามารถเข้าสู่ระบบและระงับการจองชั่วคราว ข้อมูลสถิติยังคงถูกบันทึกไว้อย่างปลอดภัย`;
            submitBtn.style.background = 'rgba(239, 68, 68, 0.22)';
            submitBtn.style.borderColor = 'rgba(239, 68, 68, 0.35)';
            submitBtn.style.color = '#f87171';
            submitBtn.innerText = 'ปิดการใช้งาน';
        } else {
            iconBox.style.background = 'rgba(34, 197, 94, 0.14)';
            iconBox.style.borderColor = 'rgba(34, 197, 94, 0.25)';
            iconBox.innerHTML = `
                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#4ade80" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                    <polyline points="22 4 12 14.01 9 11.01"></polyline>
                </svg>
            `;
            titleEl.innerText = 'เปิดการใช้งานบัญชี?';
            descEl.innerHTML = `เปิดการใช้งานบัญชีของ <strong class="text-white">${userName}</strong> เพื่อให้สมาชิกสามารถเข้าสู่ระบบและใช้งานบริการ PrivateGym ได้ตามปกติ`;
            submitBtn.style.background = 'rgba(34, 197, 94, 0.22)';
            submitBtn.style.borderColor = 'rgba(34, 197, 94, 0.35)';
            submitBtn.style.color = '#4ade80';
            submitBtn.innerText = 'เปิดการใช้งาน';
        }

        const modal = new bootstrap.Modal(document.getElementById('statusConfirmModal'));
        modal.show();
    }

    function showUserDetails(userId) {
        fetch('/Admin/GetUserDetails/' + userId)
            .then(res => {
                if (!res.ok) throw new Error('Not found');
                return res.json();
            })
            .then(data => {
                document.getElementById('modalUserName').innerText = data.fullName;
                document.getElementById('modalUserId').innerText = '#PG-' + data.userId;
                document.getElementById('modalRole').innerText = data.role;
                document.getElementById('modalEmail').innerText = data.email;
                document.getElementById('modalPhone').innerText = data.phone;
                document.getElementById('modalBranch').innerText = data.branch;
                document.getElementById('modalPackage').innerText = data.packageName;
                document.getElementById('modalHeight').innerText = data.height !== '-' ? data.height + ' ซม.' : '-';
                document.getElementById('modalWeight').innerText = data.weight !== '-' ? data.weight + ' กก.' : '-';
                document.getElementById('modalGender').innerText = data.gender;
                document.getElementById('modalExperience').innerText = data.experience;
                document.getElementById('modalGoal').innerText = data.goal;
                document.getElementById('modalTaxId').innerText = data.taxId;
                document.getElementById('modalBillingAddress').innerText = data.billingAddress;

                const modal = new bootstrap.Modal(document.getElementById('userDetailModal'));
                modal.show();
            })
            .catch(err => {
                console.error(err);
                alert('กำลังโหลดข้อมูลสมาชิก...');
            });
    }

    function handleDeleteModalClick(userId, userName) {
        document.getElementById('deleteModalUserId').value = userId;
        document.getElementById('deleteModalUserName').innerText = userName;
        const modal = new bootstrap.Modal(document.getElementById('deleteUserModal'));
        modal.show();
    }
</script>
}
