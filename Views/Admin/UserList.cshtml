@model PrivateGym.ViewModels.AdminDashboardViewModel
@{
    ViewData["Title"] = "จัดการสมาชิกทั้งหมด";
    Layout = "~/Views/Shared/Admin/_AdminLayout.cshtml";
    string activeTab = ViewBag.ActiveTab ?? "all";
    string currentSearch = ViewBag.Search ?? "";
    string currentStatus = ViewBag.Status ?? "all";
    string currentPkg = ViewBag.Pkg ?? "all";
}

<div class="container-fluid py-3 px-4">

    <!-- Flash message -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show border-0 bg-success bg-opacity-25 text-white mb-3 d-flex align-items-center justify-content-between" role="alert">
            <div class="d-flex align-items-center gap-2">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"/></svg>
                <span>@TempData["SuccessMessage"]</span>
            </div>
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show border-0 bg-danger bg-opacity-25 text-white mb-3 d-flex align-items-center justify-content-between" role="alert">
            <div class="d-flex align-items-center gap-2">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-2h2v2zm0-4h-2V7h2v6z"/></svg>
                <span>@TempData["ErrorMessage"]</span>
            </div>
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- 1. Header Section -->
    <div class="adm-header-wrap">
        <div class="adm-title-block">
            <h1>
                จัดการสมาชิกทั้งหมด
                <span style="font-size: 15px; font-weight: 400; color: var(--adm-text-dim);">(Member Directory & Lifecycle)</span>
            </h1>
            <p class="adm-subtitle">
                ค้นหา ตรวจสอบสถานะ และจัดการฐานข้อมูลสมาชิกระบบ PrivateGym (@Model.TotalCount สมาชิกที่กำลังใช้งาน)
            </p>
        </div>

        <div class="adm-header-actions">
            <a asp-controller="Admin" asp-action="ExportDashboardCsv" class="adm-btn-ghost">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
                ส่งออกข้อมูล CSV
            </a>
            <a asp-controller="Admin" asp-action="AddUser" class="adm-btn-red">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><line x1="19" y1="8" x2="19" y2="14"/><line x1="22" y1="11" x2="16" y2="11"/></svg>
                + เพิ่มสมาชิกใหม่ (Add Member)
            </a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success" style="background: rgba(16, 185, 129, 0.14); border: 1px solid rgba(16, 185, 129, 0.35); color: #fafafa; border-radius: 10px; padding: 12px 16px; margin-bottom: 16px; font-size: 13px;">
            @TempData["SuccessMessage"]
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger" style="background: rgba(239, 68, 68, 0.14); border: 1px solid rgba(239, 68, 68, 0.35); color: #fafafa; border-radius: 10px; padding: 12px 16px; margin-bottom: 16px; font-size: 13px;">
            @TempData["ErrorMessage"]
        </div>
    }

    <!-- 2. KPI Cards (4 Items) -->
    <div class="adm-kpi-grid" style="grid-template-columns: repeat(4, 1fr);">
        <!-- Active Clients -->
        <div class="adm-kpi-card">
            <div class="adm-kpi-header">
                <span class="adm-kpi-label">ACTIVE CLIENTS</span>
                <span class="adm-kpi-dot green"></span>
            </div>
            <div class="adm-kpi-value-row">
                <span class="adm-kpi-val">@Model.ActiveClients</span>
                <span class="adm-kpi-val-sub">/ @Model.MaxSlots SLOTS</span>
            </div>
            <div class="adm-kpi-meta">
                <span>ความจุระบบ (Cap)</span>
                <span style="font-weight: 600; color: #fff;">@Model.CapacityPercent%</span>
            </div>
            <div class="adm-kpi-bar">
                <div class="adm-kpi-bar-fill green" style="width: @Model.CapacityPercent%;"></div>
            </div>
        </div>

        <!-- New This Month -->
        <div class="adm-kpi-card">
            <div class="adm-kpi-header">
                <span class="adm-kpi-label">NEW THIS MONTH</span>
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="color: var(--adm-text-dim);"><polyline points="23 6 13.5 15.5 8.5 10.5 1 18"/><polyline points="17 6 23 6 23 12"/></svg>
            </div>
            <div class="adm-kpi-value-row">
                <span class="adm-kpi-val">@Model.NewThisMonth</span>
                <span style="color: var(--adm-green); font-size: 12px; font-weight: 600;">+@Model.MomGrowthPercent% MoM</span>
            </div>
            <div class="adm-kpi-meta">
                <span>เป้าหมายใหม่ (Target)</span>
                <span>@Model.TargetNew คน</span>
            </div>
            <div class="adm-kpi-bar">
                <div class="adm-kpi-bar-fill white" style="width: 100%;"></div>
            </div>
        </div>

        <!-- Expiring < 7 Days -->
        <div class="adm-kpi-card">
            <div class="adm-kpi-header">
                <span class="adm-kpi-label">EXPIRING &lt; 7 DAYS</span>
                <span class="adm-kpi-dot orange"></span>
            </div>
            <div class="adm-kpi-value-row">
                <span class="adm-kpi-val" style="color: #fbbf24;">@Model.ExpiringIn7Days</span>
                <span class="adm-kpi-val-sub">คนต้องติดตาม</span>
            </div>
            <div class="adm-kpi-meta">
                <span>ส่งการแจ้งเตือนแล้ว</span>
                <span style="color: #fbbf24;">5/7 รายการ</span>
            </div>
            <div class="adm-kpi-bar">
                <div class="adm-kpi-bar-fill orange" style="width: 71%;"></div>
            </div>
        </div>

        <!-- Pending Audit -->
        <div class="adm-kpi-card">
            <div class="adm-kpi-header">
                <span class="adm-kpi-label">PENDING AUDIT</span>
                <span class="adm-kpi-dot red"></span>
            </div>
            <div class="adm-kpi-value-row">
                <span class="adm-kpi-val" style="color: #f87171;">@Model.PendingAuditCount</span>
                <span class="adm-kpi-val-sub">รายการค้าง</span>
            </div>
            <div class="adm-kpi-meta">
                <span>ยอดรอตรวจสอบ</span>
                <span style="color: #f87171; font-weight: 600;">฿@Model.PendingAuditAmount.ToString("N0")</span>
            </div>
            <div class="adm-kpi-bar">
                <div class="adm-kpi-bar-fill red" style="width: 25%;"></div>
            </div>
        </div>
    </div>

    <!-- 3. Search and Filter Bar -->
    <form method="get" asp-controller="Admin" asp-action="UserList" class="adm-filter-bar">
        <input type="hidden" name="tab" value="@activeTab" />
        <div class="adm-search-input-wrap">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
            <input type="text" name="search" value="@currentSearch" class="adm-search-input" placeholder="ค้นหาชื่อสมาชิก, รหัสบัตร PG-XXXXX, อีเมล หรือเบอร์โทร..." />
        </div>

        <select name="status" class="adm-select" onchange="this.form.submit()">
            <option value="all" selected="@(currentStatus == "all")">สถานะ: ทั้งหมด</option>
            <option value="active" selected="@(currentStatus == "active")">กำลังใช้งาน</option>
            <option value="warning" selected="@(currentStatus == "warning")">รอต่ออายุ</option>
            <option value="suspended" selected="@(currentStatus == "suspended")">ระงับชั่วคราว</option>
            <option value="expired" selected="@(currentStatus == "expired")">หมดอายุแล้ว</option>
        </select>

        <select name="pkg" class="adm-select" onchange="this.form.submit()">
            <option value="all" selected="@(currentPkg == "all")">แพ็กเกจ: ทุกระดับ</option>
            <option value="elite" selected="@(currentPkg == "elite")">Elite Concierge VIP</option>
            <option value="pro" selected="@(currentPkg == "pro")">Performance Pro</option>
            <option value="essential" selected="@(currentPkg == "essential")">Essential Access</option>
        </select>

        <select class="adm-select">
            <option>กำหนดหมดอายุ: ทั้งหมด</option>
            <option>ภายใน 7 วัน</option>
            <option>ภายใน 30 วัน</option>
        </select>

        <a asp-controller="Admin" asp-action="UserList" class="adm-btn-ghost" style="padding: 6px 10px;" title="รีเฟรช">
            &#x21bb;
        </a>
    </form>

    <!-- 4. Lifecycle Tabs Navigation -->
    <div class="adm-tabs-row">
        <a asp-controller="Admin" asp-action="UserList" asp-route-tab="all" asp-route-search="@currentSearch" class="adm-tab-link @(activeTab == "all" ? "active" : "")">
            ทั้งหมด <span class="adm-tab-count">@Model.TotalCount</span>
        </a>
        <a asp-controller="Admin" asp-action="UserList" asp-route-tab="active" asp-route-search="@currentSearch" class="adm-tab-link @(activeTab == "active" ? "active" : "")">
            กำลังใช้งาน <span class="adm-tab-count">@Model.ActiveCount</span>
        </a>
        <a asp-controller="Admin" asp-action="UserList" asp-route-tab="expiring" asp-route-search="@currentSearch" class="adm-tab-link @(activeTab == "expiring" ? "active" : "")">
            <span style="color: var(--adm-amber);">&#x25CF;</span> ใกล้หมดอายุ (&lt; 7 วัน) <span class="adm-tab-count">@Model.ExpiringCount</span>
        </a>
        <a asp-controller="Admin" asp-action="UserList" asp-route-tab="suspended" asp-route-search="@currentSearch" class="adm-tab-link @(activeTab == "suspended" ? "active" : "")">
            ระงับชั่วคราว <span class="adm-tab-count">@Model.SuspendedCount</span>
        </a>
        <a asp-controller="Admin" asp-action="UserList" asp-route-tab="expired" asp-route-search="@currentSearch" class="adm-tab-link @(activeTab == "expired" ? "active" : "")">
            หมดอายุ <span class="adm-tab-count">@Model.ExpiredCount</span>
        </a>
    </div>

    <!-- 5. Main Members Table -->
    <div class="adm-table-container">
        <div class="table-responsive d-none d-lg-block">
            <table class="adm-table">
                <thead>
                    <tr>
                        <th style="width: 36px;"><input type="checkbox" style="accent-color: var(--adm-red); cursor: pointer;" /></th>
                        <th>รหัส &amp; ข้อมูลสมาชิก</th>
                        <th>แพ็กเกจ</th>
                        <th>สถานะ</th>
                        <th>โควต้าคงเหลือ (PODS / PT)</th>
                        <th>ระยะเวลา &amp; อายุคงเหลือ</th>
                        <th>ยอดสะสม (LTV)</th>
                        <th style="text-align: right; padding-right: 18px;">การกระทำ</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Members.Any())
                    {
                        foreach (var m in Model.Members)
                        {
                            <tr>
                                <td>
                                    <input type="checkbox" style="accent-color: var(--adm-red); cursor: pointer;" />
                                </td>
                                <td>
                                    <div class="adm-member-cell">
                                        <div class="adm-avatar">@m.AvatarInitials</div>
                                        <div class="adm-member-info">
                                            <div class="adm-member-name">
                                                @m.FullName
                                                @if (m.IsVerified)
                                                {
                                                    <span class="adm-verify-badge">&#10003;</span>
                                                }
                                            </div>
                                            <div class="adm-member-id-phone">
                                                @m.MemberCode &bull; @m.Phone
                                            </div>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <span class="adm-pkg-badge @m.PackageTierClass">
                                        @if (m.PackageTierClass == "elite")
                                        {
                                            <span style="color: var(--adm-red); margin-right: 3px;">&#x25CF;</span>
                                        }
                                        @m.PackageName
                                    </span>
                                </td>
                                <td>
                                    <span class="adm-status-item @m.StatusClass">
                                        <span class="dot"></span> @m.StatusText
                                    </span>
                                </td>
                                <td>
                                    <div class="adm-quota-wrap">
                                        <div class="adm-quota-label">
                                            @if (m.StatusClass == "suspended")
                                            {
                                                <span style="color: var(--adm-text-dim); font-size: 11px;">Freeze: พักการใช้ 30 วัน</span>
                                            }
                                            else
                                            {
                                                <span>Pods: <strong>@m.RemainingPods/@m.TotalPods</strong></span>
                                                <span style="color: var(--adm-text-dim);">PT: @(m.TotalPt > 0 ? $"{m.RemainingPt}/{m.TotalPt}" : "--")</span>
                                            }
                                        </div>
                                        <div class="adm-mini-bar">
                                            <div class="adm-mini-bar-fill" style="width: @(m.PodProgressPercent)%;"></div>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <div class="adm-date-main">@m.StartDateFormatted - @m.EndDateFormatted</div>
                                    <div class="adm-date-sub @m.ExpiryNoteClass">
                                        @if (m.ExpiryNoteClass == "orange")
                                        {
                                            <span>&#9888;</span>
                                        }
                                        else if (m.ExpiryNoteClass == "green")
                                        {
                                            <span>&#9201;</span>
                                        }
                                        @m.ExpiryNote
                                    </div>
                                </td>
                                <td>
                                    <span style="font-weight: 600; color: #fff;">฿@m.LifetimeValue.ToString("N0")</span>
                                </td>
                                <td style="text-align: right; padding-right: 16px; white-space: nowrap;">
                                    <div class="d-inline-flex align-items-center justify-content-end gap-2">
                                        @if (m.StatusClass == "suspended")
                                        {
                                            <button type="button" class="st-btn-outline" style="height: 30px; padding: 0 10px; font-size: 12px; color: #10b981;"
                                                    data-userid="@m.UserId"
                                                    data-username="@m.FullName"
                                                    data-action="activate"
                                                    onclick="handleStatusModalClick(this)">
                                                เปิดใช้งาน
                                            </button>
                                        }
                                        else if (!string.IsNullOrEmpty(m.PrimaryActionText))
                                        {
                                            <button type="button"
                                                    class="@(m.PrimaryActionClass == "red" ? "st-btn-primary" : "st-btn-outline")"
                                                    style="height: 30px; padding: 0 10px; font-size: 12px;"
                                                    onclick="openRenewPaymentModal(@m.UserId, '@m.FullName', '@m.PackageName', '@m.ExpiryNote', 'UserList')">
                                                @m.PrimaryActionText
                                            </button>
                                        }

                                        <button type="button" class="st-btn-outline" style="height: 30px; padding: 0 10px; font-size: 12px;" onclick="showUserDetails(@m.UserId)">
                                            ดูข้อมูล
                                        </button>

                                        <a asp-controller="Admin" asp-action="EditUser" asp-route-id="@m.UserId"
                                           class="st-btn-outline" style="height: 30px; padding: 0 10px; font-size: 12px;">
                                            แก้ไข
                                        </a>

                                        <div class="dropdown d-inline">
                                            <button class="st-btn-outline" type="button" data-bs-toggle="dropdown" aria-expanded="false" style="height: 30px; width: 30px; padding: 0; font-size: 14px;" title="ตัวเลือกเพิ่มเติม">
                                                &#8942;
                                            </button>
                                            <ul class="dropdown-menu dropdown-menu-dark dropdown-menu-end" style="background: #09090b; border: 1px solid #27272a; font-size: 12.5px;">
                                                <li>
                                                    @if (m.StatusClass == "suspended")
                                                    {
                                                        <button type="button" class="dropdown-item text-success"
                                                                data-userid="@m.UserId"
                                                                data-username="@m.FullName"
                                                                data-action="activate"
                                                                onclick="handleStatusModalClick(this)">
                                                            เปิดใช้งานบัญชี (Activate)
                                                        </button>
                                                    }
                                                    else
                                                    {
                                                        <button type="button" class="dropdown-item text-warning"
                                                                data-userid="@m.UserId"
                                                                data-username="@m.FullName"
                                                                data-action="deactivate"
                                                                onclick="handleStatusModalClick(this)">
                                                            ระงับการใช้งานชั่วคราว (Suspend)
                                                        </button>
                                                    }
                                                </li>
                                                <li><hr class="dropdown-divider" style="border-color: #27272a;"></li>
                                                <li>
                                                    <button type="button" class="dropdown-item text-danger"
                                                            onclick="handleDeleteModalClick(@m.UserId, '@m.FullName')">
                                                        ลบข้อมูลถาวร (Delete)
                                                    </button>
                                                </li>
                                            </ul>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="8" class="text-center py-5 text-secondary">
                                ไม่พบข้อมูลสมาชิกที่ตรงกับเงื่อนไขการค้นหา
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Mobile Member Cards (Adaptive Layout per PrivateGym Mobile Standard) -->
        <div class="adm-mobile-cards-list d-lg-none p-3">
            @if (Model.Members.Any())
            {
                foreach (var m in Model.Members)
                {
                    <div class="adm-mcard mb-3 p-3 rounded-3 border border-secondary border-opacity-25" style="background: #121216;">
                        <!-- Top Row: Avatar + Name + Status -->
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <div class="d-flex align-items-center gap-2">
                                <div class="adm-avatar" style="width: 38px; height: 38px; font-size: 13px;">@m.AvatarInitials</div>
                                <div>
                                    <div class="fw-bold text-white" style="font-size: 14.5px;">@m.FullName</div>
                                    <div class="text-muted small" style="font-size: 11.5px;">@m.MemberCode &bull; @m.BranchName</div>
                                </div>
                            </div>
                            <span class="adm-status-item @m.StatusClass" style="font-size: 11px; padding: 3px 8px;">
                                <span class="dot"></span> @m.StatusText
                            </span>
                        </div>

                        <!-- Info Row -->
                        <div class="py-2 my-2 border-top border-bottom border-secondary border-opacity-25">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <span class="adm-pkg-badge @m.PackageTierClass">@m.PackageName</span>
                                <span class="text-white fw-bold small">฿@m.LifetimeValue.ToString("N0")</span>
                            </div>

                            <div class="adm-quota-wrap">
                                <div class="adm-quota-label text-muted small d-flex justify-content-between mb-1" style="font-size: 11.5px;">
                                    <span>Pods: <strong class="text-white">@m.RemainingPods/@m.TotalPods</strong></span>
                                    <span>PT: <strong class="text-white">@(m.TotalPt > 0 ? $"{m.RemainingPt}/{m.TotalPt}" : "--")</strong></span>
                                </div>
                                <div class="adm-mini-bar" style="height: 4px;">
                                    <div class="adm-mini-bar-fill" style="width: @(m.PodProgressPercent)%;"></div>
                                </div>
                            </div>

                            <div class="text-muted small mt-2 d-flex justify-content-between" style="font-size: 11px;">
                                <span>อายุสมาชิก:</span>
                                <span>@m.StartDateFormatted - @m.EndDateFormatted</span>
                            </div>
                        </div>

                        <!-- Bottom Touch Action Buttons (Min 44-48px touch target) -->
                        <div class="d-flex gap-2 pt-1">
                            <button type="button" class="btn btn-sm flex-fill text-white border border-secondary border-opacity-50" 
                                    style="min-height: 44px; background: rgba(255,255,255,0.05); font-size: 12.5px;"
                                    onclick="showUserDetails(@m.UserId)">
                                ดูข้อมูล
                            </button>
                            <a asp-controller="Admin" asp-action="EditUser" asp-route-id="@m.UserId"
                               class="btn btn-sm flex-fill text-warning border border-warning border-opacity-50 d-inline-flex align-items-center justify-content-center"
                               style="min-height: 44px; background: rgba(234, 179, 8, 0.1); font-size: 12.5px;">
                                แก้ไข
                            </a>
                            <button type="button" class="btn btn-sm flex-fill text-danger border border-danger border-opacity-50"
                                    style="min-height: 44px; background: rgba(239, 68, 68, 0.1); font-size: 12.5px;"
                                    onclick="handleDeleteModalClick(@m.UserId, '@m.FullName')">
                                ลบ
                            </button>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="text-center py-5 text-secondary">
                    ไม่พบข้อมูลสมาชิกที่ตรงกับเงื่อนไขการค้นหา
                </div>
            }
        </div>

        <!-- Pagination footer -->
        @{
            int curPage = ViewBag.Page is int pg ? pg : 1;
            int pageSize = ViewBag.PageSize is int ps ? ps : 10;
            int totalPages = ViewBag.TotalPages is int tp ? tp : 1;
            int filteredCount = ViewBag.FilteredCount is int fc ? fc : Model.Members.Count;
            int startRow = filteredCount == 0 ? 0 : (curPage - 1) * pageSize + 1;
            int endRow = Math.Min(curPage * pageSize, filteredCount);
            string pgTab = ViewBag.ActiveTab as string ?? "all";
            string searchQ = ViewBag.Search as string ?? "";
            string statusQ = ViewBag.Status as string ?? "";
            string pkgQ = ViewBag.Pkg as string ?? "";
        }
        <div class="adm-pagination-wrap">
            <form asp-controller="Admin" asp-action="UserList" method="get" class="d-inline-flex align-items-center gap-2" style="margin:0;">
                <input type="hidden" name="tab" value="@pgTab" />
                <input type="hidden" name="search" value="@searchQ" />
                <input type="hidden" name="status" value="@statusQ" />
                <input type="hidden" name="pkg" value="@pkgQ" />
                <input type="hidden" name="page" value="1" />
                <span>แสดง @startRow - @endRow จากทั้งหมด @filteredCount สมาชิก &nbsp;&bull;&nbsp; แถวต่อหน้า:</span>
                <select name="pageSize" class="adm-select" style="min-height: 28px; height: 28px; padding: 0 8px !important; font-size: 12px !important;" onchange="this.form.submit()">
                    <option value="10" selected="@(pageSize == 10)">10</option>
                    <option value="25" selected="@(pageSize == 25)">25</option>
                    <option value="50" selected="@(pageSize == 50)">50</option>
                </select>
            </form>
            <div class="adm-pages">
                @if (curPage > 1)
                {
                    <a asp-controller="Admin" asp-action="UserList"
                       asp-route-tab="@pgTab" asp-route-search="@searchQ" asp-route-status="@statusQ" asp-route-pkg="@pkgQ"
                       asp-route-page="@(curPage - 1)" asp-route-pageSize="@pageSize"
                       class="adm-page-num" style="width: auto; padding: 0 8px;">&lt;</a>
                }
                @for (int p = 1; p <= totalPages; p++)
                {
                    if (p == curPage)
                    {
                        <span class="adm-page-num active">@p</span>
                    }
                    else
                    {
                        <a asp-controller="Admin" asp-action="UserList"
                           asp-route-tab="@pgTab" asp-route-search="@searchQ" asp-route-status="@statusQ" asp-route-pkg="@pkgQ"
                           asp-route-page="@p" asp-route-pageSize="@pageSize"
                           class="adm-page-num">@p</a>
                    }
                }
                @if (curPage < totalPages)
                {
                    <a asp-controller="Admin" asp-action="UserList"
                       asp-route-tab="@pgTab" asp-route-search="@searchQ" asp-route-status="@statusQ" asp-route-pkg="@pkgQ"
                       asp-route-page="@(curPage + 1)" asp-route-pageSize="@pageSize"
                       class="adm-page-num" style="width: auto; padding: 0 8px;">&gt;</a>
                }
            </div>
        </div>
    </div>

</div>

