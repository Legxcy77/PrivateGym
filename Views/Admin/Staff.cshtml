@model List<PrivateGym.Models.User>
@using PrivateGym.Models
@{
    ViewData["Title"] = "จัดการบุคลากรและเจ้าหน้าที่ (Staff Management)";
    Layout = "~/Views/Shared/Admin/_AdminLayout.cshtml";

    var staffList = Model ?? new List<User>();
    var branches = ViewBag.Branches as List<Branch> ?? new List<Branch>();
    var handoverLogs = ViewBag.HandoverLogs as List<Dictionary<string, string>> ?? new List<Dictionary<string, string>>();
    string search = ViewBag.Search ?? "";
    int activeStaffCount = staffList.Count(u => u.Status != "Inactive" && u.Status != "Suspended");
    int maintPods = ViewBag.MaintPodsCount ?? 0;
}

<div class="adm-page">
    <div class="adm-page-head">
        <div>
            <h1 class="adm-page-title">จัดการบุคลากรและเจ้าหน้าที่ (Staff Management)</h1>
            <p class="adm-page-sub">รายชื่อพนักงานประจำเคาน์เตอร์สาขา และบันทึกส่งเวรจริงที่เชื่อมกับหน้า Staff</p>
        </div>
        <button type="button" class="st-btn-primary" data-bs-toggle="modal" data-bs-target="#addStaffModal">+ เพิ่มพนักงานใหม่ (Add Staff)</button>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success" style="background: rgba(16, 185, 129, 0.14); border: 1px solid rgba(16, 185, 129, 0.35); color: #fafafa; border-radius: 10px; padding: 12px 16px; margin-bottom: 16px; font-size: 13px;">
            @TempData["SuccessMessage"]
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger" style="background: rgba(239, 68, 68, 0.14); border: 1px solid rgba(239, 68, 68, 0.35); color: #fafafa; border-radius: 10px; padding: 12px 16px; margin-bottom: 16px; font-size: 13px;">
            @TempData["ErrorMessage"]
        </div>
    }

    <div class="adm-kpi-4">
        <div class="adm-stat-card">
            <div class="adm-stat-lbl">พนักงานทั้งหมด</div>
            <div class="adm-stat-val">@staffList.Count <span style="font-size:13px; color:#71717a; font-weight:400;">คน</span></div>
            <div class="adm-stat-sub">ลงทะเบียนในระบบ Role Staff</div>
        </div>
        <div class="adm-stat-card">
            <div class="adm-stat-lbl">สถานะพร้อมปฏิบัติงาน (ACTIVE)</div>
            <div class="adm-stat-val" style="color:#10b981;">@activeStaffCount <span style="font-size:13px; color:#71717a; font-weight:400;">/ @staffList.Count คน</span></div>
            <div class="adm-stat-sub">บัญชีเปิดใช้งานปกติ</div>
        </div>
        <div class="adm-stat-card">
            <div class="adm-stat-lbl">เคาน์เตอร์สาขาทั้งหมด</div>
            <div class="adm-stat-val">@branches.Count <span style="font-size:13px; color:#71717a; font-weight:400;">สาขา</span></div>
            <div class="adm-stat-sub">ครอบคลุมทุกสาขาหลัก</div>
        </div>
        <div class="adm-stat-card">
            <div class="adm-stat-lbl">ห้องซ้อมรอซ่อมบำรุง</div>
            <div class="adm-stat-val" style="color:@(maintPods > 0 ? "#f59e0b" : "#10b981");">@maintPods <span style="font-size:13px; color:#71717a; font-weight:400;">ห้อง</span></div>
            <div class="adm-stat-sub">ซิงค์จากหน้าจัดการห้องซ้อม</div>
        </div>
    </div>

    <div class="row g-3">
        <!-- Left: Staff Directory Table -->
        <div class="col-lg-8">
            <div class="st-filter-bar">
                <div style="font-size:14px; font-weight:600; color:#fafafa;">รายชื่อพนักงานสาขา (@staffList.Count รายการ)</div>
                <form asp-controller="Admin" asp-action="Staff" method="get" class="d-flex gap-2">
                    <input type="text" name="search" value="@search" class="st-input" style="min-width:240px;" placeholder="ค้นหาชื่อพนักงาน, อีเมล, สาขา..." />
                    <button type="submit" class="st-btn-primary">ค้นหา</button>
                </form>
            </div>

            <div class="st-table-card">
                @if (!staffList.Any())
                {
                    <div style="padding:40px; text-align:center; color:#71717a; font-size:13px;">ไม่พบรายชื่อพนักงาน</div>
                }
                else
                {
                    <table class="st-shadcn-table">
                        <thead>
                            <tr>
                                <th>ข้อมูลพนักงาน</th>
                                <th>สาขาประจำ</th>
                                <th>เบอร์โทรศัพท์</th>
                                <th>สถานะ</th>
                                <th style="text-align:right;">การจัดการ</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var s in staffList)
                            {
                                bool isActive = s.Status != "Inactive" && s.Status != "Suspended";
                                <tr>
                                    <td>
                                        <div style="font-weight:600; color:#fafafa;">@s.FullName <span style="font-size:11px; color:#71717a;">#ST-@s.UserId.ToString("D4")</span></div>
                                        <div style="font-size:12px; color:#a1a1aa;">@s.Email</div>
                                    </td>
                                    <td>
                                        <span class="st-badge st-badge-blue">@(s.HomeBranch?.BranchName ?? "สาขาทองหล่อ")</span>
                                    </td>
                                    <td>@s.Phone</td>
                                    <td>
                                        @if (isActive)
                                        {
                                            <span class="st-badge st-badge-green">ปฏิบัติงาน (Active)</span>
                                        }
                                        else
                                        {
                                            <span class="st-badge st-badge-red">ระงับชั่วคราว</span>
                                        }
                                    </td>
                                    <td style="text-align:right; white-space:nowrap;">
                                        <a asp-controller="Admin" asp-action="EditUser" asp-route-id="@s.UserId" class="st-btn-outline" style="height:30px; padding:0 10px; font-size:12px;">แก้ไข</a>
                                        <form asp-controller="Admin" asp-action="ToggleUserStatus" method="post" style="display:inline;"
                                              data-confirm-title="ยืนยันเปลี่ยนสถานะพนักงาน"
                                              data-confirm="ยืนยัน@(isActive ? "ระงับการใช้งานชั่วคราว" : "เปิดใช้งาน")บัญชีของ @s.FullName หรือไม่?">
                                            <input type="hidden" name="id" value="@s.UserId" />
                                            <input type="hidden" name="returnAction" value="Staff" />
                                            <button type="submit" class="st-btn-outline" style="height:30px; padding:0 10px; font-size:12px; color:@(isActive ? "#f59e0b" : "#10b981");">
                                                @(isActive ? "ระงับ" : "เปิดใช้")
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
        </div>

        <!-- Right: Shift Handover Logs from Staff Portal -->
        <div class="col-lg-4">
            <div class="st-table-card" style="padding:18px;">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h2 style="font-size:14px; font-weight:600; color:#fafafa; margin:0;">บันทึกส่งเวรล่าสุดจากหน้า Staff</h2>
                    <span class="st-badge st-badge-green">LIVE SYNC</span>
                </div>

                @if (!handoverLogs.Any())
                {
                    <div style="padding:24px 12px; text-align:center; color:#71717a; font-size:12.5px;">
                        ยังไม่มีบันทึกส่งเวรจากพนักงานสาขา
                    </div>
                }
                else
                {
                    <div class="d-flex flex-column gap-2">
                        @foreach (var hn in handoverLogs)
                        {
                            <div style="padding:10px 12px; background:#111114; border:1px solid #27272a; border-radius:8px;">
                                <div style="font-size:12.5px; color:#fafafa; margin-bottom:4px;">@hn.GetValueOrDefault("Note", "-")</div>
                                <div class="d-flex justify-content-between" style="font-size:11px; color:#71717a;">
                                    <span>@hn.GetValueOrDefault("StaffName", "Staff")</span>
                                    <span>@hn.GetValueOrDefault("Timestamp", "")</span>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<!-- Modal: Add Staff -->
<div class="modal fade" id="addStaffModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content" style="background:#09090b; border:1px solid #27272a; color:#fafafa; border-radius:14px;">
            <div class="modal-header" style="border-bottom:1px solid #18181b;">
                <h5 class="modal-title" style="font-size:15px; font-weight:600;">เพิ่มพนักงานสาขาใหม่ (Add Staff)</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-controller="Admin" asp-action="AddStaff" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-body d-flex flex-column gap-3">
                    <div>
                        <label style="font-size:12px; color:#a1a1aa; margin-bottom:4px; display:block;">ชื่อ-นามสกุล</label>
                        <input type="text" name="fullName" class="st-input w-100" required placeholder="เช่น คุณสมพร ยอดชาย" />
                    </div>
                    <div>
                        <label style="font-size:12px; color:#a1a1aa; margin-bottom:4px; display:block;">อีเมลเข้าใช้งาน</label>
                        <input type="email" name="email" class="st-input w-100" required placeholder="staff.branch@privategym.club" />
                    </div>
                    <div class="row g-2">
                        <div class="col-6">
                            <label style="font-size:12px; color:#a1a1aa; margin-bottom:4px; display:block;">เบอร์โทรศัพท์</label>
                            <input type="text" name="phone" class="st-input w-100" value="0890000000" required />
                        </div>
                        <div class="col-6">
                            <label style="font-size:12px; color:#a1a1aa; margin-bottom:4px; display:block;">สาขาประจำ</label>
                            <select name="branchId" class="st-input w-100">
                                @foreach (var br in branches)
                                {
                                    <option value="@br.BranchId">@br.BranchName</option>
                                }
                            </select>
                        </div>
                    </div>
                    <div>
                        <label style="font-size:12px; color:#a1a1aa; margin-bottom:4px; display:block;">รหัสผ่านเริ่มต้น</label>
                        <input type="password" name="password" class="st-input w-100" value="123456" required />
                    </div>
                </div>
                <div class="modal-footer" style="border-top:1px solid #18181b;">
                    <button type="button" class="st-btn-outline" data-bs-dismiss="modal">ยกเลิก</button>
                    <button type="submit" class="st-btn-primary">บันทึกพนักงานใหม่</button>
                </div>
            </form>
        </div>
    </div>
</div>

