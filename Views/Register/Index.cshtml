                                    <script>
                                            const stepSubtitles = {
                                                1: "ขั้นตอนที่ 1 จาก 4 • กรอกข้อมูลบัญชีและความปลอดภัย",
                                                2: "ขั้นตอนที่ 2 จาก 4 • ระบุสรีระและเป้าหมายการฝึก",
                                                3: "ขั้นตอนที่ 3 จาก 4 • เลือกสาขาหลักและแพ็กเกจสมาชิก",
                                                4: "ขั้นตอนที่ 4 จาก 4 • เลือกช่องทางการชำระเงินและหลักฐาน"
                                            };
                                            let currentStep = 1;
                                            function goToStep(targetStep) {
                                                for (let i = 1; i <= 4; i++) {
                                                    const pane = document.getElementById('stepPane' + i);
                                                    if (pane) pane.classList.remove('active');
                                                }
                                                const currentPane = document.getElementById('stepPane' + targetStep);
                                                if (currentPane) currentPane.classList.add('active');
                                                for (let i = 1; i <= 4; i++) {
                                                    const node = document.getElementById('stepNode' + i);
                                                    const circle = document.getElementById('circle' + i);
                
                                                    if (node) {
                                                        node.classList.remove('active', 'completed');
                                                        if (i === targetStep) {
                                                            node.classList.add('active');
                                                        } else if (i < targetStep) {
                                                            node.classList.add('completed');
                                                        }
                                                    }
                                                    if (i <= 3) {
                                                        const line = document.getElementById('line' + i);
                                                        if (line) {
                                                            if (i < targetStep) {
                                                                line.classList.add('completed');
                                                            } else {
                                                                line.classList.remove('completed');
                                                            }
                                                        }
                                                    }
                                                }
                                                const subtitleEl = document.getElementById('stepSubtitle');
                                                if (subtitleEl) subtitleEl.textContent = stepSubtitles[targetStep];

                                                currentStep = targetStep;
                                            }
                                            function nextStep(step) {
                                                if (step === 1) {
                                                    const fullName = document.getElementById('regFullName')?.value.trim();
                                                    const phone = document.getElementById('regPhone')?.value.trim();
                                                    const email = document.getElementById('regEmail')?.value.trim();
                                                    const pwd = document.getElementById('regPassword')?.value;
                                                    const confirm = document.getElementById('regConfirmPassword')?.value;
                                                    const errBox = document.getElementById('step1Error');

                                                    if (!fullName || !phone || !email || !pwd || !confirm) {
                                                        showError(errBox, "กรุณากรอกข้อมูลในขั้นตอนที่ 1 ให้ครบทุกช่องก่อนไปต่อ");
                                                        return;
                                                    }
                                                    if (phone.length !== 10) {
                                                        showError(errBox, "หมายเลขโทรศัพท์ต้องเป็นตัวเลข 10 หลัก");
                                                        return;
                                                    }
                                                    if (pwd.length < 8) {
                                                        showError(errBox, "รหัสผ่านต้องมีความยาวอย่างน้อย 8 ตัวอักษร");
                                                        return;
                                                    }
                                                    if (pwd !== confirm) {
                                                        showError(errBox, "รหัสผ่านและยืนยันรหัสผ่านไม่ตรงกัน");
                                                        return;
                                                    }
                                                    if (errBox) errBox.style.display = 'none';
                                                }
                                                if (step === 3) {
                                                    const chkHealth = document.getElementById('chkHealthSafety');
                                                    if (chkHealth && !chkHealth.checked) {
                                                        alert("กรุณาติ๊กยอมรับการรับรองสุขภาพ (Health Safety Precaution) ก่อนดำเนินการต่อ");
                                                        return;
                                                    }
                                                }
                                                goToStep(step + 1);
                                            }
                                            function prevStep(step) {
                                                if (step > 1) {
                                                    goToStep(step - 1);
                                                }
                                            }

                                            function showError(box, msg) {
                                                if (box) {
                                                    box.textContent = msg;
                                                    box.style.display = 'block';
                                                }
                                            }
                                            function toggleRegPassword() {
                                                const pwdInput = document.getElementById('regPassword');
                                                const confirmInput = document.getElementById('regConfirmPassword');
                                                const toggleBtn = document.getElementById('toggleRegPwdBtn');
            
                                                if (pwdInput.type === 'password') {
                                                    pwdInput.type = 'text';
                                                    confirmInput.type = 'text';
                                                    toggleBtn.textContent = 'ซ่อน';
                                                } else {
                                                    pwdInput.type = 'password';
                                                    confirmInput.type = 'password';
                                                    toggleBtn.textContent = 'แสดง';
                                                }
                                            }
                                            function switchPaymentMethod(method) {
                                                document.getElementById('boxCreditCard').style.display = (method === 'CreditCard') ? 'block' : 'none';
                                                document.getElementById('boxPromptPay').style.display = (method === 'PromptPay') ? 'block' : 'none';
                                                document.getElementById('boxBankTransfer').style.display = (method === 'BankTransfer') ? 'block' : 'none';
                                            }
                                            function updateSelectedPackage(name, price) {
                                                document.getElementById('btnSubmitText').textContent = `สร้างบัญชีและยืนยันการชำระเงิน (฿${price})`;
                                                const ppAmount = document.getElementById('promptPayAmount');
                                                if (ppAmount) ppAmount.textContent = `฿${price}`;
                                            }
                                            function toggleTaxInvoice(chk) {
                                                document.getElementById('boxTaxInvoice').style.display = chk.checked ? 'block' : 'none';
                                            }
                                            function formatCreditCard(input) {
                                                let val = input.value.replace(/\D/g, '');
                                                val = val.substring(0, 16);
                                                let formatted = val.match(/.{1,4}/g)?.join(' - ') || val;
                                                input.value = formatted;
                                            }
                                    </script>
                                </body>

