@{
    ViewData["Title"] = "หน้าแรก - Luxury Athletic & Private Pods";
    Layout = "_Nav_HomeLayout";
    var homeBranches = ViewBag.Branches as List<PrivateGym.Models.Branch> ?? new List<PrivateGym.Models.Branch>();
    var firstBranch = homeBranches.FirstOrDefault();
    string branchNamesSummary = homeBranches.Any()
        ? string.Join(" \u2022 ", homeBranches.Select(b => b.BranchName.Replace("สาขา", "")))
        : "สุขุมวิท 39 \u2022 ทองหล่อ \u2022 อารีย์";
}

<!-- =========================================================
     1. HERO SECTION
     ========================================================= -->
<section class="pg-hero">
    <!-- 
        =========================================================================
        จุดใส่รูปภาพ Hero Background
        =========================================================================
    -->
    <div class="pg-hero-bg" style="background-image: url('/images/hero-bg.jpg');"></div>
    <div class="pg-hero-overlay"></div>

    <div class="pg-container">
        <div class="pg-hero-content">
            <div class="pg-tag-red">FIRST PRIVATE ATHLETIC CLUB IN THAILAND</div>
            <h1 class="pg-hero-title">TRAIN BETTER.<br>LIVE BETTER.</h1>
            <p class="pg-hero-desc">
                สัมผัสประสบการณ์ฝึกซ้อมระดับส่วนตัวไร้ผู้คนรบกวน ควบคุมสภาพแวดล้อมได้เอง 100% สมาธิเต็มเปี่ยม 
                ด้วยระบบความปลอดภัยและสิ่งอำนวยความสะดวกมาตรฐานสากล
            </p>

            <div class="pg-hero-bullets">
                <div class="pg-hero-bullet-item">
                    <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"/></svg>
                    <span>100% Private Pod Suites</span>
                </div>
                <div class="pg-hero-bullet-item">
                    <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"/></svg>
                    <span>Pro-Grade Equipment</span>
                </div>
                <div class="pg-hero-bullet-item">
                    <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"/></svg>
                    <span>Smart Data Tracking</span>
                </div>
            </div>

            <div class="pg-hero-cta-row">
                <a href="#trial" class="pg-btn-primary">
                    <span>จองทดลองฟรี</span>
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"></polyline></svg>
                </a>
                <a href="#facilities" class="pg-btn-outline">
                    <span>ดูสิ่งอำนวยความสะดวก</span>
                </a>
            </div>

            <!-- Hero Stats Row -->
            <div class="pg-hero-stats">
                <div class="pg-hero-stat-item">
                    <div class="stat-num">@(homeBranches.Any() ? homeBranches.Count : 3) Sites</div>
                    <div class="stat-label">@branchNamesSummary</div>
                </div>
                <div class="pg-hero-stat-item">
                    <div class="stat-num">Exclusive</div>
                    <div class="stat-label">จำกัดสมาชิกต่อสาขาอย่างเคร่งครัด</div>
                </div>
                <div class="pg-hero-stat-item">
                    <div class="stat-num">100%</div>
                    <div class="stat-label">Private Space Reservation</div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- =========================================================
     2. THE PRIVATE ADVANTAGE (3 FEATURE CARDS)
     ========================================================= -->
<section class="pg-section" id="advantage">
    <div class="pg-container">
        <div class="pg-advantage-header">
            <div>
                <div class="pg-tag-red">THE PRIVATE ADVANTAGE</div>
                <h2 class="pg-section-heading">มาตรฐานการฝึกที่ไร้สิ่งรบกวน</h2>
            </div>
            <div class="pg-section-subtext">
                ออกจากความวุ่นวาย สู่พื้นที่ส่วนตัวที่ออกแบบมาเพื่อสมาธิ ประสิทธิภาพ และความปลอดภัยสูงสุดของคุณ
            </div>
        </div>

        <div class="pg-advantage-grid">
            <!-- Card 1 -->
            <div class="pg-advantage-card">
                <div>
                    <div class="pg-advantage-icon-box">
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2"/><line x1="9" y1="3" x2="9" y2="21"/></svg>
                    </div>
                    <h3 class="pg-advantage-title">พื้นที่ฝึกส่วนตัว 100%</h3>
                    <div class="pg-advantage-subtitle">FULLY PRIVATE TRAINING PODS</div>
                    <p class="pg-advantage-desc">
                        ไม่ต้องรอ ไม่ต้องต่อคิว คุณมีพื้นที่ อุปกรณ์ และเสียงเพลงที่เป็นของคุณเองอย่างสมบูรณ์แบบ ฝึกด้วยสมาธิและความเป็นส่วนตัวสูงสุด
                    </p>
                </div>
                <div>
                    <a href="#facilities" class="pg-advantage-link">
                        <span>สำรวจพื้นที่ Pods</span>
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"></polyline></svg>
                    </a>
                </div>
            </div>

            <!-- Card 2 -->
            <div class="pg-advantage-card">
                <div>
                    <div class="pg-advantage-icon-box">
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="8.5" cy="7" r="4"></circle><polyline points="17 11 19 13 23 9"></polyline></svg>
                    </div>
                    <h3 class="pg-advantage-title">เทรนเนอร์ส่วนตัวเฉพาะบุคคล</h3>
                    <div class="pg-advantage-subtitle">CERTIFIED PERFORMANCE COACHES</div>
                    <p class="pg-advantage-desc">
                        โปรแกรมการฝึกที่ออกแบบเฉพาะตามเป้าหมาย โดยโค้ชมืออาชีพที่มีใบรับรองระดับสากล วิเคราะห์สรีระและพัฒนาการอย่างต่อเนื่อง
                    </p>
                </div>
                <div>
                    <a href="#packages" class="pg-advantage-link">
                        <span>รู้จักเทรนเนอร์</span>
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"></polyline></svg>
                    </a>
                </div>
            </div>

            <!-- Card 3 -->
            <div class="pg-advantage-card">
                <div>
                    <div class="pg-advantage-icon-box">
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
                    </div>
                    <h3 class="pg-advantage-title">ระบบรักษาความปลอดภัยและเข้าถึง 24 ชม.</h3>
                    <div class="pg-advantage-subtitle">SMART BIO-LOCK &amp; 24/7 ACCESS</div>
                    <p class="pg-advantage-desc">
                        เข้าสู่พื้นที่ฝึกได้ตลอด 24 ชั่วโมง ด้วยระบบ Face Scan และระบบจองผ่านแอปพลิเคชัน พร้อมทีมดูแลฉุกเฉินตลอดเวลา
                    </p>
                </div>
                <div>
                    <a href="#location" class="pg-advantage-link">
                        <span>ระบบความปลอดภัย</span>
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"></polyline></svg>
                    </a>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- =========================================================
     3. MEMBERSHIP PACKAGES (3 PRICING CARDS)
     ========================================================= -->
<section class="pg-section" id="packages">
    <div class="pg-container">
        <div class="pg-pricing-header">
            <div class="pg-tag-red">TRANSPARENT MEMBERSHIP</div>
            <h2 class="pg-section-heading">แพ็กเกจสมาชิก (Membership Packages)</h2>
            <p class="pg-section-subtext" style="margin: 0 auto;">
                เลือกรูปแบบที่ตอบโจทย์ไลฟ์สไตล์ของคุณ ไม่ผูกมัดระยะยาว ไม่มีค่าใช้จ่ายแอบแฝง ยกเลิกได้ตลอดเวลา
            </p>
        </div>

        @{
            var homePackages = ViewBag.Packages as List<PrivateGym.Models.Package> ?? new List<PrivateGym.Models.Package>();
            int pkgIndex = 0;
        }
        <div class="pg-pricing-grid">
            @foreach (var pkg in homePackages)
            {
                pkgIndex++;
                bool isFeatured = pkg.PackageName.Contains("Pro", StringComparison.OrdinalIgnoreCase);
                bool isVip = pkg.IsVip ?? false;

                <div class="pg-pricing-card @(isFeatured ? "featured" : "")">
                    @if (isFeatured)
                    {
                        <div class="pg-pricing-badge-top">RECOMMENDED FOR ATHLETES</div>
                    }
                    <div>
                        <div class="pg-pricing-top-row">
                            <span class="pg-pricing-tier-tag">@(isVip ? "ALL-INCLUSIVE VIP" : (isFeatured ? "COACHING + POD" : "INDIVIDUAL"))</span>
                            <span class="pg-pricing-pill" style="@(isFeatured ? "background: rgba(229, 9, 20, 0.2); color: #ff4d58;" : "")">
                                @(isVip ? "VIP ONLY" : (isFeatured ? "MOST PICKED" : "STARTER"))
                            </span>
                        </div>
                        <h3 class="pg-pricing-title">@pkg.PackageName</h3>
                        <p class="pg-pricing-desc">@(!string.IsNullOrWhiteSpace(pkg.Description) ? pkg.Description : "สิทธิ์เข้าใช้บริการ Private Pod มาตรฐานระดับสากล")</p>

                        <div class="pg-pricing-amount-row">
                            <span class="pg-pricing-currency">&#3647;</span>
                            <span class="pg-pricing-number">@pkg.Price.ToString("N0")</span>
                            <span class="pg-pricing-period">/ @pkg.DurationDays วัน</span>
                        </div>

                        <ul class="pg-pricing-features">
                            <li class="pg-pricing-feature-item included">
                                <svg viewBox="0 0 24 24" fill="currentColor"><path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/></svg>
                                <span>เข้าใช้ Private Pod <strong>@(isVip ? "ไม่จำกัดครั้ง" : $"{pkg.PodQuota} ครั้ง")</strong> (75 นาที/รอบ)</span>
                            </li>
                            <li class="pg-pricing-feature-item @(isVip || pkg.PtQuota > 0 ? "included" : "excluded")">
                                @if (isVip || pkg.PtQuota > 0)
                                {
                                    <svg viewBox="0 0 24 24" fill="currentColor"><path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/></svg>
                                    <span>Personal Trainer 1-on-1 <strong>@(isVip ? "ไม่จำกัด" : $"{pkg.PtQuota} ครั้ง")</strong></span>
                                }
                                else
                                {
                                    <svg viewBox="0 0 24 24" fill="currentColor"><path d="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"/></svg>
                                    <span>ไม่มีโควต้าเทรนเนอร์ส่วนตัว (ซื้อเพิ่มได้ ฿1,200/ครั้ง)</span>
                                }
                            </li>
                            <li class="pg-pricing-feature-item included">
                                <svg viewBox="0 0 24 24" fill="currentColor"><path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/></svg>
                                <span>ตรวจวัดมวลร่างกาย InBody <strong>@(isVip ? "ไม่จำกัด" : $"{pkg.InBodyQuota} ครั้ง")</strong></span>
                            </li>
                            <li class="pg-pricing-feature-item included">
                                <svg viewBox="0 0 24 24" fill="currentColor"><path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/></svg>
                                <span>บัตรดิจิทัล Turnstile Access ผ่านมือถือ</span>
                            </li>
                        </ul>
                    </div>
                    <a asp-controller="Register" asp-action="Index" class="pg-pricing-btn @(isFeatured ? "pg-pricing-btn-red" : "pg-pricing-btn-outline")">
                        @if (isFeatured)
                        {
                            <span>สมัครแพ็กเกจนี้</span>
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"></polyline></svg>
                        }
                        else
                        {
                            <span>@(isVip ? "สมัครแพ็กเกจ VIP" : "เลือกแพ็กเกจนี้")</span>
                        }
                    </a>
                </div>
            }
        </div>

        <div class="pg-pricing-footnote">
            ทุกแพ็กเกจรวมค่าธรรมเนียมแรกเข้า สิทธิ์การเข้าถึง Private Locker และผ้าขนหนูพรีเมียม ไม่มีสัญญาผูกมัดรายปี
        </div>
    </div>
</section>

<!-- =========================================================
     4. FACILITIES & RECOVERY (4 CARDS)
     ========================================================= -->
<section class="pg-section" id="facilities">
    <div class="pg-container">
        <div class="pg-facilities-header">
            <div>
                <div class="pg-tag-red">FACILITIES &amp; RECOVERY</div>
                <h2 class="pg-section-heading">อุปกรณ์ระดับสากลและพื้นที่ฟื้นฟู</h2>
            </div>
            <div class="pg-section-subtext">
                เราคัดสรรเฉพาะอุปกรณ์ระดับโลกเพื่อประสิทธิภาพการฝึกที่ดีที่สุด
            </div>
        </div>

        <div class="pg-facilities-grid">
            <!-- Facility 1 -->
            <div class="pg-facility-card">
                <div class="pg-facility-img" style="background-image: url('/images/eleiko.jpg');"></div>
                <div class="pg-facility-body">
                    <span class="pg-facility-tag">OLYMPIC STANDARD</span>
                    <h4 class="pg-facility-title">Eleiko Competition</h4>
                    <p class="pg-facility-desc">บาร์เบลและแผ่นน้ำหนักมาตรฐานระดับแข่งขัน Olympic &amp; Powerlifting</p>
                </div>
            </div>

            <!-- Facility 2 -->
            <div class="pg-facility-card">
                <div class="pg-facility-img" style="background-image: url('/images/pod-04.jpg');"></div>
                <div class="pg-facility-body">
                    <span class="pg-facility-tag">ADVANCED RECOVERY</span>
                    <h4 class="pg-facility-title">Sauna &amp; Cold Plunge</h4>
                    <p class="pg-facility-desc">โซนฟื้นฟูกล้ามเนื้อด้วยซาวน่าสแกนดิเนเวียนและอ่างน้ำแข็งควบคุมอุณหภูมิ</p>
                </div>
            </div>

            <!-- Facility 3 -->
            <div class="pg-facility-card">
                <div class="pg-facility-img" style="background-image: url('/images/pod-05.jpg');"></div>
                <div class="pg-facility-body">
                    <span class="pg-facility-tag">ACOUSTIC SOUNDPROOF</span>
                    <h4 class="pg-facility-title">Gym Moving Pods</h4>
                    <p class="pg-facility-desc">ห้องฝึกส่วนตัวพร้อมระบบเก็บเสียงและแสงไฟปรับตามอารมณ์การฝึก</p>
                </div>
            </div>

            <!-- Facility 4 -->
            <div class="pg-facility-card">
                <div class="pg-facility-img" style="background-image: url('/images/pod-06.jpg');"></div>
                <div class="pg-facility-body">
                    <span class="pg-facility-tag">LUXURY AMENITIES</span>
                    <h4 class="pg-facility-title">Private Locker &amp; Bath</h4>
                    <p class="pg-facility-desc">ห้องอาบน้ำและเปลี่ยนชุดส่วนตัวสไตล์ลักชัวรี พร้อมสุขภัณฑ์ระดับไฮเอนด์</p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- =========================================================
     5. TRIAL BOOKING (SPECIAL OFFER BOX)
     ========================================================= -->
<section class="pg-section" id="trial">
    <div class="pg-container">
        <div class="pg-trial-box">
            <!-- Left Promo Details -->
            <div>
                <div class="pg-tag-red">SPECIAL OFFER &bull; LIMITED 20 SLOTS / DAY</div>
                <h3 class="pg-trial-title">ทดลองสัมผัสประสบการณ์ Private Session ครั้งแรก</h3>
                <p class="pg-trial-desc">
                    สัมผัสประสบการณ์การฝึกในห้องส่วนตัว 100% Private Pod พร้อมรับการประเมินสรีระเบื้องต้นจากเทรนเนอร์มืออาชีพฟรี ไม่มีข้อผูกมัดใดๆ
                </p>

                <div class="pg-trial-offer-badge">
                    <div class="pg-trial-price-col">
                        <span class="pg-trial-old-price">&#3647; 1,500</span>
                        <span class="pg-trial-new-price">FREE</span>
                        <span class="pg-trial-session-text">/ ทดลองครั้งแรก</span>
                    </div>
                    <div class="pg-trial-specs">
                        75 นาที Private Pod<br>+ Body Assessment
                    </div>
                </div>

                <div class="pg-trial-bullets">
                    <div class="pg-trial-bullet-item">
                        <svg viewBox="0 0 24 24" fill="currentColor"><path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/></svg>
                        <span>รับผ้าขนหนูพรีเมียมและน้ำแร่ออร์แกนิกฟรี</span>
                    </div>
                    <div class="pg-trial-bullet-item">
                        <svg viewBox="0 0 24 24" fill="currentColor"><path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/></svg>
                        <span>สิทธิ์ทดลองเข้าใช้บริการห้อง Sauna &amp; Cold Plunge 1 ครั้ง</span>
                    </div>
                </div>
            </div>

            <!-- Right Booking Form -->
            <div>
                @if (TempData["TrialSuccess"] != null)
                {
                    <div class="alert alert-success mb-3" style="background: rgba(34, 197, 94, 0.16); border: 1px solid #22c55e; color: #fff; border-radius: 10px; font-size: 13px;">
                        @TempData["TrialSuccess"]
                    </div>
                }
                <form class="pg-trial-form" asp-controller="Home" asp-action="BookTrial" method="post">
                    <div>
                        <input type="text" class="pg-trial-input" name="fullName" placeholder="ชื่อ-นามสกุลของคุณ" required />
                    </div>
                    <div class="pg-trial-row-2">
                        <input type="tel" class="pg-trial-input" name="phone" placeholder="หมายเลขโทรศัพท์" required />
                        <input type="email" class="pg-trial-input" name="email" placeholder="อีเมลสำหรับการยืนยัน" required />
                    </div>
                    <div>
                        <select class="pg-trial-input" name="branch" style="background-color: var(--pg-input-bg); color:#fff;">
                            @foreach (var b in homeBranches)
                            {
                                <option value="@b.BranchName">@b.BranchName (@b.Location)</option>
                            }
                        </select>
                    </div>
                    <button type="submit" class="pg-trial-submit-btn">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M19 3h-1V1h-2v2H8V1H6v2H5c-1.11 0-1.99.9-1.99 2L3 19c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm0 16H5V8h14v11z"/></svg>
                        <span>นัดหมายทดลองห้อง POD ฟรี</span>
                    </button>
                    <div class="pg-trial-form-footnote">
                        ไม่มีค่าใช้จ่ายและข้อผูกมัด &bull; ยกเลิกหรือเลื่อนเวลาได้ตลอด
                    </div>
                </form>
            </div>
        </div>
    </div>
</section>

<!-- =========================================================
     6. LOCATION & BRANCHES
     ========================================================= -->
<section class="pg-section" id="location">
    <div class="pg-container">
        <div class="pg-location-grid">
            <div class="pg-location-info">
                <div class="pg-tag-red">LOCATION &amp; BRANCHES</div>
                <h2 class="pg-section-heading">สาขาหลัก: @(firstBranch?.BranchName ?? "สาขาสุขุมวิท 39")</h2>

                <div class="pg-location-item">
