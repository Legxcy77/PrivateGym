@model List<PrivateGym.Models.Package>

@{
    ViewData["Title"] = "แพ็กเกจสมาชิกและอัตราค่าบริการ";
    Layout = "_Nav_HomeLayout";
    var packages = Model ?? new List<PrivateGym.Models.Package>();
}

<style>
    .dp-wrap {
        padding-top: 120px;
        padding-bottom: 96px;
    }

    .dp-hero-row {
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
        gap: 24px;
        flex-wrap: wrap;
        margin-bottom: 48px;
    }

    .dp-h1 {
        font-size: 42px;
        font-weight: 900;
        color: #ffffff;
        line-height: 1.12;
        letter-spacing: -0.8px;
        margin: 10px 0 14px 0;
    }

    .dp-lead {
        font-size: 14.5px;
        color: #a1a1aa;
        max-width: 620px;
        line-height: 1.75;
        margin: 0;
    }

    .dp-section-gap {
        margin-top: 76px;
        padding-top: 56px;
        border-top: 1px solid #1b1b22;
    }

    /* Zero Distraction 2-col */
    .dp-env-box {
        background: #111115;
        border: 1px solid #23232c;
        border-radius: 18px;
        padding: 40px;
        display: grid;
        grid-template-columns: 1fr 1.05fr;
        gap: 40px;
        align-items: center;
        margin: 76px 0 0 0;
    }

    .dp-env-stats {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 16px;
        margin-top: 24px;
    }

    .dp-env-stat {
        background: #17171d;
        border: 1px solid #262632;
        border-radius: 12px;
        padding: 16px 18px;
    }

    .dp-env-stat .num {
        font-size: 24px;
        font-weight: 900;
        color: #ffffff;
    }

    .dp-env-stat .lbl {
        font-size: 12px;
        color: #71717a;
        margin-top: 2px;
    }

    .dp-env-photo {
        height: 290px;
        border-radius: 14px;
        background: linear-gradient(180deg, rgba(0,0,0,0.12) 0%, rgba(0,0,0,0.82) 100%), url('/images/pod-01.jpg') center/cover no-repeat;
        border: 1px solid #2a2a35;
        position: relative;
        display: flex;
        align-items: flex-end;
        padding: 18px;
    }

    .dp-env-badge {
        background: rgba(12, 12, 16, 0.9);
        border: 1px solid rgba(34, 197, 94, 0.4);
        color: #e4e4e7;
        font-family: monospace;
        font-size: 11.5px;
        font-weight: 700;
        padding: 6px 12px;
        border-radius: 8px;
        display: inline-flex;
        align-items: center;
        gap: 8px;
    }

    /* Add-ons 3 col */
    .dp-addon-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 24px;
        margin-top: 28px;
    }

    .dp-addon-card {
        background: #121216;
        border: 1px solid #24242d;
        border-radius: 16px;
        padding: 28px;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        gap: 20px;
    }

    .dp-addon-card.highlight {
        border-color: rgba(229, 9, 20, 0.45);
        background: linear-gradient(155deg, #191215 0%, #121216 100%);
    }

    /* Comparison Table (Exact Darfwebsite Dark Luxury Style) */
    .dp-spec-table-wrap {
        background: #0e0e12;
        border: 1px solid #22222b;
        border-radius: 16px;
        overflow: hidden;
        margin-top: 28px;
    }

    .dp-spec-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 13px;
        background: #0e0e12;
    }

    .dp-spec-table thead tr {
        background: #141419;
        border-bottom: 1px solid #262632;
    }

    .dp-spec-table th {
        padding: 16px 20px;
        font-size: 12.5px;
        font-weight: 800;
        color: #ffffff;
        text-align: center;
        border-bottom: 1px solid #262632;
    }

    .dp-spec-table th.col-feature {
        text-align: left;
        color: #71717a;
        font-size: 11.5px;
        letter-spacing: 0.4px;
        text-transform: uppercase;
    }

    .dp-spec-table th.col-pro {
        color: #ff4d58;
        background: rgba(229, 9, 20, 0.08);
    }

    .dp-spec-table td {
        padding: 14px 20px;
        border-bottom: 1px solid #1b1b22;
        color: #d4d4d8;
        text-align: center;
        vertical-align: middle;
    }

    .dp-spec-table tbody tr:last-child td {
        border-bottom: none;
    }

    .dp-spec-table tbody tr:hover td {
        background: rgba(255, 255, 255, 0.02);
    }

    .dp-spec-table td.col-feature {
        text-align: left;
        color: #e4e4e7;
        font-weight: 500;
    }

    .dp-spec-table td.col-pro {
        background: rgba(229, 9, 20, 0.04);
        color: #ffffff;
        font-weight: 700;
    }

    .dp-spec-table tbody tr:hover td.col-pro {
        background: rgba(229, 9, 20, 0.07);
    }

    /* FAQ 2x2 */
    .dp-faq-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 20px;
        margin-top: 28px;
        margin-bottom: 76px;
    }

    .dp-faq-card {
        background: #121216;
        border: 1px solid #24242d;
        border-radius: 16px;
        padding: 26px 28px;
    }

    .dp-cta-banner {
        background: linear-gradient(135deg, #171215 0%, #111115 100%);
        border: 1px solid rgba(229, 9, 20, 0.3);
        border-radius: 18px;
        padding: 36px 40px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 24px;
        flex-wrap: wrap;
    }

    @@media (max-width: 991.98px) {
        .dp-h1 { font-size: 28px; }
        .dp-addon-grid, .dp-faq-grid, .dp-env-box {
            grid-template-columns: 1fr;
        }
    }
</style>

<div class="dp-wrap">
    <div class="pg-container">
        <!-- 1. Hero Header -->
        <div class="dp-hero-row">
            <div>
                <div class="pg-tag-red">MEMBERSHIP ARCHITECTURE // 2026</div>
                <h1 class="dp-h1">แพ็กเกจสมาชิกและอัตราค่าบริการ</h1>
                <p class="dp-lead">
                    เลือกแพ็กเกจการฝึกส่วนตัวที่ตอบโจทย์เป้าหมายสุขภาพ ด้วยระบบห้องฝึกส่วนตัว 100% ไร้การรบกวน พร้อมสิทธิ์จองผ่านแอปพลิเคชันและระบบผ่านประตูอัตโนมัติแบบ Autonomous Turnstile
                </p>
            </div>
        </div>

        <!-- 2. Real DB Pricing Cards Grid -->
        <div class="pg-pricing-grid">
            @{ int tierIdx = 0; }
            @foreach (var pkg in packages)
            {
                tierIdx++;
                bool isFeatured = pkg.PackageName.Contains("Pro", StringComparison.OrdinalIgnoreCase);
                bool isVip = pkg.IsVip ?? false;

                <div class="pg-pricing-card @(isFeatured ? "featured" : "")">
                    @if (isFeatured)
                    {
                        <div class="pg-pricing-badge-top">RECOMMENDED</div>
                    }
                    <div>
                        <div class="pg-pricing-top-row">
                            <span class="pg-pricing-tier-tag">TIER 0@(tierIdx) / @(isVip ? "VIP" : (isFeatured ? "STANDARD" : "ENTRY"))</span>
                            <span class="pg-pricing-pill">@(isVip ? "All-Access VIP" : (isFeatured ? "All-Time Access" : "Standard Access"))</span>
                        </div>
                        <h3 class="pg-pricing-title">@pkg.PackageName</h3>
                        <p class="pg-pricing-desc">@(!string.IsNullOrWhiteSpace(pkg.Description) ? pkg.Description : "สิทธิ์เข้าใช้บริการ Private Pod มาตรฐานระดับสากล")</p>

                        <div class="pg-pricing-amount-row">
                            <span class="pg-pricing-currency">&#3647;</span>
                            <span class="pg-pricing-number">@pkg.Price.ToString("N0")</span>
                            <span class="pg-pricing-period">/ @pkg.DurationDays วัน</span>
                        </div>

                        <ul class="pg-pricing-features">
                            <li class="pg-pricing-feature-item included">
                                <svg viewBox="0 0 24 24" fill="currentColor"><path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/></svg>
                                <span><strong>@(isVip ? "ไม่จำกัด" : $"{pkg.PodQuota} ครั้ง")</strong> Private Pod Suite (75 นาที)</span>
                            </li>
                            <li class="pg-pricing-feature-item @(isVip || pkg.PtQuota > 0 ? "included" : "excluded")">
                                <svg viewBox="0 0 24 24" fill="currentColor"><path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/></svg>
                                <span><strong>@(isVip ? "ไม่จำกัด" : (pkg.PtQuota > 0 ? $"{pkg.PtQuota} ครั้ง" : "ไม่มี"))</strong> Personal Training 1-on-1</span>
                            </li>
                            <li class="pg-pricing-feature-item included">
                                <svg viewBox="0 0 24 24" fill="currentColor"><path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/></svg>
                                <span>ตรวจวัดมวลร่างกาย InBody <strong>@(isVip ? "ไม่จำกัด" : $"{pkg.InBodyQuota} ครั้ง")</strong></span>
                            </li>
                            <li class="pg-pricing-feature-item included">
                                <svg viewBox="0 0 24 24" fill="currentColor"><path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/></svg>
                                <span>บัตรดิจิทัล Turnstile Access ผ่านมือถือ</span>
                            </li>
                        </ul>
                    </div>

                    <a asp-controller="Register" asp-action="Index" class="pg-pricing-btn @(isFeatured ? "pg-pricing-btn-red" : "pg-pricing-btn-outline")">
                        <span>สมัครสมาชิกแพ็กเกจนี้</span>
                    </a>
                </div>
            }
        </div>

        <!-- 3. Zero Distraction Environment Split -->
        <div class="dp-env-box">
            <div>
                <div class="pg-tag-red">ZERO DISTRACTION ENVIRONMENT</div>
                <h2 class="text-white fw-bold mb-3" style="font-size: 28px; line-height: 1.25;">พื้นที่ฝึกซ้อมส่วนตัว มาตรฐานห้องผ่าตัดสะอาดและเงียบสงบ</h2>
                <p style="font-size: 13.5px; color: #a1a1aa; line-height: 1.7; margin: 0;">
                    สัมผัสประสบการณ์ที่ไม่มีเสียงรบกวน ไม่ต้องรออุปกรณ์ และไม่ต้องกังวลเรื่องสุขอนามัย ทุกห้องมีระบบฟอกอากาศอัตโนมัติ 15 นาทีก่อนและหลังทุกเซสชัน พร้อมอุปกรณ์ยกน้ำหนักมาตรฐานแข่งขัน Olympic Standard
                </p>

                <div class="dp-env-stats">
                    <div class="dp-env-stat">
                        <div class="num">100%</div>
                        <div class="lbl">Autonomous Private Pods</div>
                    </div>
                    <div class="dp-env-stat">
                        <div class="num">15 Min</div>
                        <div class="lbl">Ozone Turnaround Disinfection</div>
                    </div>
                </div>
            </div>

            <div class="dp-env-photo">
                <span class="dp-env-badge">
                    <span class="cd-status-dot" style="width: 8px; height: 8px; border-radius: 50%; background: #22c55e; display: inline-block;"></span>
                    POD 01: READY // CALIBRATED STEEL
                </span>
            </div>
        </div>

        <!-- 4. Add-on Quota & Credit Top-ups -->
        <div class="dp-section-gap">
            <div class="d-flex justify-content-between align-items-end flex-wrap gap-2">
                <div>
                    <div class="pg-tag-red">TOP-UP ON DEMAND</div>
                    <h2 class="text-white fw-bold mb-2" style="font-size: 26px;">อัตราการซื้อเพิ่มครั้งเดียว (Add-on Quota)</h2>
                    <p style="font-size: 13.5px; color: #71717a; margin: 0;">เมื่อโควต้าประจำเดือนหมด หรือต้องการเสริมรอบพิเศษ สามารถกดซื้อผ่านหน้าแพ็กเกจได้ทันที</p>
                </div>
                <span style="font-size: 12.5px; color: #71717a;">อัตราคงที่สำหรับสมาชิกทุกระดับ</span>
            </div>

            <div class="dp-addon-grid">
            <div class="dp-addon-card">
                <div>
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span style="color: #a1a1aa; font-size: 11px; font-weight: 700;">ADD-ON #01</span>
                    </div>
                    <h4 class="text-white fw-bold mb-2" style="font-size: 17px;">Solo Pod Suite (75 นาที)</h4>
                    <p style="font-size: 12.5px; color: #a1a1aa;">เพิ่มชั่วโมงการเข้าฝึกเดี่ยวในห้อง Solo Pod ทุกช่วงเวลา พร้อมสิทธิ์ใช้อุปกรณ์ครบชุด</p>
                </div>
                <div class="d-flex justify-content-between align-items-center pt-3 border-top border-secondary border-opacity-25">
                    <div><strong class="text-white fs-5">&#3647;750</strong> <span style="font-size: 12px; color: #71717a;">/รอบ</span></div>
                    <a asp-controller="Register" asp-action="Index" class="btn btn-sm btn-outline-light" style="border-color: #343442;">ซื้อรอบเพิ่ม</a>
                </div>
            </div>

            <div class="dp-addon-card highlight">
                <div>
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span style="color: #e50914; font-size: 11px; font-weight: 700;">ADD-ON #02</span>
                    </div>
                    <h4 class="text-white fw-bold mb-2" style="font-size: 17px;">Personal Trainer (60 นาที)</h4>
                    <p style="font-size: 12.5px; color: #a1a1aa;">เซสชันสอนตัวต่อตัวด้วยโค้ชมืออาชีพ จัดโปรแกรมฝึกเข้มข้น โฟกัสฟอร์มและสมรรถนะ</p>
                </div>
                <div class="d-flex justify-content-between align-items-center pt-3 border-top border-secondary border-opacity-25">
                    <div><strong style="color: #f87171;" class="fs-5">&#3647;1,200</strong> <span style="font-size: 12px; color: #71717a;">/เซสชัน</span></div>
                    <a asp-controller="Register" asp-action="Index" class="btn btn-sm btn-danger fw-semibold">จองโค้ชส่วนตัว</a>
                </div>
            </div>

            <div class="dp-addon-card">
                <div>
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span style="color: #a1a1aa; font-size: 11px; font-weight: 700;">ADD-ON #03</span>
                    </div>
                    <h4 class="text-white fw-bold mb-2" style="font-size: 17px;">InBody 770 Comprehensive Scan</h4>
                    <p style="font-size: 12.5px; color: #a1a1aa;">ตรวจวัดวิเคราะห์องค์ประกอบร่างกาย กล้ามเนื้อ ไขมันในช่องท้อง พร้อมรายงานผลละเอียด</p>
                </div>
                <div class="d-flex justify-content-between align-items-center pt-3 border-top border-secondary border-opacity-25">
                    <div><strong class="text-white fs-5">&#3647;300</strong> <span style="font-size: 12px; color: #71717a;">/ครั้ง</span></div>
                    <a asp-controller="Register" asp-action="Index" class="btn btn-sm btn-outline-light" style="border-color: #343442;">จองตรวจสแกน</a>
                </div>
            </div>
            </div>
        </div>

        <!-- 5. Technical Specification Comparison Table -->
        <div class="dp-section-gap">
            <div class="mb-2">
                <div class="pg-tag-red">TECHNICAL SPECIFICATION</div>
                <h2 class="text-white fw-bold mb-2" style="font-size: 26px;">ตารางเปรียบเทียบสิทธิประโยชน์อย่างละเอียด</h2>
                <p style="font-size: 13.5px; color: #71717a; margin: 0;">รายละเอียดวิศวกรรมการบริการและข้อกำหนดในแต่ละระดับสมาชิก</p>
            </div>

        <div class="dp-spec-table-wrap">
            <div class="table-responsive">
                <table class="dp-spec-table">
                    <thead>
                        <tr>
                            <th class="col-feature">รายการสิทธิประโยชน์ (FEATURES &amp; PROTOCOLS)</th>
                            @foreach (var pkg in packages)
                            {
                                bool isFeatured = pkg.PackageName.Contains("Pro", StringComparison.OrdinalIgnoreCase);
                                <th class="@(isFeatured ? "col-pro" : "")">@pkg.PackageName</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td class="col-feature">ระยะเวลาแพ็กเกจต่อรอบ (Duration)</td>
                            @foreach (var pkg in packages)
                            {
                                bool isFeatured = pkg.PackageName.Contains("Pro", StringComparison.OrdinalIgnoreCase);
                                <td class="@(isFeatured ? "col-pro" : "")">@pkg.DurationDays วัน</td>
                            }
                        </tr>
                        <tr>
                            <td class="col-feature">ความเป็นส่วนตัวของห้องฝึก (Private Pod Enclosure)</td>
                            @foreach (var pkg in packages)
                            {
                                bool isFeatured = pkg.PackageName.Contains("Pro", StringComparison.OrdinalIgnoreCase);
                                <td class="@(isFeatured ? "col-pro" : "")">100% ปิดมิดชิดเดี่ยว</td>
                            }
                        </tr>
                        <tr>
                            <td class="col-feature">โควต้าเข้าใช้งาน Private Pod ต่อรอบ</td>
                            @foreach (var pkg in packages)
                            {
                                bool isFeatured = pkg.PackageName.Contains("Pro", StringComparison.OrdinalIgnoreCase);
                                <td class="@(isFeatured ? "col-pro" : "")">@(pkg.IsVip == true ? "ไม่จำกัด" : $"{pkg.PodQuota} ครั้ง")</td>
                            }
                        </tr>
                        <tr>
                            <td class="col-feature">โควต้า Personal Trainer 1-on-1 ต่อรอบ</td>
                            @foreach (var pkg in packages)
                            {
                                bool isFeatured = pkg.PackageName.Contains("Pro", StringComparison.OrdinalIgnoreCase);
                                <td class="@(isFeatured ? "col-pro" : "")">@(pkg.IsVip == true ? "ไม่จำกัด" : (pkg.PtQuota > 0 ? $"{pkg.PtQuota} ครั้ง" : "ซื้อเพิ่มได้ (฿1,200/ครั้ง)"))</td>
                            }
                        </tr>
                        <tr>
                            <td class="col-feature">โควต้าตรวจวัดมวลร่างกาย InBody 770</td>
                            @foreach (var pkg in packages)
                            {
                                bool isFeatured = pkg.PackageName.Contains("Pro", StringComparison.OrdinalIgnoreCase);
                                <td class="@(isFeatured ? "col-pro" : "")">@(pkg.IsVip == true ? "ไม่จำกัด" : $"{pkg.InBodyQuota} ครั้ง")</td>
                            }
                        </tr>
                        <tr>
                            <td class="col-feature">ชุดอุปกรณ์มาตรฐาน (Eleiko &amp; Hammer Strength)</td>
                            @foreach (var pkg in packages)
                            {
                                bool isFeatured = pkg.PackageName.Contains("Pro", StringComparison.OrdinalIgnoreCase);
                                bool isVip = pkg.IsVip ?? false;
                                <td class="@(isFeatured ? "col-pro" : "")">@(isVip ? "Custom Heavy Rig + Dumbbell 50kg" : (isFeatured ? "Eleiko IPF Calibrated" : "Eleiko Sport Standard"))</td>
                            }
                        </tr>
                        <tr>
                            <td class="col-feature">สิทธิ์พาผู้ติดตามเข้าห้อง (Guest &amp; Companion Access)</td>
                            @foreach (var pkg in packages)
                            {
                                bool isFeatured = pkg.PackageName.Contains("Pro", StringComparison.OrdinalIgnoreCase);
                                bool isVip = pkg.IsVip ?? false;
                                <td class="@(isFeatured ? "col-pro" : "")" style="@(isVip ? "color: #4ade80; font-weight: 700;" : "")">
                                    @(isVip ? "ฟรี 1 ท่านตลอดเวลา" : "ซื้อบัตรเชิญเพิ่ม ฿350/วัน")
                                </td>
                            }
                        </tr>
                        <tr>
                            <td class="col-feature">ระบบฆ่าเชื้อและฟอกอากาศ (Air Turnover &amp; Ozone Cycle)</td>
                            @foreach (var pkg in packages)
                            {
                                bool isFeatured = pkg.PackageName.Contains("Pro", StringComparison.OrdinalIgnoreCase);
                                bool isVip = pkg.IsVip ?? false;
                                <td class="@(isFeatured ? "col-pro" : "")">@(isVip || isFeatured ? "Ozone + HEPA H14 ต่อเนื่อง" : "Ozone รอบต่อรอบ (15 นาที)")</td>
                            }
                        </tr>
                        <tr>
                            <td class="col-feature">การจัดการเสียงส่วนตัว (Private Audio via Bluetooth 5.3)</td>
                            @foreach (var pkg in packages)
                            {
                                bool isFeatured = pkg.PackageName.Contains("Pro", StringComparison.OrdinalIgnoreCase);
                                bool isVip = pkg.IsVip ?? false;
                                <td class="@(isFeatured ? "col-pro" : "")">@(isVip ? "Devialet Phantom Pod Audio" : "รวมในห้อง")</td>
                            }
                        </tr>
                        <tr>
                            <td class="col-feature">นโยบายยกเลิกและเลื่อนรอบการจอง (Cancellation Window)</td>
                            @foreach (var pkg in packages)
                            {
                                bool isFeatured = pkg.PackageName.Contains("Pro", StringComparison.OrdinalIgnoreCase);
                                bool isVip = pkg.IsVip ?? false;
                                <td class="@(isFeatured ? "col-pro" : "")" style="@(isVip ? "color: #4ade80; font-weight: 700;" : "")">
                                    ก่อนจบเซสชัน (หากยังไม่เช็กอิน)
                                </td>
                            }
                        </tr>
                        <tr>
                            <td class="col-feature">บริการผ้าเช็ดตัว ล็อกเกอร์ และห้องอาบน้ำส่วนตัว</td>
                            @foreach (var pkg in packages)
                            {
                                bool isFeatured = pkg.PackageName.Contains("Pro", StringComparison.OrdinalIgnoreCase);
                                bool isVip = pkg.IsVip ?? false;
                                <td class="@(isFeatured ? "col-pro" : "")">@(isVip ? "En-suite Private Shower Pod" : (isFeatured ? "ห้องน้ำส่วนตัวในโซน Pod" : "ห้องอาบน้ำรวม"))</td>
                            }
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
        </div>

        <!-- 6. FAQ 2x2 -->
        <div class="dp-section-gap">
            <div class="mb-2">
                <div class="pg-tag-red">FREQUENTLY ASKED QUESTIONS</div>
                <h2 class="text-white fw-bold mb-1" style="font-size: 26px;">คำถามที่พบบ่อยเกี่ยวกับการใช้งานและระเบียบสมาชิก</h2>
            </div>

            <div class="dp-faq-grid">
                <div class="dp-faq-card">
                    <h5 class="text-white fw-bold mb-2" style="font-size: 15px;">การจองห้อง Private Pod ทำงานอย่างไร และต้องจองล่วงหน้านานแค่ไหน?</h5>
                    <p style="font-size: 13.5px; color: #a1a1aa; margin: 0; line-height: 1.7;">สมาชิกสามารถจองผ่านหน้าเว็บได้ทันที โดยระบบจะแสดงตารางว่างของแต่ละห้อง (Pod 01 ถึง 06) แบบ Real-time เมื่อจองสำเร็จจะได้รับ QR Code สำหรับสแกนเข้าห้องซ้อม</p>
                </div>
                <div class="dp-faq-card">
                    <h5 class="text-white fw-bold mb-2" style="font-size: 15px;">หากเปลี่ยนแพ็กเกจระหว่างเดือน สิทธิ์เดิมจะหายไปไหม?</h5>
                    <p style="font-size: 13.5px; color: #a1a1aa; margin: 0; line-height: 1.7;">สามารถเลือกตั้งเปลี่ยนแพ็กเกจล่วงหน้าเพื่อให้มีผลรอบบิลถัดไป โดยใช้โควต้าเดิมได้จนครบวันหมดอายุ หรือเลือกอัปเกรดทันทีพร้อมทบโควต้าคงเหลือเดิมเข้าแพ็กเกจใหม่ได้</p>
                </div>
                <div class="dp-faq-card">
                    <h5 class="text-white fw-bold mb-2" style="font-size: 15px;">นโยบายการยกเลิกเซสชัน หรือเลื่อนรอบเวลา ทำได้ถึงเมื่อไหร่?</h5>
                    <p style="font-size: 13.5px; color: #a1a1aa; margin: 0; line-height: 1.7;">สมาชิกสามารถกดขอเลื่อนรอบหรือยกเลิกการจองในหน้าการจองของฉันได้ตลอดเวลาก่อนจบเซสชัน (หากยังไม่ได้สแกนเช็กอินเข้าห้อง) ระบบจะคืนโควต้าให้อัตโนมัติทันที</p>
                </div>
                <div class="dp-faq-card">
                    <h5 class="text-white fw-bold mb-2" style="font-size: 15px;">สามารถขอใบเสร็จรับเงินและใบกำกับภาษีเต็มรูปแบบได้หรือไม่?</h5>
                    <p style="font-size: 13.5px; color: #a1a1aa; margin: 0; line-height: 1.7;">ได้ครับ เพียงกรอกเลขประจำตัวผู้เสียภาษี (Tax ID) และที่อยู่ในหน้าข้อมูลส่วนตัว ระบบจะออกใบกำกับภาษีเต็มรูปพร้อมให้สั่งพิมพ์ PDF ได้ทันที</p>
                </div>
            </div>
        </div>

        <!-- 7. Bottom CTA Banner -->
        <div class="dp-cta-banner">
            <div>
                <div style="font-size: 11px; color: #4ade80; font-weight: 700; margin-bottom: 4px;">FIRST TRIAL ON-BOARDING</div>
                <h3 class="text-white fw-bold mb-1" style="font-size: 21px;">ทดลองสัมผัสห้องฝึกซ้อมส่วนตัวแบบ Autonomous Pod ครั้งแรกฟรี</h3>
                <p style="font-size: 13px; color: #a1a1aa; margin: 0;">จองเวลานัดหมายเข้าชมสถานที่จริง ทดลองระบบการทำงานของประตูดิจิทัลและอุปกรณ์โดยไม่มีข้อผูกมัด</p>
            </div>
            <div class="d-flex gap-2 flex-wrap">
                <a asp-controller="Home" asp-action="Contact" class="btn btn-danger fw-bold px-4 py-2">นัดหมายทดลองห้อง POD ฟรี</a>
                <a href="tel:021234567" class="btn btn-outline-light px-4 py-2" style="border-color: #343442;">โทรสอบถาม 02-123-4567</a>
            </div>
        </div>
    </div>
</div>
